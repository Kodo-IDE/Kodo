<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kodo="clr-namespace:Kodo"
        x:CompileBindings="False">

    <Style Selector="Border.quickaccessframe, Border.searchpill">
        <Setter Property="BoxShadow" Value="0 2 0 0 #8C00FF" />
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #22000000, 0 1 3 0 #66000000, 0 2 0 0 #8C00FF" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{Binding WindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="{x:Static kodo:KodoDesignTokens.BorderThin}" />
        <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CompactRadius}" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="Background" Value="{Binding WindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="{x:Static kodo:KodoDesignTokens.BorderThin}" />
        <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CompactRadius}" />
    </Style>

    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="{x:Static kodo:KodoDesignTokens.BorderThin}" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{Binding AccentBrush}" />
        <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
    </Style>

</Styles>
