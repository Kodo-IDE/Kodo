<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kodo="clr-namespace:Kodo"
        x:CompileBindings="False">

    <Style Selector="Border.quickaccessframe, Border.searchpill">
        <Setter Property="BoxShadow" Value="{DynamicResource AccentUnderlineShadows}" />
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BoxShadow" Value="{DynamicResource AccentInputShadows}" />
    </Style>

    <Style Selector="TextBox.quickaccesssearch /template/ Border#PART_BorderElement">
        <Setter Property="BoxShadow" Value="none" />
    </Style>

    <Style Selector="Border.searchpill TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BoxShadow" Value="none" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{Binding WindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="{x:Static kodo:KodoDesignTokens.BorderThin}" />
        <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CompactRadius}" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="Background" Value="{Binding WindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="{x:Static kodo:KodoDesignTokens.BorderThin}" />
        <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CompactRadius}" />
    </Style>

    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{Binding AccentBrush}" />
        <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
    </Style>

    <Style Selector="CheckBox /template/ Path#CheckGlyph">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="7" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.depth, Border.savegroup, Border.runbuildgroup">
        <Setter Property="Padding" Value="{x:Static kodo:KodoDesignTokens.DepthPadding}" />
        <Setter Property="Margin" Value="{x:Static kodo:KodoDesignTokens.DepthInset}" />
        <Setter Property="BoxShadow" Value="{x:Static kodo:KodoDesignTokens.DepthShadow}" />
    </Style>

    <Style Selector="Border.savegroup">
        <Setter Property="Background" Value="{DynamicResource ButtonDepthBrush}" />
        <Setter Property="CornerRadius" Value="0,0,8,8" />
    </Style>

    <Style Selector="Border.runbuildgroup">
        <Setter Property="Background" Value="{DynamicResource AccentDepthBrush}" />
        <Setter Property="CornerRadius" Value="0,0,8,8" />
    </Style>

    <Style Selector="Button.saveprimary:pressed, Button.savearrow:pressed, Button.runbuildprimary:pressed, Button.runbuildarrow:pressed">
        <Setter Property="RenderTransform" Value="translate(0px,1px)" />
    </Style>

    <Style Selector="Border.badge3d">
        <Setter Property="BoxShadow" Value="{DynamicResource AccentBadgeShadows}" />
    </Style>

    <Style Selector="Border.depth">
        <Setter Property="Background" Value="{DynamicResource ButtonDepthBrush}" />
        <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
    </Style>

</Styles>
