<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">WinExe</OutputType>
    <OutputType Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
    <ApplicationIcon Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">..\Assets\kodo_logo.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">..\Assets\kodo_logo.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <UseAppHost>true</UseAppHost>
    <Version>2.1.0-DEV</Version>
    <InformationalVersion>v2.1.0-DEV</InformationalVersion>
    <HotfixStampBaseVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '-.*$', ''))</HotfixStampBaseVersion>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="../Assets/**" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" Exclude="../Assets/kodo.desktop" />
    <None Include="../Assets/kodo.desktop" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../Assets/kodo.desktop')" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="KodoUpdater\**\*.cs" />
    <None Remove="KodoUpdater\**\*.cs" />
  </ItemGroup>

  <Target Name="RemovePdbFilesFromPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PdbFiles Include="$(PublishDir)**/*.pdb" />
    </ItemGroup>

    <Delete Files="@(PdbFiles)" />
  </Target>

  <Target Name="GenerateHotfixBuildStamp" BeforeTargets="AssignTargetPaths" Condition="'$(HotfixBuildStampGenerated)' != 'true'">
    <WriteLinesToFile File="$(IntermediateOutputPath)hotfix-build.json" Lines="{&quot;baseVersion&quot;:&quot;$(HotfixStampBaseVersion)&quot;,&quot;hotfixLevel&quot;:0}" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)hotfix-build.json" CopyToOutputDirectory="PreserveNewest">
        <Link>hotfix-build.json</Link>
      </None>
    </ItemGroup>
    <PropertyGroup>
      <HotfixBuildStampGenerated>true</HotfixBuildStampGenerated>
    </PropertyGroup>
  </Target>
</Project>
