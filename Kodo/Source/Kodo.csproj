<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Phase 0 Linux: Exe by default; WinExe only on Windows (hides console).
         WinExe is a Windows concept and breaks Linux apphost expectations. -->
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Phase 0 Linux: app.manifest is Windows-only (assemblyIdentity/supportedOS/dpiAwareness). -->
    <ApplicationManifest Condition="'$(OS)' == 'Windows_NT'">app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Disable Avalonia's build-time telemetry task. It can fail builds when
         the per-user BuildServices log is locked or not writable. -->
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
    <!-- Phase 0 Linux: .ico is Windows-only. Linux packaging uses kodo-logo.png + .desktop file. -->
    <ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">..\Assets\kodo_logo.ico</ApplicationIcon>
    <!-- Phase 0 Linux: publish-time RIDs, e.g. dotnet publish with linux-x64 self contained true -->
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <UseAppHost>true</UseAppHost>
    <Version>2.1.0-DEV</Version>
    <InformationalVersion>v2.1.0-DEV</InformationalVersion>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.16" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="../Assets/**" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" Exclude="../Assets/kodo.desktop" />
    <None Include="../Assets/kodo.desktop" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kodo.Lsp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="KodoUpdater\**\*.cs" />
    <None Remove="KodoUpdater\**\*.cs" />
  </ItemGroup>

  <Target Name="RemovePdbFilesFromPublish"
          AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PdbFiles Include="$(PublishDir)**/*.pdb" />
    </ItemGroup>

    <Delete Files="@(PdbFiles)" />
  </Target>
</Project>
