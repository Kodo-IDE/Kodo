<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kodo="clr-namespace:Kodo"
             x:Class="Kodo.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#8C00FF" />
                <ColorPaletteResources x:Key="Light"
                                       Accent="#7B00FF" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <Style Selector="HyperlinkButton">
            <Setter Property="Foreground" Value="{x:Static kodo:KodoDesignTokens.LinkBrush}" />
        </Style>
        <Style Selector="HyperlinkButton:pointerover">
            <Setter Property="Foreground" Value="{x:Static kodo:KodoDesignTokens.LinkActiveBrush}" />
        </Style>
    </Application.Styles>
</Application>
