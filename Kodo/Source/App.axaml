<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kodo="clr-namespace:Kodo"
             xmlns:fluent="using:Avalonia.Themes.Fluent"
             x:Class="Kodo.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <fluent:FluentTheme>
            <fluent:FluentTheme.Palettes>
                <fluent:ColorPaletteResources x:Key="Dark"
                                              Accent="#8C00FF" />
                <fluent:ColorPaletteResources x:Key="Light"
                                              Accent="#7B00FF" />
            </fluent:FluentTheme.Palettes>
        </fluent:FluentTheme>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <Style Selector="HyperlinkButton">
            <Setter Property="Foreground" Value="{x:Static kodo:KodoDesignTokens.LinkBrush}" />
        </Style>
        <Style Selector="HyperlinkButton:pointerover">
            <Setter Property="Foreground" Value="{x:Static kodo:KodoDesignTokens.LinkActiveBrush}" />
        </Style>
        <Style Selector="PopupRoot">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>
