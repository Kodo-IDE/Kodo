<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        xmlns:kodo="clr-namespace:Kodo"
        xmlns:kodoModels="clr-namespace:Kodo.Models"
        xmlns:kodoRenderers="clr-namespace:Kodo.Renderers"
        mc:Ignorable="d"
        x:Class="Kodo.MainWindow"
        x:DataType="kodo:MainWindow"
        x:Name="RootWindow"
        x:CompileBindings="True"
        Width="1100"
        Height="810"
        MinWidth="1280"
        MinHeight="620"
        Title="Kodo"
        Background="{Binding WindowBackgroundBrush}"
        WindowState="Maximized"
        KeyDown="MainWindow_OnKeyDown">
    <Window.Styles>
        <Style Selector="Button.chrome">
            <Setter Property="Background" Value="{Binding ButtonBrush}" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style Selector="Button.chrome:pointerover">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
        </Style>

        <Style Selector="Border#TerminalPanelSplitter:pointerover">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Opacity" Value="{x:Static kodo:KodoDesignTokens.MutedForegroundOpacity}" />
        </Style>

        <Style Selector="Border#ExplorerPanelSplitter:pointerover">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Opacity" Value="{x:Static kodo:KodoDesignTokens.MutedForegroundOpacity}" />
        </Style>

        <Style Selector="Button.chrome:disabled">
            <Setter Property="Background" Value="{Binding ButtonBrush}" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
        </Style>

        <Style Selector="Button.chrome.red">
            <Setter Property="Background" Value="{Binding DangerBrush}" />
            <Setter Property="Foreground" Value="{Binding DangerForegroundBrush}" />
        </Style>

        <Style Selector="Button:focus">
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.activity:focus /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
        </Style>
        <Style Selector="TextBox.quickaccesssearch">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.quickaccesssearch:focus">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.quickaccesssearch:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
        </Style>

        <Style Selector="Border.runbuildgroup">
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CardRadius}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Button.runbuildprimary">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8,0,0,8" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.runbuildprimary:pointerover">
            <Setter Property="Opacity" Value="{x:Static kodo:KodoDesignTokens.SecondaryOpacity}" />
        </Style>

        <Style Selector="Button.runbuildprimary:disabled">
            <Setter Property="Background" Value="{Binding ButtonBrush}" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
        </Style>

        <Style Selector="Button.runbuildarrow">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0,8,8,0" />
            <Setter Property="Padding" Value="8,7" />
        </Style>

        <Style Selector="Button.runbuildarrow:pointerover">
            <Setter Property="Opacity" Value="{x:Static kodo:KodoDesignTokens.SecondaryOpacity}" />
        </Style>

        <Style Selector="Button.runbuildarrow:disabled">
            <Setter Property="Background" Value="{Binding ButtonBrush}" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
        </Style>

        <Style Selector="Button.compilericon">
            <Setter Property="Background" Value="{Binding ButtonBrush}" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style Selector="Button.compilericon:pointerover">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
        </Style>

        <Style Selector="Button.compilericon:disabled">
            <Setter Property="Opacity" Value="{x:Static kodo:KodoDesignTokens.DisabledOpacity}" />
        </Style>

        <Style Selector="Button.chrome.groupheader">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Border Name="PART_Border"
                                Margin="4,0"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Background="Transparent"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>

                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.chrome.groupheader /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.chrome.groupheader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.chrome.groupheader /template/ Border#PART_Border">
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.chrome.groupheader:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
        </Style>

        <Style Selector="Button.marketaction">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.marketaction:pointerover">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>

        <Style Selector="Button.marketaction:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Opacity" Value="{x:Static kodo:KodoDesignTokens.DisabledOpacity}" />
        </Style>
        <Style Selector="Button.marketaction:disabled">
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
        </Style>

        <Style Selector="Button.uninstall">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding #RootWindow.PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{Binding #RootWindow.SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.uninstall:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{Binding #RootWindow.ButtonHoverBrush}" />
        </Style>
        <Style Selector="Button.uninstall:pointerover">
            <Setter Property="BorderBrush" Value="{Binding #RootWindow.AccentBrush}" />
        </Style>

        <Style Selector="Button.uninstall:disabled">
            <Setter Property="Opacity" Value="{x:Static kodo:KodoDesignTokens.DisabledOpacity}" />
        </Style>

        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.PillRadius}" />
            <Setter Property="Padding" Value="14,8" />
        </Style>

        <Style Selector="Button.tab:pointerover">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>

        <Style Selector="Button.tab.tabactive">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
        </Style>

        <Style Selector="Button.settingsnav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.settingsnav:pointerover">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>
        <Style Selector="Button.settingsnav.active">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.PillRadius}" />
        </Style>
        <Style Selector="Button.settingsnav:focus">
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.recent">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="Button.recent:pointerover">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
        </Style>

        <Style Selector="Button.recentpin">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.chrome.groupheader:focus">
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.recentpin:focus">
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.recentpin:pointerover">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>
        <Style Selector="Border.recentbadge">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.PillRadius}" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.recentbadge TextBlock">
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Border.installedtag">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.PillRadius}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.installedtag TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.marketinstall">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.PillRadius}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.marketinstall:pointerover">
            <Setter Property="Background" Value="{Binding #RootWindow.ButtonHoverBrush}" />
            <Setter Property="BorderBrush" Value="{Binding #RootWindow.AccentBrush}" />
        </Style>
        <Style Selector="Button.marketinstall:disabled">
            <Setter Property="Opacity" Value="{x:Static kodo:KodoDesignTokens.DisabledOpacity}" />
        </Style>

        <Style Selector="Border.extstatchip">
            <Setter Property="Background" Value="{Binding ButtonBrush}" />
            <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CardRadius}" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
        <Style Selector="Border.extstatchip.accented">
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.extstatvalue">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>
        <Style Selector="TextBlock.extstatlabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
        </Style>

        <Style Selector="Border.extensionlistcard">
            <Setter Property="Background" Value="{Binding CardBrush}" />
            <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CardRadius}" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <Style Selector="Border.extensionrow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
            <Setter Property="Padding" Value="14,13" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="Border.extensionrow:pointerover">
            <Setter Property="Background" Value="{Binding #RootWindow.ButtonHoverBrush}" />
        </Style>

        <Style Selector="Border.extensiontile">
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CardRadius}" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.extensiontile:pointerover">
            <Setter Property="BorderBrush" Value="{Binding #RootWindow.AccentBrush}" />
        </Style>

        <Style Selector="Button.activity">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.activity /template/ ContentPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Button.activity:pointerover /template/ ContentPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="Button.activity:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
        </Style>

        <Style Selector="Button.activity:pointerover">
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>

        <Style Selector="Button.activity.active /template/ Border#PART_Border">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.activity.active">
            <Setter Property="Foreground" Value="{Binding AccentBrush}" />
        </Style>

        <Style Selector="Button.activity:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
        </Style>

        <Style Selector="Button.activity:pressed">
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
        </Style>

        <Style Selector="Button.activity TextBlock">
            <Setter Property="FontFamily" Value="Noto Sans Symbols,Noto Color Emoji,Segoe UI Symbol,Segoe UI Emoji,Apple Symbols,sans-serif" />
        </Style>

        <Style Selector="Button.activity">
            <Setter Property="ToolTip.Placement" Value="RightEdgeAlignedTop" />
            <Setter Property="ToolTip.HorizontalOffset" Value="8" />
        </Style>

        <Style Selector="Button.statusitem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CompactRadius}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.statusitem /template/ ContentPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Button.statusitem:pointerover /template/ ContentPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Button.statusitem:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
        </Style>
        <Style Selector="Button.statusitem:pointerover">
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>
        <Style Selector="Button.statusitem:focus">
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.statusitem:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
        </Style>
        <Style Selector="Button.statusitem:pressed">
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
        </Style>
        <Style Selector="Button.statusitem.accented">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
        </Style>
        <Style Selector="Button.statusitem.accented:pointerover /template/ Border#PART_Border">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Border.statusDivider">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="{Binding MutedTextBrush}" />
            <Setter Property="Opacity" Value="0.14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0" />
        </Style>
        <Style Selector="Border.statusBarRoot">
            <Setter Property="Background" Value="{Binding TopBarBrush}" />
            <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="TextBlock.statusDim">
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.statusPrimary">
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.dirtyDot">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{Binding AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.searchpanel">
            <Setter Property="Background" Value="{Binding CardBrush}" />
            <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CardRadius}" />
            <Setter Property="Padding" Value="16,14,16,14" />
            <Setter Property="MaxWidth" Value="560" />
            <Setter Property="BoxShadow" Value="0 8 32 0 #40000000" />
        </Style>

        <Style Selector="Button.searchmode">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.PillRadius}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.searchmode:pointerover">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>
        <Style Selector="Button.searchmode.selected">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
        </Style>

        <Style Selector="Button.chrome.selected">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
        </Style>

        <Style Selector="Button.chromesmall">
            <Setter Property="Background" Value="{Binding ButtonBrush}" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="{x:Static kodo:KodoDesignTokens.BorderThin}" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.iconwell">
            <Setter Property="Width" Value="{x:Static kodo:KodoDesignTokens.IconWellSize}" />
            <Setter Property="Height" Value="{x:Static kodo:KodoDesignTokens.IconWellSize}" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
        </Style>
        <Style Selector="Border.iconwellmedium">
            <Setter Property="Width" Value="{x:Static kodo:KodoDesignTokens.IconWellMediumSize}" />
            <Setter Property="Height" Value="{x:Static kodo:KodoDesignTokens.IconWellMediumSize}" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CardRadius}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.iconwelllarge">
            <Setter Property="Width" Value="{x:Static kodo:KodoDesignTokens.IconWellLargeSize}" />
            <Setter Property="Height" Value="{x:Static kodo:KodoDesignTokens.IconWellLargeSize}" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CardRadius}" />
        </Style>
        <Style Selector="Border.accentleading">
            <Setter Property="Width" Value="{x:Static kodo:KodoDesignTokens.AccentBarWidth}" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.AccentLineRadius}" />
        </Style>
        <Style Selector="Border.homeunderline">
            <Setter Property="Height" Value="2" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.SmallRadius}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{Binding AccentBrush}" />
        </Style>
        <Style Selector="Button.chromesmall:pointerover">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
        </Style>
        <Style Selector="Button.chromesmall.selected">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
        </Style>

        <Style Selector="Border.searchpill">
            <Setter Property="Background" Value="{Binding ButtonBrush}" />
            <Setter Property="BorderBrush" Value="{Binding SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="{x:Static kodo:KodoDesignTokens.BorderThin}" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
            <Setter Property="Height" Value="{x:Static kodo:KodoDesignTokens.LargeControlHeight}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.searchpill > TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="{x:Static kodo:KodoDesignTokens.HorizontalPadding}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ListBox.searchresults">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4,0,0" />
            <Setter Property="MaxHeight" Value="320" />
        </Style>
        <Style Selector="ListBox.searchresults ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
        </Style>
        <Style Selector="ListBox.searchresults ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CompactRadius}" />
        </Style>
                <Style Selector="ListBox.searchresults ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CompactRadius}" />
        </Style>

        <Style Selector="ListBox.codeactions">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MaxHeight" Value="340" />
        </Style>
        <Style Selector="ListBox.codeactions ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
        </Style>
        <Style Selector="ListBox.codeactions ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CompactRadius}" />
        </Style>
        <Style Selector="ListBox.codeactions ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="Foreground" Value="{Binding AccentForegroundBrush}" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CompactRadius}" />
        </Style>
        <Style Selector="ListBox.codeactions ListBoxItem:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="{x:Static kodo:KodoDesignTokens.SelectedOpacity}" />
        </Style>

        <Style Selector="ListBox.searchresults Button.groupheader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CompactRadius}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="ListBox.searchresults Button.groupheader:pointerover">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
        </Style>

        <Style Selector="Button.editortab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="Border.tabwrap">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.tabwrap:pointerover">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
        </Style>
        <Style Selector="Border.tabwrap.active">
            <Setter Property="Background" Value="{Binding ButtonBrush}" />
        </Style>

        <Style Selector="Window.reducedmotion Button">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>
        <Style Selector="Window.reducedmotion Border">
            <Setter Property="Transitions">
                <Transitions />
            </Setter>
        </Style>

        <Style Selector="Button.editortab:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>
        <Style Selector="Button.editortab:focus">
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.editortab.active">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>

        <Style Selector="TextBlock.tablabel">
            <Setter Property="Foreground" Value="{Binding #RootWindow.MutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.tablabel.active">
            <Setter Property="Foreground" Value="{Binding #RootWindow.PrimaryTextBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style Selector="Border.openeditorrow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CompactRadius}" />
        </Style>

        <Style Selector="Button.openeditor">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CompactRadius}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="Button.openeditor:pointerover">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>
        <Style Selector="Button.openeditor:focus">
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.openeditor.active">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
        </Style>

        <Style Selector="Border.openeditorrow.active Button.openeditor">
            <Setter Property="Foreground" Value="{Binding #RootWindow.PrimaryTextBrush}" />
        </Style>

        <Style Selector="Button.tabclose">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CardRadius}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tabclose:pointerover">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>
        <Style Selector="Border.tabwrap:pointerover Button.tabclose">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.tabclose.active">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>
        <Style Selector="Border.tabwrap.active Button.tabclose">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>

        <Style Selector="Border.tabwrap:pointerover Viewbox.dirtydot">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="Border.tabunderline">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Height" Value="2.5" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.TabUnderlineRadius}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.tabwrap:pointerover Border.tabunderline">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.tabwrap.active Border.tabunderlinebase">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.fileitem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.CompactRadius}" />
        </Style>

        <Style Selector="Button.fileitem:pointerover">
            <Setter Property="Background" Value="{Binding ButtonHoverBrush}" />
        </Style>
        <Style Selector="Button.fileitem:focus">
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBox.editor">
            <Setter Property="Background" Value="{Binding EditorBackgroundBrush}" />
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontFamily" Value="JetBrains Mono,DejaVu Sans Mono,Ubuntu Mono,Noto Sans Mono,Cascadia Code,Consolas,Menlo,Noto Color Emoji,Segoe UI Emoji,Apple Color Emoji,Monospace" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
        </Style>

        <Style Selector="ToolTip">
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="Background" Value="{Binding #RootWindow.CardBrush}" />
            <Setter Property="Foreground" Value="{Binding #RootWindow.PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{Binding #RootWindow.SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ToolTip TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{Binding #RootWindow.PrimaryTextBrush}" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{Binding PrimaryTextBrush}" />
        </Style>
        <Style Selector="CheckBox /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{Binding AccentBrush}" />
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="{Binding AccentForegroundBrush}" />
        </Style>
        <Style Selector="CheckBox:indeterminate /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="{Binding AccentForegroundBrush}" />
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="True" />
            <Setter Property="IsScrollChainingEnabled" Value="True" />
        </Style>

        <Style Selector="Menu ScrollViewer, ContextMenu ScrollViewer, ComboBox ScrollViewer">
            <Setter Property="MaxHeight" Value="420" />
            <Setter Property="AllowAutoHide" Value="True" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="60,Auto,Auto,*" RowDefinitions="Auto,*">

        <Border Grid.Row="1" Grid.Column="0"
                Background="{Binding SidebarBrush}"
                BorderBrush="{Binding SurfaceBorderBrush}"
                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderRightHairline}">
            <DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10" Spacing="0" HorizontalAlignment="Stretch"
                            IsHitTestVisible="{Binding AreSidebarButtonsEnabled}">
                    <Button Classes="activity" Classes.active="{Binding IsSettingsPageVisible}" Click="SettingsButton_OnClick" AutomationProperties.Name="{Binding SettingsTooltip}"
                            ToolTip.Tip="{Binding SettingsTooltip}">
                        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                <svg:Svg Width="22" Height="22" Canvas.Left="1" Canvas.Top="1"
                                      Stretch="Uniform"
                                      CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                      Source="{x:Static kodo:KodoIcons.Gear}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="ActivityBarPanel" Margin="0,10,0,0" Spacing="0" HorizontalAlignment="Stretch"
                            IsHitTestVisible="{Binding AreSidebarButtonsEnabled}">
                    <Button Classes="activity" Classes.active="{Binding IsHomePageVisible}" Click="HomeButton_OnClick" AutomationProperties.Name="{Binding HomeTooltip}"
                            ToolTip.Tip="{Binding HomeTooltip}">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                      Source="{x:Static kodo:KodoIcons.Home}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="activity" Classes.active="{Binding IsEditorPageVisible}" Click="EditorButton_OnClick" AutomationProperties.Name="{Binding EditorTooltip}"
                            ToolTip.Tip="{Binding EditorTooltip}">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                      Source="{x:Static kodo:KodoIcons.Pencil}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="activity"
                            Classes.active="{Binding IsGitSourceControlPanelOpen}"
                            Click="GitSourceControlActivityButton_OnClick"
                            AutomationProperties.Name="Source Control (Ctrl+Shift+G)"
                            ToolTip.Tip="Source Control (Ctrl+Shift+G)"
                            IsVisible="{Binding IsGitSourceControlEnabled}">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                <svg:Svg Width="22" Height="22" Canvas.Left="1" Canvas.Top="1"
                                      Stretch="Uniform"
                                      CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                      Source="{x:Static kodo:KodoIcons.GitHub}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Border Height="2"
                            Width="28"
                            CornerRadius="{x:Static kodo:KodoDesignTokens.SmallRadius}"
                            Background="{Binding AccentBrush}"
                            Opacity="{x:Static kodo:KodoDesignTokens.MutedForegroundOpacity}"
                            HorizontalAlignment="Center"
                            Margin="0,2,0,2" />
                    <Button Classes="activity" Click="NewFileButton_OnClick" AutomationProperties.Name="{Binding NewFileTooltip}"
                            ToolTip.Tip="{Binding NewFileTooltip}">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                      Source="{x:Static kodo:KodoIcons.PagePlus}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="activity" Click="OpenFileButton_OnClick" AutomationProperties.Name="{Binding OpenFileTooltip}"
                            ToolTip.Tip="{Binding OpenFileTooltip}">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                      Source="{x:Static kodo:KodoIcons.ArrowDownTray}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="activity"
                            Click="OpenFolderButton_OnClick"
                            AutomationProperties.Name="{Binding OpenFolderTooltip}"
                            ToolTip.Tip="{Binding OpenFolderTooltip}"
                            IsVisible="{Binding !IsFolderOpen}">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                      Source="{x:Static kodo:KodoIcons.FolderPlus}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="activity"
                            Classes.active="{Binding IsFileExplorerVisible}"
                            Click="CollapseExplorerButton_OnClick"
                            AutomationProperties.Name="{Binding ToggleExplorerTooltip}"
                            ToolTip.Tip="{Binding ToggleExplorerTooltip}"
                            IsVisible="{Binding IsFolderOpen}">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">

                                <svg:Svg Width="24" Height="24" IsVisible="{Binding IsFileExplorerVisible}"
                                      CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                      Source="{x:Static kodo:KodoIcons.FolderChevronLeft}" />

                                <svg:Svg Width="24" Height="24" IsVisible="{Binding !IsFileExplorerVisible}"
                                      CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                      Source="{x:Static kodo:KodoIcons.FolderChevronRight}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="activity" Classes.active="{Binding IsExtensionsPageVisible}" Click="ExtensionsButton_OnClick" AutomationProperties.Name="{Binding OpenExtensionsTooltip}"
                            ToolTip.Tip="{Binding OpenExtensionsTooltip}">
                        <Viewbox Width="20" Height="20"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                      Source="{x:Static kodo:KodoIcons.PuzzlePiece}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="SidebarSplitGrid" Grid.Row="1" Grid.Column="1" RowDefinitions="*,0,0">
        <Border Grid.Row="0"
                Width="{Binding ExplorerPanelWidth}"
                MinWidth="{Binding ExplorerPanelMinWidth}"
                MaxWidth="600"
                IsVisible="{Binding IsFileExplorerVisible}"
                VerticalAlignment="Stretch"
                Background="{Binding SidebarBrush}"
                BorderBrush="{Binding SurfaceBorderBrush}"
                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderRightHairline}">
            <Grid RowDefinitions="Auto,Auto,*">

                <Border Grid.Row="0"
                        Background="{Binding TopBarBrush}"
                        BorderBrush="{Binding SurfaceBorderBrush}"
                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderBottomHairline}"
                        Padding="12,8">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="6"
                              VerticalAlignment="Center"
                              MinWidth="0">
                            <Border Classes="accentleading" Height="16" Background="{Binding AccentBrush}" />
                            <TextBlock Grid.Column="1"
                                       FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="{Binding ExplorerHeaderText}"
                                       ToolTip.Tip="{Binding ExplorerHeaderTooltipText}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </Grid>
                        <Button Grid.Column="1"
                                Classes="activity"
                                Width="28"
                                Height="28"
                                IsVisible="{Binding IsFolderOpen}"
                                Click="ExplorerHeaderNewFileButton_OnClick"
                                AutomationProperties.Name="Create a new file in this folder"
                                ToolTip.Tip="Create a new file in this folder">
                            <Viewbox Width="16" Height="16"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                    <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                          Source="{x:Static kodo:KodoIcons.PagePlus}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Grid.Column="2"
                                Classes="activity"
                                Width="28"
                                Height="28"
                                IsVisible="{Binding IsFolderOpen}"
                                Click="ExplorerHeaderNewFolderButton_OnClick"
                                AutomationProperties.Name="Create a new folder in this folder"
                                ToolTip.Tip="Create a new folder in this folder">
                            <Viewbox Width="16" Height="16"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                    <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                          Source="{x:Static kodo:KodoIcons.FolderPlus}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Grid.Column="3"
                                Classes="activity"
                                Width="28"
                                Height="28"
                                IsVisible="{Binding IsFolderOpen}"
                                Click="CollapseAllTreeButton_OnClick"
                                AutomationProperties.Name="Expand or collapse all folders"
                                ToolTip.Tip="Expand or collapse all folders">
                            <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                    <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                          Source="{x:Static kodo:KodoIcons.ChevronUpDown}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Grid.Column="4"
                                Classes="activity"
                                Width="28"
                                Height="28"
                                IsVisible="{Binding IsFolderOpen}"
                                Click="CloseFolderButton_OnClick"
                                AutomationProperties.Name="{Binding CloseFolderTooltip}"
                                ToolTip.Tip="{Binding CloseFolderTooltip}">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                    <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                          Source="{x:Static kodo:KodoIcons.FolderX}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        IsVisible="{Binding HasOpenEditors}"
                        Background="{Binding SidebarBrush}"
                        BorderBrush="{Binding SurfaceBorderBrush}"
                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderBottomHairline}"
                        Padding="12,10,12,8">
                    <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Classes="accentleading" Height="16" Background="{Binding AccentBrush}" />
                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       Text="OPEN EDITORS" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding OpenTabs}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemContainerTheme>
                                <ControlTheme TargetType="ContentPresenter">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </ControlTheme>
                            </ItemsControl.ItemContainerTheme>
                            <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="kodoModels:EditorTab" x:CompileBindings="True">
                                    <Border Classes="openeditorrow"
                                            Classes.active="{Binding IsSelected}"
                                            Margin="0,0,0,2">
                                        <Border.ContextMenu>
                                            <ContextMenu Opening="EditorTabContextMenu_OnOpening">
                                                <MenuItem Header="Save"
                                                          Tag="{Binding}"
                                                          Click="SaveEditorTabMenuItem_OnClick" />
                                                <MenuItem Header="Save As..."
                                                          Tag="{Binding}"
                                                          Click="SaveEditorTabAsMenuItem_OnClick" />
                                                <Separator />
                                                <MenuItem Header="Copy Path"
                                                          Tag="{Binding}"
                                                          Click="CopyEditorTabPathMenuItem_OnClick" />
                                                <MenuItem Header="Copy Relative Path"
                                                          Tag="{Binding}"
                                                          Click="CopyEditorTabRelativePathMenuItem_OnClick" />
                                                <MenuItem Header="Copy File Name"
                                                          Tag="{Binding}"
                                                          Click="CopyEditorTabNameMenuItem_OnClick" />
                                                <MenuItem Header="{Binding #RootWindow.RevealInFileManagerText}"
                                                          Tag="{Binding}"
                                                          Click="RevealEditorTabInExplorerMenuItem_OnClick" />
                                                <MenuItem Header="Open in Integrated Terminal"
                                                          Tag="{Binding}"
                                                          Click="OpenEditorTabInTerminalMenuItem_OnClick" />
                                                <MenuItem Header="Open to the Side"
                                                          Tag="{Binding}"
                                                          Click="OpenEditorTabToSideMenuItem_OnClick" />
                                                <Separator />
                                                <MenuItem Header="Close File"
                                                          Tag="{Binding}"
                                                          Click="CloseEditorTabButton_OnClick" />
                                                <MenuItem Header="Close Other Files"
                                                          Tag="{Binding}"
                                                          Click="CloseOtherTabsButton_OnClick" />
                                                <MenuItem Header="Close Files Below"
                                                          Tag="{Binding}"
                                                          Click="CloseTabsToTheRightMenuItem_OnClick" />
                                                <MenuItem Header="Close All Files"
                                                          Click="CloseAllTabsButton_OnClick" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid ColumnDefinitions="3,Auto,*,Auto">
                                            <Border Grid.Column="0"
                                                    Classes="accentleading"
                                                    Margin="0,3,6,3"
                                                    IsVisible="{Binding IsSelected}"
                                                    Background="{Binding #RootWindow.AccentBrush}" />
                                            <Button Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    Classes="openeditor"
                                                    Classes.active="{Binding IsSelected}"
                                                    Tag="{Binding}"
                                                    Click="OpenEditorTabButton_OnClick"
                                                    ToolTip.Tip="{Binding Path}"
                                                     AutomationProperties.Name="{Binding Path}"
                                                    HorizontalContentAlignment="Stretch">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <Viewbox Grid.Column="0"
                                                             Width="30" Height="14"
                                                             Margin="0,0,7,0"
                                                             VerticalAlignment="Center"
                                                             Stretch="Uniform">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                   FontFamily="JetBrains Mono,DejaVu Sans Mono,Ubuntu Mono,Noto Sans Mono,Cascadia Code,Consolas,Menlo,Monospace"
                                                                   Width="38"
                                                                   Height="15"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Icon}"
                                                                   Foreground="{Binding #RootWindow.MutedTextBrush}" />
                                                    </Viewbox>
                                                    <TextBlock Grid.Column="1"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="2"
                                                            Background="{Binding #RootWindow.ButtonBrush}"
                                                            BorderBrush="{Binding #RootWindow.DangerBrush}"
                                                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                                            CornerRadius="{x:Static kodo:KodoDesignTokens.CompactRadius}"
                                                            Padding="4,0"
                                                            Margin="4,0"
                                                            IsVisible="{Binding HasErrorDiagnostics}"
                                                            ToolTip.Tip="{Binding DiagnosticsTooltip}">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.CaptionFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding #RootWindow.DangerBrush}"
                                                                   Text="{Binding ErrorCount}"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <Viewbox Grid.Column="3"
                                                             Width="7" Height="7"
                                                             Margin="6,0,0,0"
                                                             VerticalAlignment="Center"
                                                             IsVisible="{Binding IsDirty}">
                                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.AccentBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                  Source="{x:Static kodo:KodoIcons.Circle}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Classes="tabclose"
                                                    Classes.active="{Binding IsSelected}"
                                                    Tag="{Binding}"
                                                    Click="CloseEditorTabButton_OnClick"
                                                    Margin="4,0,3,0"
                                                    AutomationProperties.Name="Close this tab"
                                                    ToolTip.Tip="Close this tab">
                                                <Viewbox Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                        <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.PrimaryTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                              Source="{x:Static kodo:KodoIcons.XMark}" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2"
                              IsVisible="{Binding IsFolderOpen}"
                              ClipToBounds="True"
                              AllowAutoHide="True"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FileTreeItems}" Margin="4,4,4,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="kodoModels:FileTreeItem"
                                          x:CompileBindings="True">
                                <Button Classes="fileitem"
                                        Tag="{Binding}"
                                        Click="FileTreeItem_OnClick"
                                        Margin="0,0.5">
                                    <ToolTip.Tip>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" />
                                            <TextBlock Text="{Binding FullPath}"
                                                       Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                       FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                       Opacity="{x:Static kodo:KodoDesignTokens.StrongOpacity}" />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="New File"
                                                      Tag="{Binding}"
                                                      Click="NewFileInExplorerMenuItem_OnClick" />
                                            <MenuItem Header="New Folder"
                                                      Tag="{Binding}"
                                                      Click="NewFolderInExplorerMenuItem_OnClick" />
                                            <Separator />
                                            <MenuItem Header="Open"
                                                      Tag="{Binding}"
                                                      Click="OpenExplorerItemMenuItem_OnClick" />
                                            <MenuItem Header="Open to the Side"
                                                      Tag="{Binding}"
                                                      IsEnabled="{Binding !IsDirectory}"
                                                      Click="OpenExplorerItemToSideMenuItem_OnClick" />
                                            <MenuItem Header="{Binding #RootWindow.RevealInFileManagerText}"
                                                      Tag="{Binding}"
                                                      Click="RevealExplorerItemMenuItem_OnClick" />
                                            <MenuItem Header="Search in Folder"
                                                      Tag="{Binding}"
                                                      Click="SearchInFolderMenuItem_OnClick" />
                                            <MenuItem Header="Open in Integrated Terminal"
                                                      Tag="{Binding}"
                                                      Click="OpenExplorerItemInTerminalMenuItem_OnClick" />
                                            <Separator />
                                            <MenuItem Header="Rename"
                                                      Tag="{Binding}"
                                                      Click="RenameFileMenuItem_OnClick" />
                                            <Separator />
                                            <MenuItem Header="Cut"
                                                      Tag="{Binding}"
                                                      Click="CutFileMenuItem_OnClick" />
                                            <MenuItem Header="Copy"
                                                      Tag="{Binding}"
                                                      Click="CopyFileMenuItem_OnClick" />
                                            <MenuItem Header="Paste"
                                                      Tag="{Binding}"
                                                      Click="PasteFileMenuItem_OnClick" />
                                            <Separator />
                                            <MenuItem Header="Copy Name"
                                                      Tag="{Binding}"
                                                      Click="CopyFileNameMenuItem_OnClick" />
                                            <MenuItem Header="Copy Path"
                                                      Tag="{Binding}"
                                                      Click="CopyFilePathMenuItem_OnClick" />
                                            <MenuItem Header="Copy Relative Path"
                                                      Tag="{Binding}"
                                                      Click="CopyRelativeFilePathMenuItem_OnClick" />
                                            <Separator />
                                            <MenuItem Header="Duplicate"
                                                      Tag="{Binding}"
                                                      Click="DuplicateExplorerItemMenuItem_OnClick" />
                                            <MenuItem Header="Delete"
                                                      Tag="{Binding}"
                                                      Click="DeleteFileMenuItem_OnClick" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid ColumnDefinitions="Auto,Auto,*">

                                        <ItemsControl Grid.Column="0"
                                                      ItemsSource="{Binding GuideLevels}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:Int32">
                                                    <Border Width="14" VerticalAlignment="Stretch">
                                                        <Border Width="1"
                                                                HorizontalAlignment="Left"
                                                                Opacity="{x:Static kodo:KodoDesignTokens.DisabledOpacity}"
                                                                Background="{Binding #RootWindow.SurfaceBorderBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="1"
                                                    FontSize="{x:Static kodo:KodoDesignTokens.CaptionFontSize}"
                                                    Width="16"
                                                    VerticalAlignment="Center"
                                                    Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                    Text="{Binding ChevronText}"
                                                    Margin="0,0,2,0" />

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Margin="0,1">

                                            <Viewbox Width="32" Height="15"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding IsDirectory}">
                                                <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">

                                                    <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.MutedTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                          Source="{x:Static kodo:KodoIcons.Folder}">
                                                        <svg:Svg.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="IsDirectory" />
                                                                <Binding Path="!IsExpanded" />
                                                            </MultiBinding>
                                                        </svg:Svg.IsVisible>
                                                    </svg:Svg>

                                                    <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.AccentBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                          Opacity="{x:Static kodo:KodoDesignTokens.SecondaryOpacity}"
                                                          Source="{x:Static kodo:KodoIcons.FolderOpen}">
                                                        <svg:Svg.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="IsDirectory" />
                                                                <Binding Path="IsExpanded" />
                                                            </MultiBinding>
                                                        </svg:Svg.IsVisible>
                                                    </svg:Svg>
                                                </Canvas>
                                            </Viewbox>

                                            <Viewbox Width="32" Height="15"
                                                     IsVisible="{Binding !IsDirectory}"
                                                     VerticalAlignment="Center"
                                                     Stretch="Uniform">
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                           FontFamily="JetBrains Mono,DejaVu Sans Mono,Ubuntu Mono,Noto Sans Mono,Cascadia Code,Consolas,Menlo,Monospace"
                                                           Width="40"
                                                           Height="16"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Icon}"
                                                           Foreground="{Binding #RootWindow.MutedTextBrush}" />
                                            </Viewbox>
                                            <TextBox FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                     IsVisible="{Binding IsRenaming}"
                                                     Text="{Binding RenameText, Mode=TwoWay}"
                                                     KeyDown="InlineRenameTextBox_OnKeyDown"
                                                     LostFocus="InlineRenameTextBox_OnLostFocus"
                                                     MinWidth="0"
                                                     Padding="4,1"
                                                     VerticalContentAlignment="Center">
                                                <TextBox.Width>
                                                    <MultiBinding Converter="{x:Static kodoModels:ExplorerItemNameMaxWidthConverter.Instance}">
                                                        <Binding ElementName="RootWindow" Path="ExplorerPanelWidth" />
                                                        <Binding Path="IndentWidth" />
                                                    </MultiBinding>
                                                </TextBox.Width>
                                            </TextBox>
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                       IsVisible="{Binding !IsRenaming}"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Name}"
                                                       Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.MaxWidth>
                                                    <MultiBinding Converter="{x:Static kodoModels:ExplorerItemNameMaxWidthConverter.Instance}">
                                                        <Binding ElementName="RootWindow" Path="ExplorerPanelWidth" />
                                                        <Binding Path="IndentWidth" />
                                                    </MultiBinding>
                                                </TextBlock.MaxWidth>
                                            </TextBlock>
                                            <Border Background="{Binding #RootWindow.ButtonBrush}"
                                                    BorderBrush="{Binding #RootWindow.DangerBrush}"
                                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CompactRadius}"
                                                    Padding="4,0"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding HasErrorDiagnostics}"
                                                    ToolTip.Tip="{Binding ErrorCountTooltip}">
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.CaptionFontSize}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding #RootWindow.DangerBrush}"
                                                           Text="{Binding ErrorCount}"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <GridSplitter x:Name="SidebarSplitter"
                      Grid.Row="1"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Height="{x:Static kodo:KodoDesignTokens.SplitterWidth}"
                      HorizontalAlignment="Stretch"
                      Background="{Binding SurfaceBorderBrush}"
                      ToolTip.Tip="Drag to resize the sidebar panes"
                      IsVisible="False" />

        <ContentControl x:Name="GitSourcePanelHost"
                        Grid.Row="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsVisible="False" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="2"
                x:Name="ExplorerPanelSplitter"
                Width="{x:Static kodo:KodoDesignTokens.SplitterWidth}"
                Background="Transparent"
                IsVisible="{Binding IsFileExplorerVisible}"
                Cursor="SizeWestEast"
                ToolTip.Tip="Drag to resize the file explorer panel"
                PointerPressed="ExplorerPanelSplitter_OnPointerPressed"
                PointerMoved="ExplorerPanelSplitter_OnPointerMoved"
                PointerReleased="ExplorerPanelSplitter_OnPointerReleased"
                PointerCaptureLost="ExplorerPanelSplitter_OnPointerCaptureLost"
                DoubleTapped="ExplorerPanelSplitter_OnDoubleTapped" />

        <Grid x:Name="ContentRegionGrid" Grid.Row="1" Grid.Column="3" RowDefinitions="Auto,*" VerticalAlignment="Stretch">

            <StackPanel Grid.Row="0" Spacing="1">

                <Border IsVisible="{Binding IsAppUpdateAvailable}"
                        Background="{Binding AccentBrush}"
                        Padding="18,8">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       Foreground="{Binding AccentForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Text="A new version of Kodo is available -" />
                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding AccentForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Text="{Binding LatestReleaseTag}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="chrome"
                                Click="DownloadUpdateButton_OnClick"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                ToolTip.Tip="Download the latest version of Kodo"
                                AutomationProperties.Name="Download the latest version of Kodo"
                                Content="Download Update" />
                        <Button Grid.Column="2"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{Binding AccentForegroundBrush}"
                                Padding="6,4"
                                VerticalAlignment="Center"
                                Click="DismissUpdateBanner_OnClick"
                                ToolTip.Tip="Dismiss this update notification">
                            <Viewbox Width="11" Height="11">
                                <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                    <svg:Svg Width="24" Height="24" CurrentColor="{Binding AccentForegroundBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                          Source="{x:Static kodo:KodoIcons.XMark}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <Border IsVisible="{Binding IsExtensionUpdateBannerVisible}"
                        Background="{Binding AccentBrush}"
                        Padding="18,8">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                   Foreground="{Binding AccentForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Text="{Binding ExtensionUpdatesBannerText}" />
                        <Button Grid.Column="1"
                                Classes="chrome"
                                Click="OpenMarketplaceFromBannerButton_OnClick"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                ToolTip.Tip="Go to the Extensions Marketplace"
                                AutomationProperties.Name="Go to the Extensions Marketplace"
                                Content="Open Marketplace" />
                        <Button Grid.Column="2"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{Binding AccentForegroundBrush}"
                                Padding="6,4"
                                VerticalAlignment="Center"
                                Click="DismissExtensionUpdateBanner_OnClick"
                                ToolTip.Tip="Dismiss this extension update notification">
                            <Viewbox Width="11" Height="11">
                                <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                    <svg:Svg Width="24" Height="24" CurrentColor="{Binding AccentForegroundBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                          Source="{x:Static kodo:KodoIcons.XMark}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <Border IsVisible="{Binding IsAppLoadingVisible}"
                        Background="{Binding TopBarBrush}"
                        BorderBrush="{Binding SurfaceBorderBrush}"
                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderBottomHairline}"
                        Padding="18,5"
                        IsHitTestVisible="False">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppLoadingLabel}"
                                   FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                   Foreground="{Binding MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1"
                                     Height="3"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding AppLoadingProgress}"
                                     IsIndeterminate="{Binding AppLoadingIsIndeterminate}"
                                     VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <Panel Grid.Row="1">
            <Grid IsVisible="{Binding IsHomeOrEditorPageVisible}" IsHitTestVisible="{Binding IsHomeOrEditorPageVisible}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        IsVisible="{Binding !IsHomePageVisible}"
                        Background="{Binding TopBarBrush}"
                        BorderBrush="{Binding SurfaceBorderBrush}"
                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderBottomHairline}"
                        Padding="18,12">
                    <Grid>
                    <Panel>
                        <StackPanel x:Name="TopBarBrandPanel" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                    ClipToBounds="True">
                                <Image Source="avares://Kodo/Assets/kodo-logo.png"
                                       Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Spacing="2">
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding PrimaryTextBrush}"
                                           Text="Kodo" />
                                <TextBlock x:Name="FileSummaryLiveRegion" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                           Foreground="{Binding MutedTextBrush}"
                                           AutomationProperties.LiveSetting="Polite"
                                           Text="{Binding FileSummaryText}" />
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="QuickAccessSearchFrame"
                                Classes="quickaccessframe"
                                MinWidth="140"
                                MaxWidth="760"
                                Height="{x:Static kodo:KodoDesignTokens.LargeControlHeight}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{Binding EditorBackgroundBrush}"
                                BorderBrush="{Binding QuickAccessSearchBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                Padding="10,0"
                                PointerPressed="QuickAccessSearchFrame_OnPointerPressed"
                                PointerMoved="QuickAccessSearchFrame_OnPointerMoved"
                                PointerReleased="QuickAccessSearchFrame_OnPointerReleased"
                                PointerCaptureLost="QuickAccessSearchFrame_OnPointerCaptureLost"
                                DoubleTapped="QuickAccessSearchFrame_OnDoubleTapped"
                                ToolTip.Tip="Drag an edge to resize the command palette · double-click to reset">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                    <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                        <svg:Svg Width="24" Height="24" CurrentColor="{Binding MutedTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                              Source="{x:Static kodo:KodoIcons.Magnifier}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBox x:Name="QuickAccessSearchBox"
                                         Grid.Column="1"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Center"
                                         PlaceholderText=""
                                         FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                         Padding="2,0"
                                         Classes="quickaccesssearch"
                                         Background="Transparent"
                                         Foreground="{Binding PrimaryTextBrush}"
                                         BorderBrush="Transparent"
                                         BorderThickness="0"
                                         FocusAdorner="{x:Null}"
                                         VerticalContentAlignment="Center"
                                         TextChanged="QuickAccessSearchBox_OnTextChanged"
                                         GotFocus="QuickAccessSearchBox_OnGotFocus"
                                         LostFocus="QuickAccessSearchBox_OnLostFocus"
                                         KeyDown="CommandPaletteSearch_OnKeyDown" />
                                <TextBlock Grid.Column="1"
                                           Margin="2,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           IsVisible="{Binding IsCommandPaletteRarePreviewVisible}"
                                           Foreground="{Binding MutedTextBrush}"
                                           FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}">
                                    <TextBlock.Inlines><Run Text="Code fast, stay"/><Run Text=" "/><Run Text="light" Foreground="{Binding AccentBrush}"/><Run Text="."/></TextBlock.Inlines>
                                </TextBlock>
                                <Border Grid.Column="2"
                                        Background="{Binding ButtonBrush}"
                                        BorderBrush="{Binding SurfaceBorderBrush}"
                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                        CornerRadius="{x:Static kodo:KodoDesignTokens.CompactRadius}"
                                        Padding="5,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding QuickAccessShortcutText}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.CaptionFontSize}"
                                               Foreground="{Binding MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="TopBarRightToolbarStack"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsEditorTabsVisible}">

                            <Button Classes="chrome"
                                    ToolTip.Tip="{Binding SaveTooltip}"
                                    IsEnabled="{Binding HasOpenEditors}"
                                    Click="ToolbarSaveButton_OnClick"
                                    AutomationProperties.Name="{Binding SaveTooltip}"
                                    Content="Save" />

                            <Button Classes="chrome"
                                    ToolTip.Tip="{Binding SaveAsTooltip}"
                                    IsEnabled="{Binding HasOpenEditors}"
                                    Click="ToolbarSaveAsButton_OnClick"
                                    AutomationProperties.Name="{Binding SaveAsTooltip}"
                                    Content="Save As" />

                            <Button Classes="chrome"
                                    ToolTip.Tip="Save All"
                                    IsEnabled="{Binding HasMultipleOpenEditors}"
                                    Click="ToolbarSaveAllButton_OnClick"
                                    AutomationProperties.Name="Save All"
                                    Content="Save All" />
                            <Button Classes="chrome"
                                    ToolTip.Tip="Show or close the side-by-side editor pane"
                                    IsEnabled="{Binding CanToggleSplitEditor}"
                                    Click="ToggleSplitEditorButton_OnClick"
                                    AutomationProperties.Name="Show or close the side-by-side editor pane"
                                    Content="{Binding SplitEditorButtonText}" />
                        </StackPanel>

                        <Border Width="1"
                                Height="20"
                                Background="{Binding SurfaceBorderBrush}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsEditorTabsVisible}" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="12"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsEditorTabsVisible}">

                            <Border Classes="runbuildgroup">
                                <Grid ColumnDefinitions="Auto,Auto">
                                    <Button Classes="runbuildprimary"
                                            IsEnabled="{Binding IsRunButtonEnabled}"
                                            ToolTip.Tip="{Binding RunBuildButtonTooltip}"
                                            Click="RunButton_OnClick">
                                        <TextBlock Text="Run" LineHeight="16"/>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Classes="runbuildarrow"
                                            IsEnabled="{Binding IsRunButtonEnabled}"
                                            ToolTip.Tip="{Binding RunBuildButtonTooltip}"
                                            AutomationProperties.Name="{Binding RunBuildButtonTooltip}"
                                            Click="RunMenuButton_OnClick">
                                        <TextBlock Text="&#x25BE;" LineHeight="16"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Classes="runbuildgroup">
                                <Grid ColumnDefinitions="Auto,Auto">
                                    <Button Classes="runbuildprimary"
                                            IsEnabled="{Binding IsBuildButtonEnabled}"
                                            ToolTip.Tip="{Binding RunBuildButtonTooltip}"
                                            AutomationProperties.Name="{Binding RunBuildButtonTooltip}"
                                            Click="BuildButton_OnClick">
                                        <TextBlock Text="Build" LineHeight="16"/>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Classes="runbuildarrow"
                                            IsEnabled="{Binding IsBuildButtonEnabled}"
                                            ToolTip.Tip="{Binding RunBuildButtonTooltip}"
                                            AutomationProperties.Name="{Binding RunBuildButtonTooltip}"
                                            Click="BuildMenuButton_OnClick">
                                        <TextBlock Text="&#x25BE;" LineHeight="16"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Button Classes="compilericon"
                                    IsVisible="{Binding IsCompilerIconVisible}"
                                    ToolTip.Tip="{Binding RunBuildButtonTooltip}"
                                    AutomationProperties.Name="{Binding RunBuildButtonTooltip}"
                                    Click="CompilerIconButton_OnClick">
                                <Panel>
                                    <Image Source="{Binding ActiveCompilerExtension.IconImage}"
                                           Width="22"
                                           Height="22"
                                           Stretch="Uniform"
                                           IsHitTestVisible="False"
                                           IsVisible="{Binding ActiveCompilerExtension.IconImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <svg:Svg Source="{Binding ActiveCompilerExtension.SvgData}"
                                             Width="22"
                                             Height="22"
                                             IsHitTestVisible="False"
                                             IsVisible="{Binding ActiveCompilerExtension.SvgData, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </Panel>
                            </Button>
                        </StackPanel>
                        </StackPanel>
                    </Panel>
                    </Grid>

                </Border>

                <Border Grid.Row="1"
                        Background="{Binding TopBarBrush}"
                        BorderBrush="{Binding SurfaceBorderBrush}"
                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderBottomHairline}"
                        IsVisible="{Binding IsSharedEditorTabsVisible}">
                    <ScrollViewer x:Name="EditorTabScrollViewer"
                                   AllowAutoHide="True"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding OpenTabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="kodoModels:EditorTab" x:CompileBindings="True">
                                    <Border Classes="tabwrap"
                                            Classes.active="{Binding IsSelected}">
                                        <Border.ContextMenu>
                                            <ContextMenu Opening="EditorTabContextMenu_OnOpening">
                                                <MenuItem Header="Save"
                                                          Tag="{Binding}"
                                                          Click="SaveEditorTabMenuItem_OnClick" />
                                                <MenuItem Header="Save As..."
                                                          Tag="{Binding}"
                                                          Click="SaveEditorTabAsMenuItem_OnClick" />
                                                <MenuItem Header="Rename..."
                                                          Tag="{Binding}"
                                                          Click="RenameEditorTabMenuItem_OnClick" />
                                                <Separator />
                                                <MenuItem Header="Copy Path"
                                                          Tag="{Binding}"
                                                          Click="CopyEditorTabPathMenuItem_OnClick" />
                                                <MenuItem Header="Copy Relative Path"
                                                          Tag="{Binding}"
                                                          Click="CopyEditorTabRelativePathMenuItem_OnClick" />
                                                <MenuItem Header="Copy File Name"
                                                          Tag="{Binding}"
                                                          Click="CopyEditorTabNameMenuItem_OnClick" />
                                                <MenuItem Header="{Binding #RootWindow.RevealInFileManagerText}"
                                                          Tag="{Binding}"
                                                          Click="RevealEditorTabInExplorerMenuItem_OnClick" />
                                                <MenuItem Header="Open in Integrated Terminal"
                                                          Tag="{Binding}"
                                                          Click="OpenEditorTabInTerminalMenuItem_OnClick" />
                                                <MenuItem Header="Open to the Side"
                                                          Tag="{Binding}"
                                                          Click="OpenEditorTabToSideMenuItem_OnClick" />
                                                <Separator />
                                                <MenuItem Header="Close"
                                                          Tag="{Binding}"
                                                          Click="CloseEditorTabButton_OnClick" />
                                                <MenuItem Header="Close Others"
                                                          Tag="{Binding}"
                                                          Click="CloseOtherTabsButton_OnClick" />
                                                <MenuItem Header="Close Tabs to the Right"
                                                          Tag="{Binding}"
                                                          Click="CloseTabsToTheRightMenuItem_OnClick" />
                                                <MenuItem Header="Close All"
                                                          Click="CloseAllTabsButton_OnClick" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid RowDefinitions="Auto,2.5"
                                              ColumnDefinitions="*,Auto">
                                            <Button Grid.Row="0"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Classes="editortab"
                                                    Classes.active="{Binding IsSelected}"
                                                    Tag="{Binding}"
                                                    Click="OpenEditorTabButton_OnClick"
                                                    IsVisible="{Binding !IsRenaming}"
                                                    Padding="12,10,38,10">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Viewbox Width="26" Height="13" VerticalAlignment="Center" Stretch="Uniform">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                   FontFamily="JetBrains Mono,DejaVu Sans Mono,Ubuntu Mono,Noto Sans Mono,Cascadia Code,Consolas,Menlo,Monospace"
                                                                   Width="34"
                                                                   Height="14"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Icon}"
                                                                   Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                   Opacity="{x:Static kodo:KodoDesignTokens.SecondaryOpacity}" />
                                                    </Viewbox>
                                                               <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               Classes="tablabel"
                                                               Classes.active="{Binding IsSelected}"
                                                               Text="{Binding DisplayName}" />
                                                    <Border Background="{Binding #RootWindow.ButtonBrush}"
                                                            BorderBrush="{Binding #RootWindow.DangerBrush}"
                                                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                                            CornerRadius="{x:Static kodo:KodoDesignTokens.CompactRadius}"
                                                            Padding="4,0"
                                                            IsVisible="{Binding HasErrorDiagnostics}"
                                                            ToolTip.Tip="{Binding DiagnosticsTooltip}">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.CaptionFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding #RootWindow.DangerBrush}"
                                                                   Text="{Binding ErrorCount}"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                     <Viewbox Classes="dirtydot" Width="7" Height="7" VerticalAlignment="Center"
                                                              IsVisible="{Binding IsDirty}">
                                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.AccentBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                  Source="{x:Static kodo:KodoIcons.Circle}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Row="0"
                                                    Grid.Column="1"
                                                    Classes="tabclose"
                                                    Classes.active="{Binding IsSelected}"
                                                    Tag="{Binding}"
                                                    Click="CloseEditorTabButton_OnClick"
                                                    Margin="0,0,7,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Close this tab"
                                                    ToolTip.Tip="Close this tab">
                                                <Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                        <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.PrimaryTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                              Source="{x:Static kodo:KodoIcons.XMark}" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <TextBox Grid.Row="0"
                                                     Grid.Column="0"
                                                     FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                     IsVisible="{Binding IsRenaming}"
                                                     Text="{Binding RenameText, Mode=TwoWay}"
                                                     KeyDown="InlineTabRenameTextBox_OnKeyDown"
                                                     LostFocus="InlineTabRenameTextBox_OnLostFocus"
                                                     MinWidth="150"
                                                     Margin="12,0,0,0"
                                                     Padding="4,1"
                                                     VerticalAlignment="Center"
                                                     VerticalContentAlignment="Center" />
                                            <Border Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Classes="tabunderline tabunderlinebase"
                                                    Background="{Binding #RootWindow.AccentBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="2"
                      x:Name="EditorWorkspaceGrid"
                      ColumnDefinitions="*,5,0"
                      Background="{Binding EditorBackgroundBrush}"
                      IsVisible="{Binding IsDocumentViewVisible}">
                    <Grid x:Name="PrimaryEditorPane" Grid.Column="0" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto" MinWidth="180" Background="{Binding EditorBackgroundBrush}">
                        <ScrollViewer Grid.Row="0" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="{Binding TopBarBrush}" IsVisible="{Binding IsSplitScreenVisible}">
                            <ItemsControl ItemsSource="{Binding PrimaryPaneTabs}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="kodoModels:EditorTab" x:CompileBindings="True">
                                    <Border Classes="tabwrap"
                                            Classes.active="{Binding IsPrimaryPaneSelected}">
                                        <Border.ContextMenu>
                                            <ContextMenu Opening="EditorTabContextMenu_OnOpening">
                                                <MenuItem Header="Save"
                                                          Tag="{Binding}"
                                                          Click="SaveEditorTabMenuItem_OnClick" />
                                                <MenuItem Header="Save As..."
                                                          Tag="{Binding}"
                                                          Click="SaveEditorTabAsMenuItem_OnClick" />
                                                <MenuItem Header="Rename..."
                                                          Tag="{Binding}"
                                                          Click="RenameEditorTabMenuItem_OnClick" />
                                                <Separator />
                                                <MenuItem Header="Copy Path"
                                                          Tag="{Binding}"
                                                          Click="CopyEditorTabPathMenuItem_OnClick" />
                                                <MenuItem Header="Copy Relative Path"
                                                          Tag="{Binding}"
                                                          Click="CopyEditorTabRelativePathMenuItem_OnClick" />
                                                <MenuItem Header="Copy File Name"
                                                          Tag="{Binding}"
                                                          Click="CopyEditorTabNameMenuItem_OnClick" />
                                                <MenuItem Header="{Binding #RootWindow.RevealInFileManagerText}"
                                                          Tag="{Binding}"
                                                          Click="RevealEditorTabInExplorerMenuItem_OnClick" />
                                                <MenuItem Header="Open in Integrated Terminal"
                                                          Tag="{Binding}"
                                                          Click="OpenEditorTabInTerminalMenuItem_OnClick" />
                                                <MenuItem Header="Open to the Side"
                                                          Tag="{Binding}"
                                                          Click="OpenPrimaryEditorTabToSideMenuItem_OnClick" />
                                                <Separator />
                                                <MenuItem Header="Close"
                                                          Tag="{Binding}"
                                                          Click="ClosePaneTabMenuItem_OnClick" />
                                                <MenuItem Header="Close Others"
                                                          Tag="{Binding}"
                                                          Click="CloseOtherPaneTabsMenuItem_OnClick" />
                                                <MenuItem Header="Close Tabs to the Right"
                                                          Tag="{Binding}"
                                                          Click="ClosePaneTabsToRightMenuItem_OnClick" />
                                                <MenuItem Header="Close All"
                                                          Click="CloseAllPaneTabsMenuItem_OnClick" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid RowDefinitions="Auto,2.5"
                                              ColumnDefinitions="*,Auto">
                                            <Button Grid.Row="0"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Classes="editortab"
                                                    Classes.active="{Binding IsPrimaryPaneSelected}"
                                                    Tag="{Binding}"
                                                    Click="OpenPrimaryPaneTab_OnClick"
                                                    IsVisible="{Binding !IsRenamingInPrimaryPane}"
                                                    Padding="12,10,38,10">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Viewbox Width="26" Height="13" VerticalAlignment="Center" Stretch="Uniform">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                   FontFamily="JetBrains Mono,DejaVu Sans Mono,Ubuntu Mono,Noto Sans Mono,Cascadia Code,Consolas,Menlo,Monospace"
                                                                   Width="34"
                                                                   Height="14"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Icon}"
                                                                   Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                   Opacity="{x:Static kodo:KodoDesignTokens.SecondaryOpacity}" />
                                                    </Viewbox>
                                                               <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               Classes="tablabel"
                                                               Classes.active="{Binding IsPrimaryPaneSelected}"
                                                               Text="{Binding DisplayName}" />
                                                    <Border Background="{Binding #RootWindow.ButtonBrush}"
                                                            BorderBrush="{Binding #RootWindow.DangerBrush}"
                                                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                                            CornerRadius="{x:Static kodo:KodoDesignTokens.CompactRadius}"
                                                            Padding="4,0"
                                                            IsVisible="{Binding HasErrorDiagnostics}"
                                                            ToolTip.Tip="{Binding DiagnosticsTooltip}">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.CaptionFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding #RootWindow.DangerBrush}"
                                                                   Text="{Binding ErrorCount}"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                     <Viewbox Classes="dirtydot" Width="7" Height="7" VerticalAlignment="Center"
                                                              IsVisible="{Binding IsDirty}">
                                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.AccentBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                  Source="{x:Static kodo:KodoIcons.Circle}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Row="0"
                                                    Grid.Column="1"
                                                    Classes="tabclose"
                                                    Classes.active="{Binding IsPrimaryPaneSelected}"
                                                    Tag="{Binding}"
                                                    Click="ClosePaneTabButton_OnClick"
                                                    Margin="0,0,7,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Close this tab"
                                                    ToolTip.Tip="Close this tab">
                                                <Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                        <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.PrimaryTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                              Source="{x:Static kodo:KodoIcons.XMark}" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <TextBox Grid.Row="0"
                                                     Grid.Column="0"
                                                     FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                     IsVisible="{Binding IsRenamingInPrimaryPane}"
                                                     Text="{Binding RenameText, Mode=TwoWay}"
                                                     KeyDown="InlineTabRenameTextBox_OnKeyDown"
                                                     LostFocus="InlineTabRenameTextBox_OnLostFocus"
                                                     MinWidth="150"
                                                     Margin="12,0,0,0"
                                                     Padding="4,1"
                                                     VerticalAlignment="Center"
                                                     VerticalContentAlignment="Center" />
                                            <Border Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Classes="tabunderline tabunderlinebase"
                                                    Background="{Binding #RootWindow.AccentBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{Binding TopBarBrush}" BorderBrush="{Binding SurfaceBorderBrush}" BorderThickness="{x:Static kodo:KodoDesignTokens.BorderBottomHairline}" Padding="12,6">
                            <TextBlock Text="{Binding PrimaryPaneBreadcrumbText}" FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding MutedTextBrush}" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsStatusBarFilePathVisible}" />
                        </Border>
                    <avaloniaEdit:TextEditor Grid.Column="0"
                                                   Grid.Row="2"
                                                   x:Name="PrimaryEditorTextBox"
                                             Background="{Binding EditorBackgroundBrush}"
                                             Foreground="{Binding PrimaryTextBrush}"
                                             FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                             Padding="8,12,18,36"
                                             KeyboardNavigation.TabNavigation="None"
                                             ShowLineNumbers="True"
                                             WordWrap="{Binding IsWordWrapEnabled}"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             IsVisible="{Binding IsPrimaryPaneTextEditorVisible}">
                        <avaloniaEdit:TextEditor.ContextMenu>
                            <ContextMenu Opening="EditorContextMenu_Opening">
                                <MenuItem Name="EditorCutMenuItem"
                                           Header="Cut"
                                           Click="EditorCutMenuItem_OnClick" />
                                <MenuItem Name="EditorCopyMenuItem"
                                           Header="Copy"
                                           Click="EditorCopyMenuItem_OnClick" />
                                <MenuItem Name="EditorPasteMenuItem"
                                           Header="Paste"
                                           Click="EditorPasteMenuItem_OnClick" />
                                <Separator />
                                <MenuItem Name="EditorFindAllOccurrencesMenuItem"
                                           Header="Find All Occurrences"
                                           Click="EditorFindAllOccurrencesMenuItem_OnClick" />
                                <MenuItem Name="EditorChangeAllOccurrencesMenuItem"
                                           Header="Change All Occurrences"
                                           Click="EditorChangeAllOccurrencesMenuItem_OnClick" />
                                <Separator />
                                <MenuItem Name="EditorGoToDefinitionMenuItem"
                                           Header="Go to Definition"
                                           Click="EditorGoToDefinitionMenuItem_OnClick" />
                                <MenuItem Name="EditorFindReferencesMenuItem"
                                           Header="Find References"
                                           Click="EditorFindReferencesMenuItem_OnClick" />
                                <MenuItem Name="EditorRenameSymbolMenuItem"
                                           Header="Rename Symbol…"
                                           ToolTip.Tip="Rename this symbol using the language server"
                                           Click="EditorRenameSymbolMenuItem_OnClick" />
                                <MenuItem Name="EditorTypeDefinitionMenuItem"
                                           Header="Go to Type Definition"
                                           ToolTip.Tip="Ask the language server for the symbol's type definition"
                                           Click="EditorTypeDefinitionMenuItem_OnClick" />
                                <MenuItem Name="EditorImplementationMenuItem"
                                           Header="Go to Implementation"
                                           ToolTip.Tip="Ask the language server for an implementation"
                                           Click="EditorImplementationMenuItem_OnClick" />
                                <MenuItem Name="EditorDocumentSymbolsMenuItem"
                                           Header="Show Document Symbols"
                                           ToolTip.Tip="List symbols reported by the language server"
                                           Click="EditorDocumentSymbolsMenuItem_OnClick" />
                                <MenuItem Name="EditorSignatureHelpMenuItem"
                                           Header="Signature Help"
                                           ToolTip.Tip="Show parameter and documentation help at the caret"
                                           Click="EditorSignatureHelpMenuItem_OnClick" />
                                <MenuItem Name="EditorFormatDocumentMenuItem"
                                           Header="Format Document"
                                           Click="EditorFormatDocumentMenuItem_OnClick" />
                                <MenuItem Name="EditorQuickFixMenuItem"
                                           Header="Quick Fix…"
                                           ToolTip.Tip="Find an applicable LSP or language-rule fix at the caret"
                                           Click="EditorQuickFixMenuItem_OnClick" />
                                <Separator />
                                <MenuItem Name="EditorDismissDiagnosticMenuItem"
                                           Header="Dismiss Diagnostic"
                                           Click="EditorDismissDiagnosticMenuItem_OnClick" />
                            </ContextMenu>
                        </avaloniaEdit:TextEditor.ContextMenu>
                    </avaloniaEdit:TextEditor>
                    <Grid Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsPrimaryPaneTextEditorVisible}">
                        <Border Width="96"
                                Background="{Binding EditorBackgroundBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderLeftHairline}"
                                IsVisible="{Binding IsPrimaryPaneMinimapVisible}"
                                ToolTip.Tip="Editor minimap. Click or drag to navigate.">
                            <kodoRenderers:EditorMinimapControl x:Name="EditorMinimapView" />
                        </Border>
                    </Grid>
                    <Popup x:Name="DiagnosticPopup"
                            Placement="AnchorAndGravity"
                            PlacementAnchor="TopLeft"
                            PlacementGravity="BottomRight"
                            HorizontalOffset="0"
                            VerticalOffset="0"
                            IsLightDismissEnabled="False"
                            WindowManagerAddShadowHint="False">
                        <Border x:Name="DiagnosticPopupHitBorder"
                                Background="Transparent"
                                Padding="12"
                                PointerEntered="DiagnosticPopup_OnPointerEntered"
                                PointerExited="DiagnosticPopup_OnPointerExited">
                            <Border x:Name="DiagnosticPopupBorder"
                                    Background="{Binding CardBrush}"
                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                    Padding="16"
                                    MaxWidth="460"
                                    MaxHeight="260">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Classes="accentleading" Height="14" Background="{Binding AccentBrush}" VerticalAlignment="Center"/>
                                <SelectableTextBlock x:Name="DiagnosticPopupText"
                                            Grid.Column="1"
                                            Foreground="{Binding PrimaryTextBrush}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center"
                                            FontFamily="JetBrains Mono,DejaVu Sans Mono,Ubuntu Mono,Noto Sans Mono,Cascadia Code,Consolas,Menlo,monospace" />
                                <Button Grid.Column="2"
                                        Content="✕"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Classes="chrome"
                                        Click="DiagnosticPopupDismiss_OnClick"
                                        ToolTip.Tip="Dismiss this diagnostic (never show again)"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Dismiss this diagnostic (never show again)"
                                        HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                        </Border>
                    </Popup>
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding IsPrimaryPaneImagePreviewVisible}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          RowDefinitions="*,Auto">

                        <ScrollViewer x:Name="ImageScrollViewer"
                                      Grid.Row="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Image Source="{Binding PrimaryPaneImagePreview}"
                                   Width="{Binding PrimaryPaneImageZoomedWidth}"
                                   Height="{Binding PrimaryPaneImageZoomedHeight}"
                                   Stretch="Fill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="24" />
                        </ScrollViewer>

                        <Border Grid.Row="1"
                                Background="{Binding TopBarBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderTopHairline}"
                                Padding="{x:Static kodo:KodoDesignTokens.MediumPadding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="4">
                                <Button Classes="chrome"
                                        Width="30" Height="28"
                                        FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTip.Tip="{Binding ZoomOutTooltip}"
                                        AutomationProperties.Name="{Binding ZoomOutTooltip}"
                                        Click="ZoomOutButton_OnClick">
                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding PrimaryTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                  Source="{x:Static kodo:KodoIcons.Minus}" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button Classes="chrome"
                                        MinWidth="56" Height="28"
                                        Padding="{x:Static kodo:KodoDesignTokens.LeanPadding}"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTip.Tip="{Binding ZoomResetTooltip}"
                                        AutomationProperties.Name="{Binding ZoomResetTooltip}"
                                        Click="ZoomResetButton_OnClick">
                                    <TextBlock Text="{Binding PrimaryPaneImageZoomPercent}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               Foreground="{Binding AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Button>
                                <Button Classes="chrome"
                                        Width="30" Height="28"
                                        FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTip.Tip="{Binding ZoomInTooltip}"
                                        AutomationProperties.Name="{Binding ZoomInTooltip}"
                                        Click="ZoomInButton_OnClick">
                                    <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding PrimaryTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                  Source="{x:Static kodo:KodoIcons.Plus}" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding IsPrimaryPaneCorruptedFileViewVisible}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="16">
                            <Viewbox Width="{x:Static kodo:KodoDesignTokens.IconWellSize}" Height="{x:Static kodo:KodoDesignTokens.IconWellSize}" HorizontalAlignment="Center" Opacity="{x:Static kodo:KodoDesignTokens.FaintOpacity}">
                                <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                    <svg:Svg Width="24" Height="24" CurrentColor="{Binding MutedTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                          Source="{x:Static kodo:KodoIcons.ExclamationTriangle}" />
                                </Canvas>
                            </Viewbox>
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SectionFontSize}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding MutedTextBrush}"
                                           Opacity="{x:Static kodo:KodoDesignTokens.MutedForegroundOpacity}"
                                           Text="This file is corrupted or unsupported" />
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding MutedTextBrush}"
                                           Opacity="{x:Static kodo:KodoDesignTokens.FaintOpacity}"
                                           Text="The file appears to be binary and cannot be displayed as text." />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    </Grid>
                    <GridSplitter x:Name="EditorPaneSplitter"
                                  Grid.Column="1"
                                  ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext"
                                  HorizontalAlignment="Stretch"
                                  Background="{Binding SurfaceBorderBrush}"
                                  IsVisible="{Binding IsSplitScreenVisible}" />
                    <Grid Grid.Column="2"
                          x:Name="SecondaryEditorPane"
                          Background="{Binding EditorBackgroundBrush}"
                          MinWidth="180"
                          RowDefinitions="Auto,Auto,*"
                          IsVisible="{Binding IsSplitScreenVisible}">
                        <Grid Grid.Row="0" Background="{Binding TopBarBrush}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SecondaryPaneTabs}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="kodoModels:EditorTab" x:CompileBindings="True">
                                    <Border Classes="tabwrap"
                                            Classes.active="{Binding IsSecondaryPaneSelected}">
                                        <Border.ContextMenu>
                                            <ContextMenu Opening="EditorTabContextMenu_OnOpening">
                                                <MenuItem Header="Save"
                                                          Tag="{Binding}"
                                                          Click="SaveEditorTabMenuItem_OnClick" />
                                                <MenuItem Header="Save As..."
                                                          Tag="{Binding}"
                                                          Click="SaveEditorTabAsMenuItem_OnClick" />
                                                <MenuItem Header="Rename..."
                                                          Tag="{Binding}"
                                                          Click="RenameEditorTabMenuItem_OnClick" />
                                                <Separator />
                                                <MenuItem Header="Copy Path"
                                                          Tag="{Binding}"
                                                          Click="CopyEditorTabPathMenuItem_OnClick" />
                                                <MenuItem Header="Copy Relative Path"
                                                          Tag="{Binding}"
                                                          Click="CopyEditorTabRelativePathMenuItem_OnClick" />
                                                <MenuItem Header="Copy File Name"
                                                          Tag="{Binding}"
                                                          Click="CopyEditorTabNameMenuItem_OnClick" />
                                                <MenuItem Header="{Binding #RootWindow.RevealInFileManagerText}"
                                                          Tag="{Binding}"
                                                          Click="RevealEditorTabInExplorerMenuItem_OnClick" />
                                                <MenuItem Header="Open in Integrated Terminal"
                                                          Tag="{Binding}"
                                                          Click="OpenEditorTabInTerminalMenuItem_OnClick" />
                                                <MenuItem Header="Open to the Side"
                                                          Tag="{Binding}"
                                                          Click="OpenSecondaryEditorTabToSideMenuItem_OnClick" />
                                                <Separator />
                                                <MenuItem Header="Close"
                                                          Tag="{Binding}"
                                                          Click="ClosePaneTabMenuItem_OnClick" />
                                                <MenuItem Header="Close Others"
                                                          Tag="{Binding}"
                                                          Click="CloseOtherPaneTabsMenuItem_OnClick" />
                                                <MenuItem Header="Close Tabs to the Right"
                                                          Tag="{Binding}"
                                                          Click="ClosePaneTabsToRightMenuItem_OnClick" />
                                                <MenuItem Header="Close All"
                                                          Click="CloseAllPaneTabsMenuItem_OnClick" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid RowDefinitions="Auto,2.5"
                                              ColumnDefinitions="*,Auto">
                                            <Button Grid.Row="0"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Classes="editortab"
                                                    Classes.active="{Binding IsSecondaryPaneSelected}"
                                                    Tag="{Binding}"
                                                    Click="OpenSecondaryPaneTab_OnClick"
                                                    IsVisible="{Binding !IsRenamingInSecondaryPane}"
                                                    Padding="12,10,38,10">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Viewbox Width="26" Height="13" VerticalAlignment="Center" Stretch="Uniform">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                   FontFamily="JetBrains Mono,DejaVu Sans Mono,Ubuntu Mono,Noto Sans Mono,Cascadia Code,Consolas,Menlo,Monospace"
                                                                   Width="34"
                                                                   Height="14"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Icon}"
                                                                   Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                   Opacity="{x:Static kodo:KodoDesignTokens.SecondaryOpacity}" />
                                                    </Viewbox>
                                                               <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               Classes="tablabel"
                                                               Classes.active="{Binding IsSecondaryPaneSelected}"
                                                               Text="{Binding DisplayName}" />
                                                    <Border Background="{Binding #RootWindow.ButtonBrush}"
                                                            BorderBrush="{Binding #RootWindow.DangerBrush}"
                                                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                                            CornerRadius="{x:Static kodo:KodoDesignTokens.CompactRadius}"
                                                            Padding="4,0"
                                                            IsVisible="{Binding HasErrorDiagnostics}"
                                                            ToolTip.Tip="{Binding DiagnosticsTooltip}">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.CaptionFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding #RootWindow.DangerBrush}"
                                                                   Text="{Binding ErrorCount}"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                     <Viewbox Classes="dirtydot" Width="7" Height="7" VerticalAlignment="Center"
                                                              IsVisible="{Binding IsDirty}">
                                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.AccentBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                  Source="{x:Static kodo:KodoIcons.Circle}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Row="0"
                                                    Grid.Column="1"
                                                    Classes="tabclose"
                                                    Classes.active="{Binding IsSecondaryPaneSelected}"
                                                    Tag="{Binding}"
                                                    Click="ClosePaneTabButton_OnClick"
                                                    Margin="0,0,7,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Close this tab"
                                                    ToolTip.Tip="Close this tab">
                                                <Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                        <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.PrimaryTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                              Source="{x:Static kodo:KodoIcons.XMark}" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <TextBox Grid.Row="0"
                                                     Grid.Column="0"
                                                     FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                     IsVisible="{Binding IsRenamingInSecondaryPane}"
                                                     Text="{Binding RenameText, Mode=TwoWay}"
                                                     KeyDown="InlineTabRenameTextBox_OnKeyDown"
                                                     LostFocus="InlineTabRenameTextBox_OnLostFocus"
                                                     MinWidth="150"
                                                     Margin="12,0,0,0"
                                                     Padding="4,1"
                                                     VerticalAlignment="Center"
                                                     VerticalContentAlignment="Center" />
                                            <Border Grid.Row="1"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Classes="tabunderline tabunderlinebase"
                                                    Background="{Binding #RootWindow.AccentBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <Border Grid.Row="1" Background="{Binding TopBarBrush}" BorderBrush="{Binding SurfaceBorderBrush}" BorderThickness="{x:Static kodo:KodoDesignTokens.BorderBottomHairline}" Padding="12,6">
                            <TextBlock Text="{Binding SecondaryPaneBreadcrumbText}" FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding MutedTextBrush}" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsStatusBarFilePathVisible}" />
                        </Border>
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Background="{Binding EditorBackgroundBrush}">
                        <avaloniaEdit:TextEditor Grid.Column="0"
                                                 x:Name="SecondaryEditorTextBox"
                                                 Background="{Binding EditorBackgroundBrush}"
                                                 Foreground="{Binding PrimaryTextBrush}"
                                                 FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                                 Padding="8,12,18,36"
                                                 KeyboardNavigation.TabNavigation="None"
                                                 ShowLineNumbers="True"
                                                 WordWrap="{Binding IsWordWrapEnabled}"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto"
                                                 IsVisible="{Binding IsSecondaryPaneTextEditorVisible}">
                            <avaloniaEdit:TextEditor.ContextMenu>
                                <ContextMenu Opening="EditorContextMenu_Opening">
                                    <MenuItem Name="SecondaryEditorCutMenuItem" Header="Cut" Click="EditorCutMenuItem_OnClick" />
                                    <MenuItem Name="SecondaryEditorCopyMenuItem" Header="Copy" Click="EditorCopyMenuItem_OnClick" />
                                    <MenuItem Name="SecondaryEditorPasteMenuItem" Header="Paste" Click="EditorPasteMenuItem_OnClick" />
                                    <Separator />
                                    <MenuItem Name="SecondaryEditorFindAllOccurrencesMenuItem" Header="Find All Occurrences" Click="EditorFindAllOccurrencesMenuItem_OnClick" />
                                    <MenuItem Name="SecondaryEditorChangeAllOccurrencesMenuItem" Header="Change All Occurrences" Click="EditorChangeAllOccurrencesMenuItem_OnClick" />
                                    <Separator />
                                    <MenuItem Name="SecondaryEditorGoToDefinitionMenuItem" Header="Go to Definition" Click="EditorGoToDefinitionMenuItem_OnClick" />
                                    <MenuItem Name="SecondaryEditorFindReferencesMenuItem" Header="Find References" Click="EditorFindReferencesMenuItem_OnClick" />
                                    <MenuItem Name="SecondaryEditorRenameSymbolMenuItem" Header="Rename Symbol…" ToolTip.Tip="Rename this symbol using the language server" Click="EditorRenameSymbolMenuItem_OnClick" />
                                    <MenuItem Name="SecondaryEditorTypeDefinitionMenuItem" Header="Go to Type Definition" ToolTip.Tip="Ask the language server for the symbol's type definition" Click="EditorTypeDefinitionMenuItem_OnClick" />
                                    <MenuItem Name="SecondaryEditorImplementationMenuItem" Header="Go to Implementation" ToolTip.Tip="Ask the language server for an implementation" Click="EditorImplementationMenuItem_OnClick" />
                                    <MenuItem Name="SecondaryEditorDocumentSymbolsMenuItem" Header="Show Document Symbols" ToolTip.Tip="List symbols reported by the language server" Click="EditorDocumentSymbolsMenuItem_OnClick" />
                                    <MenuItem Name="SecondaryEditorSignatureHelpMenuItem" Header="Signature Help" ToolTip.Tip="Show parameter and documentation help at the caret" Click="EditorSignatureHelpMenuItem_OnClick" />
                                    <MenuItem Name="SecondaryEditorFormatDocumentMenuItem" Header="Format Document" Click="EditorFormatDocumentMenuItem_OnClick" />
                                    <MenuItem Name="SecondaryEditorQuickFixMenuItem" Header="Quick Fix…" ToolTip.Tip="Find an applicable LSP or language-rule fix at the caret" Click="EditorQuickFixMenuItem_OnClick" />
                                    <Separator />
                                    <MenuItem Name="SecondaryEditorDismissDiagnosticMenuItem" Header="Dismiss Diagnostic" Click="EditorDismissDiagnosticMenuItem_OnClick" />
                                </ContextMenu>
                            </avaloniaEdit:TextEditor.ContextMenu>
                        </avaloniaEdit:TextEditor>
                        <Border Grid.Column="1"
                                Width="96"
                                Background="{Binding EditorBackgroundBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderLeftHairline}"
                                IsVisible="{Binding IsSecondaryPaneMinimapVisible}"
                                ToolTip.Tip="Editor minimap. Click or drag to navigate.">
                            <kodoRenderers:EditorMinimapControl x:Name="SecondaryEditorMinimapView" />
                        </Border>
                        <Grid Grid.ColumnSpan="2"
                              IsVisible="{Binding IsSecondaryPaneImagePreviewVisible}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              RowDefinitions="*,Auto"
                              Background="{Binding EditorBackgroundBrush}">
                            <ScrollViewer x:Name="SecondaryImageScrollViewer"
                                          Grid.Row="0"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Image Source="{Binding SecondaryPaneImagePreview}"
                                       Width="{Binding SecondaryPaneImageZoomedWidth}"
                                       Height="{Binding SecondaryPaneImageZoomedHeight}"
                                       Stretch="Fill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="24" />
                            </ScrollViewer>
                            <Border Grid.Row="1"
                                    Background="{Binding TopBarBrush}"
                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderTopHairline}"
                                    Padding="{x:Static kodo:KodoDesignTokens.MediumPadding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                    <Button Classes="chrome"
                                            Width="30" Height="28"
                                            FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ToolTip.Tip="{Binding ZoomOutTooltip}"
                                            AutomationProperties.Name="{Binding ZoomOutTooltip}"
                                            Click="ZoomOutButton_OnClick">
                                        <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                <svg:Svg Width="24" Height="24" CurrentColor="{Binding PrimaryTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                      Source="{x:Static kodo:KodoIcons.Minus}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                    <Button Classes="chrome"
                                            MinWidth="56" Height="28"
                                            Padding="{x:Static kodo:KodoDesignTokens.LeanPadding}"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ToolTip.Tip="{Binding ZoomResetTooltip}"
                                            AutomationProperties.Name="{Binding ZoomResetTooltip}"
                                            Click="ZoomResetButton_OnClick">
                                        <TextBlock Text="{Binding SecondaryPaneImageZoomPercent}"
                                                   FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                   Foreground="{Binding AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                    <Button Classes="chrome"
                                            Width="30" Height="28"
                                            FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ToolTip.Tip="{Binding ZoomInTooltip}"
                                            AutomationProperties.Name="{Binding ZoomInTooltip}"
                                            Click="ZoomInButton_OnClick">
                                        <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                <svg:Svg Width="24" Height="24" CurrentColor="{Binding PrimaryTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                      Source="{x:Static kodo:KodoIcons.Plus}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.ColumnSpan="2"
                              IsVisible="{Binding IsSecondaryPaneCorruptedFileViewVisible}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{Binding EditorBackgroundBrush}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                <Viewbox Width="{x:Static kodo:KodoDesignTokens.IconWellSize}" Height="{x:Static kodo:KodoDesignTokens.IconWellSize}" HorizontalAlignment="Center" Opacity="{x:Static kodo:KodoDesignTokens.FaintOpacity}">
                                    <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                        <svg:Svg Width="24" Height="24" CurrentColor="{Binding MutedTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                              Source="{x:Static kodo:KodoIcons.ExclamationTriangle}" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SectionFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{Binding MutedTextBrush}"
                                               Opacity="{x:Static kodo:KodoDesignTokens.MutedForegroundOpacity}"
                                               Text="This file is corrupted or unsupported" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" HorizontalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{Binding MutedTextBrush}"
                                               Opacity="{x:Static kodo:KodoDesignTokens.FaintOpacity}"
                                               Text="The file appears to be binary and cannot be displayed as text." />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        </Grid>
                    </Grid>
                    <Border x:Name="TabDropIndicator"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            IsHitTestVisible="False"
                            IsVisible="False"
                            Background="{Binding AccentBrush}"
                            Opacity="{x:Static kodo:KodoDesignTokens.StripeOpacity}"
                            BorderBrush="{Binding AccentBrush}"
                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThick}" />
                </Grid>
                <Border Grid.Row="2"
                        Background="{Binding EditorBackgroundBrush}"
                        IsVisible="{Binding IsEmptyStateVisible}">
                    <Grid RowDefinitions="Auto,*">

                        <Border Grid.Row="0"
                                Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                Margin="32,24,32,12"
                                Padding="0"
                                ClipToBounds="True">
                            <Panel>

                                <Border Background="{Binding AccentBrush}"
                                        Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}"
                                        CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                        IsHitTestVisible="False" />

                                <Grid ColumnDefinitions="*,Auto"
                                      Margin="24,20"
                                      VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Classes="accentleading" Height="14"
                                                    Background="{Binding AccentBrush}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                       FontWeight="SemiBold"
                                                       LetterSpacing="0.8"
                                                       Foreground="{Binding AccentBrush}"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding KodoWordmarkText}" />
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding IsKodoBirthday}"
                                                       ToolTip.Tip="{Binding StatusBarBirthdayText}"
                                                       Text="🎂" />
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                                     HorizontalAlignment="Left"
                                                     IsVisible="{Binding !IsTaglineGreeting}">
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.DisplayFontSize}"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding PrimaryTextBrush}"
                                                           Text="{Binding WelcomeMessage}" />
                                            </Viewbox>

                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                                     HorizontalAlignment="Left"
                                                     IsVisible="{Binding IsTaglineGreeting}">
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.DisplayFontSize}"
                                                           FontWeight="Bold"
                                                           xml:space="preserve"><Run Foreground="{Binding PrimaryTextBrush}" Text="{Binding TaglinePrefixText}" /><Run Foreground="{Binding AccentBrush}" Text="{Binding TaglineAccentText}" /></TextBlock>
                                            </Viewbox>

                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="{Binding WindowBackgroundBrush}"
                                            BorderBrush="{Binding AccentBrush}"
                                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                            CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                            Padding="12,6"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0">
                                        <TextBlock x:Name="HomeVersionText"
                                                   FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   PointerPressed="HomeVersionText_OnPointerPressed"
                                                   Text="{Binding CurrentAppVersionDisplay}" />
                                    </Border>
                                </Grid>
                            </Panel>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,28,32,36" Spacing="16">

                            <Border Padding="18,16"
                                    Background="{Binding CardBrush}"
                                    BorderBrush="{Binding AccentBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                    IsVisible="{Binding HasMostRecentFileItem}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0"
                                            Classes="accentleading"
                                            Height="30"
                                            Background="{Binding AccentBrush}"
                                            VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding AccentBrush}"
                                                   Text="CONTINUE" />
                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding MostRecentFileItem.DisplayName}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Classes="chrome"
                                            Tag="{Binding MostRecentFileItem}"
                                            Click="RecentFileButton_OnClick"
                                            VerticalAlignment="Center"
                                            Padding="{x:Static kodo:KodoDesignTokens.ButtonPadding}"
                                            Content="Resume" />
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding PinnedRecentFiles}"
                                          IsVisible="{Binding HasPinnedRecentFiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="kodoModels:RecentFileItem" x:CompileBindings="True">

                                        <Button Tag="{Binding}"
                                                Click="RecentFileButton_OnClick"
                                                Background="{Binding #RootWindow.ButtonBrush}"
                                                Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                                CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                Margin="0,0,8,8"
                                                Padding="12,7"
                                                Content="{Binding DisplayName}"
                                                AutomationProperties.Name="{Binding Path}"
ToolTip.Tip="{Binding Path}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        <Grid ColumnDefinitions="*,340"
                              ColumnSpacing="20">

                                <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Top">

                                    <Border Padding="24"
                                            Background="{Binding CardBrush}"
                                            BorderBrush="{Binding SurfaceBorderBrush}"
                                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                            CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}">
                                        <StackPanel Spacing="14">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding PrimaryTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Text="Get Started" />
                                            </StackPanel>
                                            <TextBlock Foreground="{Binding MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                       LineHeight="20"
                                                       Text="{Binding GetStartedSubtitleText}" />

                                            <Button Classes="chrome"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="12,9"
                                                    Click="HomeQuickSearchButton_OnClick"
                                                    AutomationProperties.Name="{Binding HomeQuickSearchPlaceholderText}"
                                                    ToolTip.Tip="{Binding HomeQuickSearchPlaceholderText}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Viewbox Width="13" Height="13">
                                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding AccentBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                  Opacity="{x:Static kodo:KodoDesignTokens.SubduedSecondaryOpacity}"
                                                                  Source="{x:Static kodo:KodoIcons.Magnifier}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding HomeQuickSearchPlaceholderText}"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               Foreground="{Binding PrimaryTextBrush}"
                                                               Opacity="{x:Static kodo:KodoDesignTokens.SelectedOpacity}" />
                                                </StackPanel>
                                            </Button>

                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                                                <Button Grid.Column="0"
                                                        Classes="chrome"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        MinHeight="72"
                                                        Padding="14,14"
                                                        Click="NewFileButton_OnClick"
                                                        AutomationProperties.Name="{Binding NewFileTooltip}"
                                                        ToolTip.Tip="{Binding NewFileTooltip}">
                                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                                            <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                                <svg:Svg Width="24" Height="24" CurrentColor="{Binding AccentBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                      Source="{x:Static kodo:KodoIcons.PagePlus}" />
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="New File" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Grid.Column="1"
                                                        Classes="chrome"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        MinHeight="72"
                                                        Padding="14,14"
                                                        Click="OpenFileButton_OnClick"
                                                        AutomationProperties.Name="{Binding OpenFileTooltip}"
                                                        ToolTip.Tip="{Binding OpenFileTooltip}">
                                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                                            <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                                <svg:Svg Width="24" Height="24" CurrentColor="{Binding AccentBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                      Source="{x:Static kodo:KodoIcons.ArrowDownTray}" />
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="Open File" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Grid.Column="2"
                                                        Classes="chrome"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        MinHeight="72"
                                                        Padding="14,14"
                                                        Click="OpenFolderButton_OnClick"
                                                        AutomationProperties.Name="{Binding OpenFolderTooltip}"
                                                        ToolTip.Tip="{Binding OpenFolderTooltip}">
                                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                                            <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                                <svg:Svg Width="24" Height="24" CurrentColor="{Binding AccentBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                      Source="{x:Static kodo:KodoIcons.FolderPlus}" />
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="Open Folder" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="20"
                                            MinHeight="380"
                                            Background="{Binding CardBrush}"
                                            BorderBrush="{Binding SurfaceBorderBrush}"
                                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                            CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}">
                                        <Grid RowDefinitions="Auto,*">

                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                                <StackPanel Grid.Column="0"
                                                            Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding PrimaryTextBrush}"
                                                               VerticalAlignment="Center"
                                                               Text="Recent" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Classes="chrome"
                                                        Click="ClearRecentFilesButton_OnClick"
                                                        IsVisible="{Binding HasRecentFiles}"
                                                        VerticalAlignment="Center"
                                                        FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                        Padding="{x:Static kodo:KodoDesignTokens.TightPadding}"
                                                        ToolTip.Tip="Clear the list of recently opened files"
                                                        AutomationProperties.Name="Clear the list of recently opened files"
                                                        Content="Clear" />
                                            </Grid>

                                            <StackPanel Grid.Row="1"
                                                        IsVisible="{Binding !HasRecentFiles}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="8">
                                                <Viewbox Width="{x:Static kodo:KodoDesignTokens.EmptyStateIconSize}" Height="{x:Static kodo:KodoDesignTokens.EmptyStateIconSize}" HorizontalAlignment="Center" Opacity="{x:Static kodo:KodoDesignTokens.FaintOpacity}">
                                                    <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                        <svg:Svg Width="24" Height="24" CurrentColor="{Binding MutedTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                              Source="{x:Static kodo:KodoIcons.Archive}" />
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{Binding MutedTextBrush}"
                                                           Opacity="{x:Static kodo:KodoDesignTokens.DividerOpacity}"
                                                           Text="No recently opened files" />
                                            </StackPanel>

                                            <ItemsControl Grid.Row="1"
                                                          ItemsSource="{Binding RecentFiles}"
                                                          IsVisible="{Binding HasRecentFiles}"
                                                          VerticalAlignment="Top">
                                                <ItemsControl.ItemContainerTheme>
                                                    <ControlTheme TargetType="ContentPresenter">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    </ControlTheme>
                                                </ItemsControl.ItemContainerTheme>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="kodoModels:RecentFileItem" x:CompileBindings="True">
                                                        <Button Classes="recent"
                                                                Tag="{Binding}"
                                                                Click="RecentFileButton_OnClick"
                                                                Padding="10,8"
                                                                Margin="0,0,0,3"
                                                                HorizontalContentAlignment="Stretch">
                                                            <ToolTip.Tip>
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" />
                                                                    <TextBlock Text="{Binding Path}"
                                                                               Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                               FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                               Opacity="{x:Static kodo:KodoDesignTokens.StrongOpacity}" />
                                                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Opacity="{x:Static kodo:KodoDesignTokens.StrongOpacity}"
                                                                               Foreground="{Binding #RootWindow.MutedTextBrush}">
                                                                        <Run Text="Last opened " /><Run Text="{Binding LastOpenedLongText}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </ToolTip.Tip>

                                                            <Grid ColumnDefinitions="Auto,*,110,64,40" ColumnSpacing="14">

                                                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                                                    <Viewbox IsVisible="{Binding IsFolder}"
                                                                             Width="15" Height="15"
                                                                             VerticalAlignment="Center">
                                                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.MutedTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                                  Opacity="{x:Static kodo:KodoDesignTokens.SelectedOpacity}"
                                                                                  Source="{x:Static kodo:KodoIcons.Folder}" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <Viewbox IsVisible="{Binding !IsFolder}"
                                                                             Width="15" Height="15"
                                                                             VerticalAlignment="Center">
                                                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">

                                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.MutedTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                                  Opacity="{x:Static kodo:KodoDesignTokens.SelectedOpacity}"
                                                                                  Source="{x:Static kodo:KodoIcons.NewsFile}" />
                                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.MutedTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                                  Opacity="{x:Static kodo:KodoDesignTokens.SelectedOpacity}"
                                                                                  Source="{x:Static kodo:KodoIcons.Sparkle}" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                </Grid>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                               Text="{Binding DisplayName}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <Border Classes="recentbadge"
                                                                            IsVisible="{Binding IsPinned}"
                                                                            Background="{Binding #RootWindow.AccentBrush}">
                                                                        <TextBlock Text="{Binding PinnedBadgeText}"
                                                                                   Foreground="{Binding #RootWindow.AccentForegroundBrush}" />
                                                                    </Border>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="2"
                                                                           FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                           Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                           Opacity="{x:Static kodo:KodoDesignTokens.MutedForegroundOpacity}"
                                                                           Text="{Binding FileTypeName}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />

                                                                <TextBlock Grid.Column="3"
                                                                           FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                           Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                           Opacity="{x:Static kodo:KodoDesignTokens.SelectedOpacity}"
                                                                           Text="{Binding LastOpenedText}"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Right"
                                                                           TextAlignment="Right" />

                                                                <Button Grid.Column="4"
                                                                        Classes="recentpin"
                                                                        Tag="{Binding Path}"
                                                                        Click="TogglePinnedRecentFileButton_OnClick"
                                                                        ToolTip.Tip="{Binding PinTooltipText}"
                                                                        Padding="6"
                                                                        VerticalAlignment="Center"
                                                                        AutomationProperties.Name="{Binding PinTooltipText}"
                                                                        HorizontalAlignment="Center">
                                                                    <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.MutedTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                                  IsVisible="{Binding !IsPinned}"
                                                                                  Source="{x:Static kodo:KodoIcons.Pin}" />
                                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.AccentBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                                  Opacity="{x:Static kodo:KodoDesignTokens.SecondaryOpacity}"
                                                                                  IsVisible="{Binding IsPinned}"
                                                                                  Source="{x:Static kodo:KodoIcons.Pin}" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                </Button>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>

                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Spacing="16"
                                            VerticalAlignment="Top">

                                    <Border Padding="16,14"
                                            Background="{Binding CardBrush}"
                                            BorderBrush="{Binding SurfaceBorderBrush}"
                                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                            CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <Border Classes="accentleading" Height="20" Background="{Binding AccentBrush}" />
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding PrimaryTextBrush}"
                                                                       Text="Marketplace" />
                                                            <Border Width="6" Height="6"
                                                                    CornerRadius="{x:Static kodo:KodoDesignTokens.HoverRowRadius}"
                                                                    Background="#E05252"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding IsMarketplaceConnectivityWarningVisible}"
                                                                    ToolTip.Tip="{Binding MarketplaceConnectivityMessage}" />
                                                        </StackPanel>
                                                        <TextBlock Foreground="{Binding MutedTextBrush}"
                                                                   FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                   Opacity="{x:Static kodo:KodoDesignTokens.SubduedSecondaryOpacity}"
                                                                   Text="Extensions, compilers, and themes" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Classes="chrome"
                                                        Click="OpenMarketplaceButton_OnClick"
                                                        ToolTip.Tip="{Binding OpenExtensionsTooltip}"
                                                        VerticalAlignment="Center"
                                                        FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                        Padding="10,5"
                                                        AutomationProperties.Name="{Binding OpenExtensionsTooltip}"
                                                        Content="Browse" />
                                            </Grid>

                                            <Border BorderBrush="{Binding AccentBrush}" Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}" BorderThickness="{x:Static kodo:KodoDesignTokens.BorderTopHairline}" />

                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Button Classes="chrome"
                                                        Padding="8"
                                                        Click="OpenDiscordButton_OnClick"
                                                        AutomationProperties.Name="Join the Kodo Discord server"
                                                        ToolTip.Tip="Join the Kodo Discord server">
                                                    <Viewbox Width="14" Height="14">
                                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                  Source="{x:Static kodo:KodoIcons.Discord}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Classes="chrome"
                                                                                                        Padding="8"
                                                                                                        Click="OpenInstagramButton_OnClick"
                                                                                                        AutomationProperties.Name="Follow Kodo on Instagram"
                                                                                                        ToolTip.Tip="Follow Kodo on Instagram">
                                                                                                    <Viewbox Width="14" Height="14">
                                                                                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                                                                  Source="{x:Static kodo:KodoIcons.InstagramCircle}" />
                                                                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                                                                  Source="{x:Static kodo:KodoIcons.InstagramDot}" />
                                                                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                                                                  Source="{x:Static kodo:KodoIcons.InstagramSquare}" />
                                                                                                        </Canvas>
                                                                                                    </Viewbox>
                                                                                                </Button>
                                                <Button Classes="chrome"
                                                        Padding="8"
                                                        Click="OpenGitHubButton_OnClick"
                                                        AutomationProperties.Name="View Kodo IDE on GitHub"
                                                        ToolTip.Tip="View Kodo IDE on GitHub">
                                                    <Viewbox Width="14" Height="14">
                                                        <Canvas Width="20" Height="20">
                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                  Source="{x:Static kodo:KodoIcons.GitHub}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Classes="chrome"
                                                        Padding="8"
                                                        Click="OpenWebsiteButton_OnClick"
                                                        AutomationProperties.Name="Open the Kodo website"
                                                        ToolTip.Tip="Open the Kodo website">
                                                    <Viewbox Width="14" Height="14">
                                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                  Source="{x:Static kodo:KodoIcons.Globe}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Classes="chrome"
                                                        Padding="8"
                                                        Click="OpenReleasesPageButton_OnClick"
                                                        AutomationProperties.Name="View releases on GitHub"
                                                        ToolTip.Tip="View releases on GitHub">
                                                    <Viewbox Width="14" Height="14">
                                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                  Source="{x:Static kodo:KodoIcons.Tag}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>

                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{Binding CardBrush}"
                                            BorderBrush="{Binding SurfaceBorderBrush}"
                                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                            CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}">
                                        <Grid RowDefinitions="Auto,*">

                                            <Border Grid.Row="0"
                                                    BorderBrush="{Binding AccentBrush}"
                                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderBottomHairline}"
                                                    Padding="20,14">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Orientation="Horizontal" Spacing="16"
                                                                VerticalAlignment="Center">
                                                        <Grid RowDefinitions="Auto,Auto">
                                                            <Button Grid.Row="0"
                                                                    Classes="chrome"
                                                                    Click="HomeNewsTabButton_OnClick"
                                                                    Padding="0" BorderThickness="0" Background="Transparent"
                                                                    FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                                                    Foreground="{Binding PrimaryTextBrush}"
                                                                    FontWeight="{Binding IsHomeNewsTabActive, Converter={x:Static kodoModels:BoolToFontWeightConverter.Instance}}"
                                                                    Content="News" />
                                                            <Border Grid.Row="1" Classes="homeunderline"
                                                                    IsVisible="{Binding IsHomeNewsTabActive}" />
                                                        </Grid>
                                                        <Grid RowDefinitions="Auto,Auto">
                                                            <Button Grid.Row="0"
                                                                    Classes="chrome"
                                                                    Click="HomeUpdatesTabButton_OnClick"
                                                                    Padding="0" BorderThickness="0" Background="Transparent"
                                                                    FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                                                    Foreground="{Binding PrimaryTextBrush}"
                                                                    FontWeight="{Binding IsHomeUpdatesTabActive, Converter={x:Static kodoModels:BoolToFontWeightConverter.Instance}}"
                                                                    Content="What's New" />
                                                            <Border Grid.Row="1" Classes="homeunderline"
                                                                    IsVisible="{Binding IsHomeUpdatesTabActive}" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="8"
                                                                VerticalAlignment="Center">
                                                        <Button Classes="chrome"
                                                                Click="RefreshLatestReleaseButton_OnClick"
                                                                IsVisible="{Binding IsHomeUpdatesTabActive}"
                                                                IsEnabled="{Binding IsWhatsNewRefreshEnabled}"
                                                                ToolTip.Tip="Check for newer release information"
                                                                AutomationProperties.Name="Check for newer release information"
                                                                Content="↻" />
                                                        <Button Classes="chrome"
                                                                Click="OpenLatestReleaseButton_OnClick"
                                                                IsVisible="{Binding IsHomeUpdatesTabActive}"
                                                                IsEnabled="{Binding IsWhatsNewRefreshEnabled}"
                                                                ToolTip.Tip="Open this release on GitHub in your browser"
                                                                AutomationProperties.Name="Open this release on GitHub in your browser"
                                                                Content="GitHub" />
                                                        <Button Classes="chrome"
                                                                Click="RefreshNewsButton_OnClick"
                                                                IsVisible="{Binding IsHomeNewsTabActive}"
                                                                IsEnabled="{Binding IsNewsRefreshEnabled}"
                                                                ToolTip.Tip="Refresh news"
                                                                AutomationProperties.Name="Refresh news"
                                                                Content="↻" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="1"
                                                    Padding="20,14"
                                                    MaxHeight="310"
                                                    IsVisible="{Binding IsHomeUpdatesTabActive}">
                                                <Panel ClipToBounds="True">

                                                    <StackPanel IsVisible="{Binding IsWhatsNewDisabled}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Spacing="8">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{Binding AccentBrush}"
                                                                   FontWeight="SemiBold"
                                                                   LetterSpacing="1"
                                                                   Text="DISABLED" />
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{Binding MutedTextBrush}"
                                                                   Opacity="{x:Static kodo:KodoDesignTokens.MutedForegroundOpacity}"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="220"
                                                                   Text="What's New is turned off by Performance mode." />
                                                    </StackPanel>

                                                    <TextBlock IsVisible="{Binding IsLatestReleaseStatusVisible}"
                                                               Foreground="{Binding MutedTextBrush}"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               Text="{Binding LatestReleaseStatusText}" />

                                                    <Grid IsVisible="{Binding HasLatestRelease}"
                                                          RowDefinitions="Auto,*">
                                                        <StackPanel Grid.Row="0"
                                                                    Spacing="2"
                                                                    Margin="0,0,0,10">
                                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding AccentBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding LatestReleaseDisplayName}" />
                                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                       Foreground="{Binding MutedTextBrush}"
                                                                       Opacity="{x:Static kodo:KodoDesignTokens.SubduedSecondaryOpacity}"
                                                                       Text="{Binding LatestReleaseTag}" />
                                                        </StackPanel>
                                                        <ScrollViewer Grid.Row="1"
                                                                      ClipToBounds="True"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding LatestReleaseFormatted}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="kodoModels:FormattedParagraph" x:CompileBindings="True">
                                                                    <Grid Margin="{Binding TopMargin}"
                                                                          ColumnDefinitions="Auto,*">
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding Marker}"
                                                                                   Width="{Binding MarkerColumnWidth}"
                                                                                   FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                                   LineHeight="19"
                                                                                   Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                                   VerticalAlignment="Top" />
                                                                        <ItemsControl Grid.Column="1"
                                                                                      ItemsSource="{Binding Runs}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="kodoModels:FormattedRun" x:CompileBindings="True">
                                                                                    <TextBlock Text="{Binding Text}"
                                                                                               TextWrapping="Wrap"
                                                                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                                               LineHeight="19"
                                                                                               Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                                               FontWeight="{Binding IsBold, Converter={x:Static kodoModels:BoolToFontWeightConverter.Instance}}" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Panel>
                                            </Border>

                                            <Border Grid.Row="1"
                                                    Padding="16,14"
                                                    MaxHeight="420"
                                                    IsVisible="{Binding IsHomeNewsTabActive}">
                                                <Panel ClipToBounds="True">

                                                    <StackPanel IsVisible="{Binding IsNewsDisabled}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Spacing="8">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{Binding AccentBrush}"
                                                                   FontWeight="SemiBold"
                                                                   LetterSpacing="1"
                                                                   Text="DISABLED" />
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{Binding MutedTextBrush}"
                                                                   Opacity="{x:Static kodo:KodoDesignTokens.MutedForegroundOpacity}"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="220"
                                                                   Text="News &amp; Announcements are turned off by Performance mode." />
                                                    </StackPanel>

                                                    <StackPanel IsVisible="{Binding IsNewsLoading}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Spacing="8">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{Binding MutedTextBrush}"
                                                                   Opacity="{x:Static kodo:KodoDesignTokens.SelectedOpacity}"
                                                                   Text="Loading news..." />
                                                    </StackPanel>

                                                    <StackPanel IsVisible="{Binding IsNewsError}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Spacing="6">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SubheaderFontSize}"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{Binding MutedTextBrush}"
                                                                   Opacity="{x:Static kodo:KodoDesignTokens.FaintOpacity}"
                                                                   Text="&#x26A0;" />
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{Binding MutedTextBrush}"
                                                                   Opacity="{x:Static kodo:KodoDesignTokens.SelectedOpacity}"
                                                                   Text="Could not load news." />
                                                    </StackPanel>

                                                    <StackPanel IsVisible="{Binding IsNewsEmpty}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Spacing="8">
                                                        <TextBlock FontSize="26"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{Binding MutedTextBrush}"
                                                                   Opacity="{x:Static kodo:KodoDesignTokens.FaintOpacity}"
                                                                   Text="&#x1F4F0;" />
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{Binding MutedTextBrush}"
                                                                   Opacity="{x:Static kodo:KodoDesignTokens.DisabledOpacity}"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="200"
                                                                   Text="No announcements yet." />
                                                    </StackPanel>

                                                    <ScrollViewer IsVisible="{Binding IsNewsContentVisible}"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding NewsItems}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="kodoModels:NewsItem" x:CompileBindings="True">
                                                                    <Border BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderBottomHairline}"
                                                                            Padding="4,12">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                                       TextWrapping="Wrap"
                                                                                       IsVisible="{Binding HasTitle}"
                                                                                       Text="{Binding Title}" />
                                                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                                       Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                                       IsVisible="{Binding HasUpdatedAt}"
                                                                                       Opacity="{x:Static kodo:KodoDesignTokens.DividerOpacity}"
                                                                                       Text="{Binding UpdatedAt}" />
                                                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                                       Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                                       TextWrapping="Wrap"
                                                                                       LineHeight="19"
                                                                                       IsVisible="{Binding HasBody}"
                                                                                       Text="{Binding Body}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Panel>
                                            </Border>

                                        </Grid>
                                    </Border>

                                </StackPanel>

                            </Grid>
                        </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        x:Name="TerminalPanelSplitter"
                        Background="Transparent"
                        IsVisible="{Binding IsTerminalPanelVisible}"
                        Cursor="SizeNorthSouth"
                        ToolTip.Tip="Drag to resize the terminal panel"
                        PointerPressed="TerminalPanelSplitter_OnPointerPressed"
                        PointerMoved="TerminalPanelSplitter_OnPointerMoved"
                        PointerReleased="TerminalPanelSplitter_OnPointerReleased"
                        PointerCaptureLost="TerminalPanelSplitter_OnPointerCaptureLost" />

                <Border Grid.Row="4"
                        IsVisible="{Binding IsTerminalPanelVisible}"
                        Background="{Binding CardBrush}"
                        BorderBrush="{Binding SurfaceBorderBrush}"
                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                        CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                        Margin="8,4,8,8"
                        MinHeight="120"
                        MaxHeight="420"
                        ClipToBounds="True"
                        Height="{Binding TerminalPanelHeight}">
                    <Grid ColumnDefinitions="220,*,44">
                        <Border Grid.Column="0"
                                Background="{Binding SidebarBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderRightHairline}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.SidebarLeftRadius}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Close All Sessions"
                                              IsEnabled="{Binding HasTerminalSessions}"
                                              Click="CloseAllTerminalSessionsButton_OnClick" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid RowDefinitions="Auto,Auto,*">
                                <Border Grid.Row="0"
                                        Background="{Binding TopBarBrush}"
                                        BorderBrush="{Binding SurfaceBorderBrush}"
                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderBottomHairline}"
                                        CornerRadius="{x:Static kodo:KodoDesignTokens.TerminalTopRadius}"
                                        Padding="12,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="6"
                                          VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center"
                                                    MinWidth="0">
                                            <Border Classes="accentleading"
                                                    Height="16"
                                                    Background="{Binding AccentBrush}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding MutedTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Text="TERMINAL" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Classes="activity"
                                                Width="28"
                                                Height="28"
                                                Margin="0"
                                                Focusable="False"
                                                Click="NewTerminalButton_OnClick"
                                                AutomationProperties.Name="{Binding NewTerminalTooltip}"
                                                ToolTip.Tip="{Binding NewTerminalTooltip}">
                                            <Viewbox Width="14"
                                                     Height="14"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                    <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                          Source="{x:Static kodo:KodoIcons.Plus}" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                        <Button Grid.Column="3"
                                                Classes="activity"
                                                Width="28"
                                                Height="28"
                                                Margin="0"
                                                Focusable="False"
                                                Click="ClearTerminalButton_OnClick"
                                                AutomationProperties.Name="Clear terminal"
                                                ToolTip.Tip="Clear terminal"
                                                Opacity="{Binding HasActiveTerminal, Converter={x:Static kodoModels:BoolToOpacityConverter.Instance}}">
                                            <Viewbox Width="14"
                                                     Height="14"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                    <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                          Source="{x:Static kodo:KodoIcons.Trash}" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                        <Button Grid.Column="4"
                                                Classes="activity"
                                                Width="28"
                                                Height="28"
                                                Margin="0"
                                                Focusable="False"
                                                Click="RestartTerminalButton_OnClick"
                                                AutomationProperties.Name="Restart active terminal with the selected shell"
                                                ToolTip.Tip="Restart active terminal with the selected shell"
                                                Opacity="{Binding HasActiveTerminal, Converter={x:Static kodoModels:BoolToOpacityConverter.Instance}}">
                                            <Viewbox Width="14"
                                                     Height="14"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                    <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                          Source="{x:Static kodo:KodoIcons.ArrowPath}" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                        Background="{Binding TopBarBrush}"
                                        BorderBrush="{Binding SurfaceBorderBrush}"
                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderBottomHairline}"
                                        Padding="8,6">
                                    <ComboBox MinHeight="{x:Static kodo:KodoDesignTokens.DefaultControlHeight}"
                                              MaxHeight="{x:Static kodo:KodoDesignTokens.DefaultControlHeight}"
                                              ItemsSource="{Binding AvailableTerminalShells}"
                                              SelectedItem="{Binding SelectedTerminalShell, Mode=TwoWay}"
                                              Background="{Binding ButtonBrush}"
                                              Foreground="{Binding PrimaryTextBrush}"
                                              BorderBrush="{Binding SurfaceBorderBrush}"
                                              CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                              Padding="10,0"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              VerticalAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              ToolTip.Tip="Choose the default shell for new terminals"
                                              FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}">
                                        <ComboBox.Styles>
                                            <Style Selector="ComboBox /template/ Border#PART_Border">
                                                <Setter Property="MinHeight" Value="0" />
                                            </Style>
                                        </ComboBox.Styles>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="kodoModels:TerminalShellOption" x:CompileBindings="True">
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Border>

                                <ScrollViewer Grid.Row="2"
                                              AllowAutoHide="True"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding TerminalSessions}"
                                                  Margin="8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="kodoModels:TerminalSession" x:CompileBindings="True">
                                                <Border Classes="openeditorrow"
                                                        Classes.active="{Binding IsSelected}"
                                                        Margin="0,0,0,2">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Rename" Tag="{Binding}" Click="RenameTerminalSessionMenuItem_OnClick" />
                                                            <Separator />
                                                            <MenuItem Header="Restart" Tag="{Binding}" Click="RestartTerminalSessionMenuItem_OnClick" />
                                                            <MenuItem Header="Duplicate" Tag="{Binding}" Click="DuplicateTerminalSessionMenuItem_OnClick" />
                                                            <Separator />
                                                            <MenuItem Header="Copy Working Directory" Tag="{Binding}" Click="CopyTerminalSessionWorkingDirectoryMenuItem_OnClick" />
                                                            <Separator />
                                                            <MenuItem Header="Close Others" Tag="{Binding}" Click="CloseOtherTerminalSessionsMenuItem_OnClick" />
                                                            <MenuItem Header="Close" Tag="{Binding}" Click="CloseTerminalSessionButton_OnClick" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid ColumnDefinitions="3,*,Auto">
                                                        <Border Grid.Column="0"
                                                                Classes="accentleading"
                                                                Margin="0,3,6,3"
                                                                IsVisible="{Binding IsSelected}"
                                                                Background="{Binding #RootWindow.AccentBrush}" />
                                                        <Button Grid.Column="1"
                                                                Grid.ColumnSpan="2"
                                                                Classes="openeditor"
                                                                Classes.active="{Binding IsSelected}"
                                                                Tag="{Binding}"
                                                                Click="OpenTerminalSessionButton_OnClick"
                                                                ToolTip.Tip="{Binding WorkingDirectory}"
                                                                AutomationProperties.Name="{Binding Title}"
                                                                Padding="7,5,30,5"
                                                                HorizontalContentAlignment="Stretch">
                                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                                <TextBlock Grid.Column="0"
                                                                           FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                           Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                           Text="{Binding Title}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1"
                                                                           FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                           Margin="6,0,0,0"
                                                                           Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                           Text="{Binding ShellDisplayName}"
                                                                           VerticalAlignment="Center" />
                                                                <Border Grid.Column="2"
                                                                        Background="{Binding #RootWindow.ButtonBrush}"
                                                                        BorderBrush="{Binding #RootWindow.DangerBrush}"
                                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.CompactRadius}"
                                                                        Padding="4,0"
                                                                        Margin="4,0"
                                                                        IsVisible="{Binding HasFailed}"
                                                                        ToolTip.Tip="{Binding StatusText}">
                                                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.CaptionFontSize}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{Binding #RootWindow.DangerBrush}"
                                                                               Text="Failed"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                                <Border Grid.Column="2"
                                                                        Background="{Binding #RootWindow.ButtonBrush}"
                                                                        BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.CompactRadius}"
                                                                        Padding="4,0"
                                                                        Margin="4,0"
                                                                        IsVisible="{Binding ShowExitedStatus}">
                                                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.CaptionFontSize}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                               Text="{Binding StatusText}"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                        <Button Grid.Column="2"
                                                                Classes="tabclose"
                                                                Classes.active="{Binding IsSelected}"
                                                                Tag="{Binding}"
                                                                Click="CloseTerminalSessionButton_OnClick"
                                                                Margin="4,0,3,0"
                                                                AutomationProperties.Name="Close terminal"
                                                                ToolTip.Tip="Close terminal">
                                                            <Viewbox Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                                                    <svg:Svg Width="24" Height="24" CurrentColor="{Binding #RootWindow.PrimaryTextBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                                          Source="{x:Static kodo:KodoIcons.XMark}" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Focusable="False"
                                IsVisible="{Binding HasActiveTerminal}"
                                Background="{Binding EditorBackgroundBrush}"
                                ClipToBounds="True">
                            <kodo:ConsoleTerminal x:Name="TerminalHostControl" Margin="0,6,0,0" />
                        </Border>

                        <Border Grid.Column="1"
                                IsVisible="{Binding !HasActiveTerminal}"
                                Background="{Binding EditorBackgroundBrush}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="14"
                                        MaxWidth="320">
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeroFontSize}"
                                           FontWeight="Bold"
                                           Foreground="{Binding PrimaryTextBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Text="No active terminal" />
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                           Foreground="{Binding MutedTextBrush}"
                                           LineHeight="20"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Text="Choose a shell and open a session. New terminals inherit the workspace folder, or jump in from the shell picker." />
                                <Button Classes="chrome"
                                        Click="NewTerminalButton_OnClick"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,0"
                                        ToolTip.Tip="{Binding NewTerminalTooltip}"
                                        AutomationProperties.Name="{Binding NewTerminalTooltip}"
                                        Content="Create terminal" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{Binding TopBarBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderLeftHairline}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.SidebarRightRadius}">
                            <StackPanel Margin="0,10,0,0" Spacing="0" HorizontalAlignment="Stretch">
                                <Button Classes="activity"
                                        Click="ToggleTerminalButton_OnClick"
                                        AutomationProperties.Name="{Binding ToggleTerminalTooltip}"
                                        ToolTip.Tip="{Binding ToggleTerminalTooltip}"
                                        ToolTip.Placement="LeftEdgeAlignedTop">
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                            <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                                  Source="{x:Static kodo:KodoIcons.XMark}" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="5"
                        Classes="statusBarRoot"
                        Padding="{x:Static kodo:KodoDesignTokens.LeanPadding}"
                        Height="{x:Static kodo:KodoDesignTokens.StatusBarHeight}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="6">
                            <Ellipse Classes="dirtyDot"
                                     IsVisible="{Binding IsDocumentDirty}"
                                     ToolTip.Tip="Unsaved changes" />
                            <Border Background="{Binding ButtonBrush}"
                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.HairlineBorderRadius}"
                                    Padding="5,2"
                                    VerticalAlignment="Center">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasDocumentOpen" />
                                        <Binding Path="IsDocumentViewVisible" />
                                    </MultiBinding>
                                </Border.IsVisible>
                                <TextBlock Text="{Binding StatusBarFileIconText}"
                                           FontSize="{x:Static kodo:KodoDesignTokens.CaptionFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding AccentBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Button Classes="statusitem"
                                    Click="StatusBarFilePathButton_OnClick"
                                    ToolTip.Tip="{Binding StatusBarFilePathTooltip}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding StatusBarFilePathTooltip}"
                                    MaxWidth="440">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasDocumentOpen" />
                                        <Binding Path="IsDocumentViewVisible" />
                                    </MultiBinding>
                                </Button.IsVisible>
                                <TextBlock Text="{Binding FilePathText}"
                                           FontSize="{x:Static kodo:KodoDesignTokens.StatusFontSize}"
                                           TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock Classes="statusDim"
                                       Text="Welcome to Kodo!"
                                       VerticalAlignment="Center">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsEmptyStateVisible" />
                                        <Binding Path="!IsKodoBirthday" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <TextBlock Foreground="{Binding AccentBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="{x:Static kodo:KodoDesignTokens.StatusFontSize}"
                                       VerticalAlignment="Center"
                                       Text="{Binding StatusBarBirthdayText}">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsEmptyStateVisible" />
                                        <Binding Path="IsKodoBirthday" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <Border Classes="statusDivider"
                                    IsVisible="{Binding IsDocumentViewVisible}"
                                    Margin="8,0,6,0" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsDocumentViewVisible}">
                                <Viewbox Width="12" Height="12"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding HasDiagnostics}">
                                    <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                        <svg:Svg Width="24" Height="24" CurrentColor="{Binding DangerBrush, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                              Source="{x:Static kodo:KodoIcons.InformationCircle}" />
                                    </Canvas>
                                </Viewbox>
                                <Button Classes="statusitem"
                                        Padding="4,2"
                                        Click="StatusBarDiagnosticsButton_OnClick"
                                        ToolTip.Tip="{Binding StatusBarDiagnosticsTooltip}"
                                        IsVisible="{Binding HasDiagnostics}"
                                        AutomationProperties.Name="{Binding StatusBarDiagnosticsTooltip}"
                                        VerticalAlignment="Center">
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                               Foreground="{Binding AccentBrush}"
                                               Text="{Binding StatusBarDiagnosticsText}" />
                                </Button>
                                <TextBlock Classes="statusDim"
                                           FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                           Opacity="{x:Static kodo:KodoDesignTokens.MutedForegroundOpacity}"
                                           Text="No problems"
                                           IsVisible="{Binding !HasDiagnostics}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Background="Transparent" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock Classes="statusDim"
                                       Text="{Binding LanguageDisplayText}"
                                       Margin="0,0,2,0">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasFileOpen" />
                                        <Binding Path="IsDocumentViewVisible" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <Border Classes="statusDivider">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasFileOpen" />
                                        <Binding Path="IsDocumentViewVisible" />
                                    </MultiBinding>
                                </Border.IsVisible>
                            </Border>

                            <Button Classes="statusitem"
                                    ToolTip.Tip="File encoding - click to change"
                                    Click="EncodingStatusBarPaletteButton_OnClick"
                                    AutomationProperties.Name="File encoding - click to change"
                                    VerticalAlignment="Center">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasFileOpen" />
                                        <Binding Path="IsDocumentViewVisible" />
                                    </MultiBinding>
                                </Button.IsVisible>
                                <TextBlock Text="{Binding EncodingDisplayText}" />
                            </Button>
                            <Border Classes="statusDivider">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasFileOpen" />
                                        <Binding Path="IsDocumentViewVisible" />
                                    </MultiBinding>
                                </Border.IsVisible>
                            </Border>

                            <Button Classes="statusitem"
                                    ToolTip.Tip="Line ending - click to change"
                                    Click="LineEndingStatusBarPaletteButton_OnClick"
                                    AutomationProperties.Name="Line ending - click to change"
                                    VerticalAlignment="Center">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasFileOpen" />
                                        <Binding Path="IsTextEditorVisible" />
                                    </MultiBinding>
                                </Button.IsVisible>
                                <TextBlock Text="{Binding LineEndingDisplayText}" />
                            </Button>
                            <Border Classes="statusDivider">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasFileOpen" />
                                        <Binding Path="IsTextEditorVisible" />
                                    </MultiBinding>
                                </Border.IsVisible>
                            </Border>

                            <Button Classes="statusitem"
                                    ToolTip.Tip="Indentation - click to change"
                                    Click="IndentationStatusBarPaletteButton_OnClick"
                                    AutomationProperties.Name="Indentation - click to change"
                                    VerticalAlignment="Center">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasFileOpen" />
                                        <Binding Path="IsTextEditorVisible" />
                                    </MultiBinding>
                                </Button.IsVisible>
                                <TextBlock Text="{Binding IndentationDisplayText}" />
                            </Button>
                            <Border Classes="statusDivider">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasFileOpen" />
                                        <Binding Path="IsTextEditorVisible" />
                                    </MultiBinding>
                                </Border.IsVisible>
                            </Border>

                            <TextBlock Classes="statusDim"
                                       IsVisible="{Binding IsWordCountVisible}"
                                       Text="{Binding WordCountText}"
                                       VerticalAlignment="Center"
                                       Margin="2,0" />
                            <Border Classes="statusDivider"
                                    IsVisible="{Binding IsWordCountVisible}" />

                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsDocumentViewVisible}">
                                <TextBlock x:Name="StatusBarCaretLiveRegion" Classes="statusDim"
                                           Text="{Binding StatusBarCaretText}"
                                           AutomationProperties.LiveSetting="Polite"
                                           ToolTip.Tip="Cursor position"
                                           VerticalAlignment="Center" />
                                <TextBlock Classes="statusDim"
                                           Opacity="{x:Static kodo:KodoDesignTokens.DisabledOpacity}"
                                           Text="•"
                                           IsVisible="{Binding HasSelection}"
                                           VerticalAlignment="Center" />
                                <TextBlock Classes="statusDim"
                                           IsVisible="{Binding HasSelection}"
                                           Text="{Binding StatusBarSelectionText}"
                                           Foreground="{Binding AccentBrush}"
                                           VerticalAlignment="Center" />
                                <Border Classes="statusDivider"
                                        IsVisible="{Binding HasSelection}"
                                        Margin="4,0" />
                                <TextBlock Classes="statusDim"
                                           Opacity="{x:Static kodo:KodoDesignTokens.DividerOpacity}"
                                           Text="{Binding StatusBarDocumentText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Classes="statusDivider"
                                    IsVisible="{Binding IsDocumentViewVisible}" />
                            <Button Classes="statusitem"
                                    IsVisible="{Binding IsTerminalSupported}"
                                    Click="ToggleTerminalButton_OnClick"
                                    ToolTip.Tip="{Binding ToggleTerminalTooltip}"
                                    AutomationProperties.Name="{Binding ToggleTerminalTooltip}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="5"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6"
                                             VerticalAlignment="Center"
                                             Fill="{Binding AccentBrush}"
                                             IsVisible="{Binding HasTerminalSessions}" />
                                    <TextBlock Text="{Binding TerminalStatusBarText}" />
                                </StackPanel>
                            </Button>

                            <Border Classes="statusDivider"
                                    IsVisible="{Binding CanShowFindInFile}" />
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{Binding MutedTextBrush}"
                                    Padding="6,3"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CompactRadius}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding CanShowFindInFile}"
                                    ToolTip.Tip="{Binding FindInFileTooltip}"
                                    AutomationProperties.Name="{Binding FindInFileTooltip}"
                                    Click="OpenSearchMenu_OnClick">
                                <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                    <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                        <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}"
                                              Source="{x:Static kodo:KodoIcons.Magnifier}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Classes="searchpanel" x:Name="SearchPanelBorder"
                    IsVisible="{Binding IsSearchPanelActive}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,107,28,0"
                    ZIndex="100">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="searchmode" Classes.selected="{Binding IsFindInFileSearchMode}" Click="SearchModeFindInFileButton_OnClick" ToolTip.Tip="{Binding FindInFileTooltip}" AutomationProperties.Name="{Binding FindInFileTooltip}">
                                <TextBlock Text="Find" />
                            </Button>
                            <Button Classes="searchmode" Classes.selected="{Binding IsFileByNameSearchMode}" IsVisible="{Binding IsFolderOpen}" Click="SearchModeFileByNameButton_OnClick" ToolTip.Tip="Find files by name" AutomationProperties.Name="Find files by name">
                                <TextBlock Text="Files" />
                            </Button>
                            <Button Classes="searchmode" Classes.selected="{Binding IsProjectSearchMode}" IsVisible="{Binding IsFolderOpen}" Click="SearchModeProjectButton_OnClick" ToolTip.Tip="{Binding FindInProjectTooltip}" AutomationProperties.Name="{Binding FindInProjectTooltip}">
                                <TextBlock Text="Project" />
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{Binding MutedTextBrush}" Text="{Binding SearchPlaceholderText}" />
                        <Button Grid.Column="2" Classes="chrome" Padding="6" Click="CloseSearchPanel_OnClick" ToolTip.Tip="Close (Escape)" AutomationProperties.Name="Close (Escape)">
                            <Viewbox Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                    <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}" Source="{x:Static kodo:KodoIcons.XMark}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8">
                        <Border Grid.Column="0" Classes="searchpill" Margin="0,0,10,0">
                            <TextBox x:Name="SearchTextBox" Text="{Binding FindText, Mode=TwoWay}" PlaceholderText="{Binding SearchPlaceholderText}" KeyDown="SearchTextBox_OnKeyDown" MinWidth="260" HorizontalAlignment="Stretch" />
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="chromesmall" Classes.selected="{Binding IsSearchMatchCaseEnabled}" IsVisible="{Binding IsSearchPanelActive}" Click="SearchMatchCaseButton_OnClick" ToolTip.Tip="Match case" AutomationProperties.Name="Match case">
                                <TextBlock Text="Aa" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" />
                            </Button>
                            <Button Classes="chromesmall" Classes.selected="{Binding IsSearchWholeWordEnabled}" IsVisible="{Binding IsSearchPanelActive}" Click="SearchWholeWordButton_OnClick" ToolTip.Tip="Whole word" AutomationProperties.Name="Whole word">
                                <TextBlock Text="W" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" FontWeight="SemiBold" />
                            </Button>
                            <Button Classes="chromesmall" Classes.selected="{Binding IsSearchRegexEnabled}" IsVisible="{Binding IsSearchPanelActive}" Click="SearchRegexButton_OnClick" ToolTip.Tip="Regular expression" AutomationProperties.Name="Regular expression">
                                <TextBlock Text=".*" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" FontWeight="Bold" />
                            </Button>
                            <Button Classes="chromesmall" Classes.selected="{Binding IsFilterRowVisible}" IsVisible="{Binding IsFilterRowSupported}" Click="SearchFilterButton_OnClick" ToolTip.Tip="Include/Exclude filters" AutomationProperties.Name="Include/Exclude filters">
                                <TextBlock Text="+" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" FontWeight="Bold" />
                            </Button>
                            <Button Classes="chromesmall" IsVisible="{Binding IsFindInFileSearchMode}" Click="FindPrevButton_OnClick" ToolTip.Tip="Previous match" AutomationProperties.Name="Previous match">
                                <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                        <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}" Source="{x:Static kodo:KodoIcons.ChevronUp}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Classes="chromesmall" IsVisible="{Binding IsFindInFileSearchMode}" Click="FindNextButton_OnClick" ToolTip.Tip="Next match (Enter)" AutomationProperties.Name="Next match (Enter)">
                                <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}" Height="{x:Static kodo:KodoDesignTokens.GlyphCanvasSize}">
                                        <svg:Svg Width="24" Height="24" CurrentColor="{Binding $parent[Button].Foreground, Converter={x:Static kodoModels:BrushColorConverter.Instance}}" Source="{x:Static kodo:KodoIcons.ChevronDown}" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="chrome" Margin="8,0,0,0" IsVisible="{Binding IsFindInFileSearchMode}" Click="ReplaceButton_OnClick" ToolTip.Tip="Replace current match" AutomationProperties.Name="Replace current match">
                            <TextBlock Text="Replace" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                        <Border Grid.Column="0" Background="{Binding ButtonBrush}" BorderBrush="{Binding SurfaceBorderBrush}" BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}" Margin="0,0,10,0" VerticalAlignment="Center" IsVisible="{Binding IsFindInFileSearchMode}">
                            <TextBox x:Name="ReplaceTextBox" Text="{Binding ReplaceText, Mode=TwoWay}" PlaceholderText="Replace with..." Background="Transparent" Foreground="{Binding PrimaryTextBrush}" BorderThickness="0" Padding="{x:Static kodo:KodoDesignTokens.AveragePadding}" MinWidth="260" HorizontalAlignment="Stretch" />
                        </Border>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{Binding MutedTextBrush}" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" Text="{Binding SearchStatusText}" Margin="0,0,12,0" />
                        <Button Grid.Column="2" Classes="chrome" IsVisible="{Binding IsFindInFileSearchMode}" Click="ReplaceAllButton_OnClick" ToolTip.Tip="Replace all matches" AutomationProperties.Name="Replace all matches">
                            <TextBlock Text="Replace All" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,*,Auto" Margin="0,0,0,8" IsVisible="{Binding IsFilterRowVisible}">
                        <TextBlock Grid.Column="0" Text="Include:" FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Grid.Column="1" Background="{Binding ButtonBrush}" BorderBrush="{Binding SurfaceBorderBrush}" BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}" VerticalAlignment="Center">
                            <TextBox Text="{Binding SearchIncludeFilter, Mode=TwoWay}" PlaceholderText="*.cs,*.axaml" Background="Transparent" Foreground="{Binding PrimaryTextBrush}" BorderThickness="0" Padding="{x:Static kodo:KodoDesignTokens.MediumPadding}" FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="Exclude:" FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,8,0" />
                        <Border Grid.Column="3" Background="{Binding ButtonBrush}" BorderBrush="{Binding SurfaceBorderBrush}" BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}" VerticalAlignment="Center">
                            <TextBox Text="{Binding SearchExcludeFilter, Mode=TwoWay}" PlaceholderText="test/*,*.generated.cs" Background="Transparent" Foreground="{Binding PrimaryTextBrush}" BorderThickness="0" Padding="{x:Static kodo:KodoDesignTokens.MediumPadding}" FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4" IsVisible="{Binding IsSearchResultsVisible}">
                        <Border BorderBrush="{Binding SurfaceBorderBrush}" BorderThickness="{x:Static kodo:KodoDesignTokens.BorderTopHairline}" Margin="0,4,0,0">
                            <ListBox x:Name="SearchResultsListBox"
                                     Classes="searchresults"
                                     ItemsSource="{Binding SearchDisplayItems}"
                                     KeyDown="SearchResultsListBox_OnKeyDown"
                                     DoubleTapped="SearchResultsListBox_OnDoubleTapped"
                                     SelectionChanged="SearchResultsListBox_OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="kodoModels:SearchDisplayItem" x:CompileBindings="True">
                                        <Border Background="Transparent">
                                            <Panel>

                                            <Button IsVisible="{Binding IsGroupHeader}" Classes="chrome groupheader" Tag="{Binding Group}" HorizontalContentAlignment="Left" Padding="8,6" Margin="0" BorderThickness="0"
                                                    Click="SearchGroupHeader_OnClick">
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0">
                                                    <TextBlock Grid.Column="0" Text="{Binding Group.ChevronGlyph}" FontSize="{x:Static kodo:KodoDesignTokens.MicroFontSize}" Foreground="{Binding #RootWindow.MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Group.FileName}" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" FontWeight="SemiBold" Foreground="{Binding #RootWindow.PrimaryTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Group.RelativePath}" FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding #RootWindow.MutedTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    <TextBlock Grid.Column="3" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Group.MatchCount, StringFormat='{}{0} matches'}" FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding #RootWindow.MutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </Grid>
                                            </Button>

                                            <Grid IsVisible="{Binding IsGroupHeader, Converter={x:Static kodoModels:BoolInverter.Instance}}" ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" Margin="8,5" ClipToBounds="True" ToolTip.Tip="{Binding Result.Path}">
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Open"
                                                                  Tag="{Binding Result}"
                                                                  Click="OpenSearchResultMenuItem_OnClick" />
                                                        <Separator />
                                                        <MenuItem Header="Copy Path"
                                                                  Tag="{Binding Result}"
                                                                  Click="CopySearchResultPathMenuItem_OnClick" />
                                                        <MenuItem Header="Copy Relative Path"
                                                                  Tag="{Binding Result}"
                                                                  Click="CopySearchResultRelativePathMenuItem_OnClick" />
                                                        <MenuItem Header="{Binding #RootWindow.RevealInFileManagerText}"
                                                                  Tag="{Binding Result}"
                                                                  Click="RevealSearchResultInExplorerMenuItem_OnClick" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Result.Icon}" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" FontFamily="JetBrains Mono,DejaVu Sans Mono,Ubuntu Mono,Noto Sans Mono,Cascadia Code,Consolas,Menlo,monospace" Foreground="{Binding #RootWindow.MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" FontWeight="SemiBold" Foreground="{Binding #RootWindow.PrimaryTextBrush}" VerticalAlignment="Center" TextWrapping="NoWrap"
                                                           Text="{Binding Result.DisplayName}" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Result.RelativePath}" FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding #RootWindow.MutedTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding Result.HasPreview}" FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" FontFamily="JetBrains Mono,DejaVu Sans Mono,Ubuntu Mono,Noto Sans Mono,Cascadia Code,Consolas,Menlo,monospace" Foreground="{Binding #RootWindow.MutedTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"
                                                           Text="{Binding Result.PreviewText}" />
                                            </Grid>
                                            </Panel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid IsVisible="{Binding IsTutorialPageVisible}"
                  IsHitTestVisible="{Binding IsTutorialPageVisible}"
                  Background="{Binding EditorBackgroundBrush}"
                  RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        IsVisible="{Binding IsTutorialHeaderVisible}"
                        Background="{Binding TopBarBrush}"
                        BorderBrush="{Binding SurfaceBorderBrush}"
                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderBottomHairline}"
                        Padding="24,18">
                    <Grid ColumnDefinitions="*">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Classes="accentleading" Height="32" Background="{Binding AccentBrush}" />
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeroLargeFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding PrimaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Text="Tutorial" />
                            </StackPanel>
                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="A built-in walkthrough for getting comfortable in Kodo." />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      IsVisible="{Binding IsTutorialWelcomeStep}">
                    <StackPanel Spacing="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <Border Width="72" Height="72"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,28">
                            <Image Source="avares://Kodo/Assets/kodo-logo.png"
                                   Stretch="UniformToFill" />
                        </Border>

                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.DisplayHugeFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{Binding PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="Welcome to Kodo!" />

                        <Border Height="3"
                                Width="64"
                                Background="{Binding AccentBrush}"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,20" />

                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SectionFontSize}"
                                   Foreground="{Binding MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   LineHeight="26"
                                   Text="A fast, focused code editor built to stay out of your way. Take five short steps to get oriented, then jump straight into your work." />

                        <Border Background="{Binding ButtonBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.PillRadius}"
                                Padding="12,7"
                                HorizontalAlignment="Center"
                                Margin="0,28,0,0">
                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding AccentBrush}"
                                       Text="5 STEPS  ·  ABOUT A MINUTE  ·  REVISIT ANYTIME IN SETTINGS" />
                        </Border>

                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                   Foreground="{Binding MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   Text="{Binding TutorialProgressDotsText}"
                                   Margin="0,14,0,0" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="10"
                                    Margin="0,16,0,0">
                            <Button Classes="chrome"
                                    Click="SkipTutorialButton_OnClick"
                                    Content="Skip Tutorial" />
                            <Button Classes="marketaction"
                                    Click="NextTutorialStepButton_OnClick"
                                    Content="Get started" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      IsVisible="{Binding IsNotTutorialWelcomeStep}"
                      RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0"
                              Padding="24"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="*,320">
                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                Padding="20"
                                Margin="0,0,16,0">
                            <StackPanel Spacing="18">
                            <Panel>

                                <StackPanel IsVisible="{Binding IsNotTutorialSetupStep}"
                                            Spacing="18">
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding AccentBrush}"
                                               Text="{Binding TutorialStepLabel}" />
                                    <ProgressBar Height="4"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding TutorialProgressPercent}"
                                                 Foreground="{Binding AccentBrush}"
                                                 Background="{Binding ButtonBrush}" />
                                </StackPanel>

                                <StackPanel Spacing="10">
                                    <Border Background="{Binding ButtonBrush}"
                                            BorderBrush="{Binding SurfaceBorderBrush}"
                                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                            CornerRadius="{x:Static kodo:KodoDesignTokens.PillRadius}"
                                            Padding="10,4"
                                            HorizontalAlignment="Left">
                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding AccentBrush}"
                                                   Text="{Binding TutorialSectionTitle}" />
                                    </Border>
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.DisplayLargeFontSize}"
                                               FontWeight="Bold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding TutorialTitle}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                               Foreground="{Binding MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="24"
                                               Text="{Binding TutorialBody}" />
                                </StackPanel>

                                <Border Background="{Binding ButtonBrush}"
                                        BorderBrush="{Binding SurfaceBorderBrush}"
                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                        CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                        Padding="18">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding MutedTextBrush}"
                                                   Text="Shortcut" />
                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding TutorialShortcutText}" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                                <StackPanel IsVisible="{Binding IsTutorialSetupStep}" Spacing="28">

                                    <StackPanel Spacing="6">
                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding AccentBrush}"
                                                   Text="{Binding TutorialStepLabel}" />
                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.DisplayLargeFontSize}"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Text="{Binding TutorialTitle}" />
                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                                   Foreground="{Binding MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="22"
                                                   Text="{Binding TutorialBody}" />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,1,*" ColumnSpacing="0">

                                        <StackPanel Grid.Column="0" Spacing="24" Margin="0,0,32,0">

                                            <StackPanel Spacing="12">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Border Classes="accentleading" Height="16" Background="{Binding AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding PrimaryTextBrush}"
                                                               VerticalAlignment="Center"
                                                               Text="THEME" />
                                                </StackPanel>

                                                <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
                                                    <Button Classes="chrome"
                                                            Click="ThemeButton_OnClick"
                                                            Tag="Dark"
                                                            Width="170"
                                                            AutomationProperties.Name="Apply Dark theme"
                                                            ToolTip.Tip="Apply Dark theme">
                                                        <StackPanel Spacing="8">
                                                            <Panel>
                                                                <Border Height="72"
                                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                                        Background="{x:Static kodo:KodoDesignTokens.WindowBackground}"
                                                                        BorderBrush="{x:Static kodo:KodoDesignTokens.SurfaceBorder}"
                                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" />
                                                                <Border Height="72"
                                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThick}"
                                                                        BorderBrush="{Binding AccentBrush}"
                                                                        IsVisible="{Binding IsDarkThemeActive}" />
                                                            </Panel>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                                <TextBlock Foreground="{Binding PrimaryTextBrush}" Text="Dark" />
                                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding AccentBrush}"
                                                                           VerticalAlignment="Center" Text="●"
                                                                           IsVisible="{Binding IsDarkThemeActive}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="chrome"
                                                            Click="ThemeButton_OnClick"
                                                            Tag="Light"
                                                            Width="170"
                                                            AutomationProperties.Name="Apply Light theme"
                                                            ToolTip.Tip="Apply Light theme">
                                                        <StackPanel Spacing="8">
                                                            <Panel>
                                                                <Border Height="72"
                                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                                        Background="#FFFFFF"
                                                                        BorderBrush="{x:Static kodo:KodoDesignTokens.LightSurfaceBorder}"
                                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" />
                                                                <Border Height="72"
                                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThick}"
                                                                        BorderBrush="{Binding AccentBrush}"
                                                                        IsVisible="{Binding IsLightThemeActive}" />
                                                            </Panel>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                                <TextBlock Foreground="{Binding PrimaryTextBrush}" Text="Light" />
                                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding AccentBrush}"
                                                                           VerticalAlignment="Center" Text="●"
                                                                           IsVisible="{Binding IsLightThemeActive}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="chrome"
                                                            Click="ThemeButton_OnClick"
                                                            Tag="System"
                                                            Width="170"
                                                            AutomationProperties.Name="{Binding TooltipSystemTheme}"
                                                            ToolTip.Tip="{Binding TooltipSystemTheme}">
                                                        <StackPanel Spacing="8">
                                                            <Panel>
                                                                <Border Height="72"
                                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                                        Background="{Binding SystemThemePreviewBackground}"
                                                                        BorderBrush="{Binding SystemThemePreviewBorder}"
                                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" />
                                                                <Border Height="72"
                                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThick}"
                                                                        BorderBrush="{Binding AccentBrush}"
                                                                        IsVisible="{Binding IsSystemThemeActive}" />
                                                            </Panel>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                                <TextBlock Foreground="{Binding PrimaryTextBrush}" Text="System Default" />
                                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding AccentBrush}"
                                                                           VerticalAlignment="Center" Text="●"
                                                                           IsVisible="{Binding IsSystemThemeActive}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>

                                                <StackPanel Spacing="8" IsVisible="{Binding HasThemeExtensions}">
                                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding MutedTextBrush}"
                                                               Text="INSTALLED THEME EXTENSIONS" />

                                                    <ItemsControl ItemsSource="{Binding GroupedThemeExtensions}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="kodoModels:ThemeExtensionGroup" x:CompileBindings="True">
                                                                <StackPanel Spacing="6">

                                                                    <Button Classes="chrome groupheader"
                                                                            Click="ThemeGroupHeader_OnClick"
                                                                            IsVisible="{Binding IsMultiTheme}">
                                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                                                                            <TextBlock Grid.Column="0"
                                                                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                                       VerticalAlignment="Center"
                                                                                       Text="{Binding GroupName}" />
                                                                             <TextBlock Grid.Column="1"
                                                                                        FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                                        Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                                        VerticalAlignment="Center"
                                                                                        Text="{Binding Themes.Count, StringFormat='{}{0} themes'}" />
                                                                            <Border Grid.Column="2" Background="Transparent" />
                                                                            <TextBlock Grid.Column="3"
                                                                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                                       Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                                       VerticalAlignment="Center"
                                                                                       Text="{Binding ChevronGlyph}" />
                                                                        </Grid>
                                                                    </Button>

                                                                    <ItemsControl ItemsSource="{Binding Themes}"
                                                                                  IsVisible="{Binding IsExpanded}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="kodoModels:LoadedExtension" x:CompileBindings="True">
                                                                                    <Button Classes="chrome"
                                                                                            Background="{Binding #RootWindow.ButtonBrush}"
                                                                                            BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                                                            Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                                            Click="ThemeButton_OnClick"
                                                                                            Tag="{Binding ThemeCardThemeId}"
                                                                                            Width="170">
                                                                                        <ToolTip.Tip>
                                                                                            <StackPanel Spacing="2">
                                                                                                <TextBlock Text="{Binding ThemeCardDisplayName}"
                                                                                                           Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                                                           FontWeight="SemiBold"
                                                                                                           FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" />
                                                                                                <TextBlock Text="{Binding SourcePath}"
                                                                                                           Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                                                           FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                                                           Opacity="{x:Static kodo:KodoDesignTokens.StrongOpacity}" />
                                                                                            </StackPanel>
                                                                                        </ToolTip.Tip>
                                                                                        <StackPanel Spacing="8">
                                                                                            <Panel>
                                                                                                <Border Height="72"
                                                                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                                                                        Background="{Binding ThemeCardPreviewBackground}"
                                                                                                        BorderBrush="{Binding ThemeCardPreviewBorder}"
                                                                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}">
                                                                                                    <Border Width="32"
                                                                                                            Height="8"
                                                                                                            Margin="10"
                                                                                                            HorizontalAlignment="Left"
                                                                                                            VerticalAlignment="Top"
                                                                                                            CornerRadius="{x:Static kodo:KodoDesignTokens.PillRadius}"
                                                                                                            Background="{Binding ThemeCardAccent}" />
                                                                                                </Border>
                                                                                                <Border Height="72"
                                                                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThick}"
                                                                                                        BorderBrush="{Binding #RootWindow.AccentBrush}"
                                                                                                        IsVisible="{Binding IsActiveTheme}" />
                                                                                            </Panel>
                                                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                                                                <TextBlock Grid.Column="0"
                                                                                                           HorizontalAlignment="Center"
                                                                                                           Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                                                           Text="{Binding ThemeCardDisplayName}"
                                                                                                           TextWrapping="Wrap"
                                                                                                           TextAlignment="Center" />
                                                                                                 <TextBlock Grid.Column="1"
                                                                                                            FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                                                            Foreground="{Binding #RootWindow.AccentBrush}"
                                                                                                            VerticalAlignment="Center"
                                                                                                            Text="●"
                                                                                                            IsVisible="{Binding IsActiveTheme}" />
                                                                                             </Grid>
                                                                                         </StackPanel>
                                                                                    </Button>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>

                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Spacing="12">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Border Classes="accentleading" Height="16" Background="{Binding AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding PrimaryTextBrush}"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding LabelAccentColour}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Button Classes="chrome"
                                                            Click="AccentThemeButton_OnClick"
                                                            Width="120"
                                                            IsVisible="{Binding HasThemeAccent}"
                                                            AutomationProperties.Name="{Binding TooltipAccentTheme}"
                                                            ToolTip.Tip="{Binding TooltipAccentTheme}">
                                                        <StackPanel Spacing="6">
                                                            <Border Height="28" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}" Background="{Binding ThemeAccentPreviewBrush}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                                <TextBlock Foreground="{Binding PrimaryTextBrush}" Text="Theme" />
                                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding AccentBrush}"
                                                                           VerticalAlignment="Center" Text="●"
                                                                           IsVisible="{Binding IsAccentTheme}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="chrome"
                                                            Click="AccentKodoButton_OnClick"
                                                            Width="120"
                                                            AutomationProperties.Name="Use Kodo's default purple accent"
                                                            ToolTip.Tip="Use Kodo's default purple accent">
                                                        <StackPanel Spacing="6">
                                                            <Border Height="28" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}" Background="{x:Static kodo:KodoDesignTokens.DefaultAccentHex}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                                <TextBlock Foreground="{Binding PrimaryTextBrush}" Text="Kodo" />
                                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding AccentBrush}"
                                                                           VerticalAlignment="Center" Text="●"
                                                                           IsVisible="{Binding IsAccentKodo}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="chrome"
                                                            Click="AccentWindowsButton_OnClick"
                                                            Width="120"
                                                            AutomationProperties.Name="{Binding TooltipAccentWindows}"
                                                            ToolTip.Tip="{Binding TooltipAccentWindows}">
                                                        <StackPanel Spacing="6">
                                                            <Border Height="28" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                                    Background="{Binding AccentBrush}"
                                                                    IsVisible="{Binding IsAccentWindows}" />
                                                            <Border Height="28" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                                    Background="{Binding WindowsAccentPreviewBrush}"
                                                                    IsVisible="{Binding !IsAccentWindows}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                                <TextBlock Foreground="{Binding PrimaryTextBrush}" Text="{Binding LabelAccentSystem}" />
                                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding AccentBrush}"
                                                                           VerticalAlignment="Center" Text="●"
                                                                           IsVisible="{Binding IsAccentWindows}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="chrome"
                                                            Click="AccentColorPickerButton_OnClick"
                                                            Width="120"
                                                            AutomationProperties.Name="{Binding TooltipAccentCustom}"
                                                            ToolTip.Tip="{Binding TooltipAccentCustom}">
                                                        <StackPanel Spacing="6">
                                                            <Border Height="28" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                                    Background="{Binding AccentBrush}"
                                                                    IsVisible="{Binding IsAccentCustom}" />
                                                            <Border Height="28" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                                    IsVisible="{Binding !IsAccentCustom}">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                        <GradientStop Color="#FF0000" Offset="0" />
                                                                        <GradientStop Color="#FFFF00" Offset="0.33" />
                                                                        <GradientStop Color="#00FF00" Offset="0.5" />
                                                                        <GradientStop Color="#0000FF" Offset="0.67" />
                                                                        <GradientStop Color="#FF00FF" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                                <TextBlock Foreground="{Binding PrimaryTextBrush}" Text="Custom" />
                                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding AccentBrush}"
                                                                           VerticalAlignment="Center" Text="●"
                                                                           IsVisible="{Binding IsAccentCustom}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>

                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Width="1"
                                                Background="{Binding SurfaceBorderBrush}"
                                                VerticalAlignment="Stretch"
                                                Margin="0,4" />

                                        <StackPanel Grid.Column="2" Spacing="16" Margin="32,0,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Classes="accentleading" Height="16" Background="{Binding AccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding PrimaryTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding LabelPersonalization}" />
                                            </StackPanel>

                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                                  ColumnSpacing="16" RowSpacing="14">
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding PrimaryTextBrush}"
                                                           Text="Name" />
                                                <TextBox Grid.Row="0" Grid.Column="1"
                                                         Text="{Binding UserName, Mode=TwoWay}"
                                                         PlaceholderText="e.g. Alex"
                                                         CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                         Padding="10,8"
                                                         Background="{Binding ButtonBrush}"
                                                         Foreground="{Binding PrimaryTextBrush}"
                                                         BorderBrush="{Binding SurfaceBorderBrush}"
                                                         BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding PrimaryTextBrush}"
                                                           Text="Country" />
                                                <TextBox Grid.Row="1" Grid.Column="1"
                                                         Text="{Binding UserCountry, Mode=TwoWay}"
                                                         PlaceholderText="e.g. CA, US, GB"
                                                         CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                         Padding="10,8"
                                                         Background="{Binding ButtonBrush}"
                                                         Foreground="{Binding PrimaryTextBrush}"
                                                         BorderBrush="{Binding SurfaceBorderBrush}"
                                                         BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" />

                                                <TextBlock Grid.Row="2" Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding PrimaryTextBrush}"
                                                           Text="Hemisphere" />
                                                <ComboBox Grid.Row="2" Grid.Column="1"
                                                          SelectedIndex="{Binding UserHemisphereIndex, Mode=TwoWay}"
                                                          Background="{Binding ButtonBrush}"
                                                          Foreground="{Binding PrimaryTextBrush}"
                                                          BorderBrush="{Binding SurfaceBorderBrush}"
                                                          HorizontalAlignment="Stretch"
                                                          CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}">
                                                    <ComboBoxItem Content="Auto-detect" />
                                                    <ComboBoxItem Content="Northern" />
                                                    <ComboBoxItem Content="Southern" />
                                                </ComboBox>

                                                <TextBlock Grid.Row="3" Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding PrimaryTextBrush}"
                                                           Text="Time zone" />
                                                <TextBox Grid.Row="3" Grid.Column="1"
                                                         Text="{Binding UserTimezoneOffset, Mode=TwoWay}"
                                                         PlaceholderText="e.g. -5, +1"
                                                         CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                         Padding="10,8"
                                                         Background="{Binding ButtonBrush}"
                                                         Foreground="{Binding PrimaryTextBrush}"
                                                         BorderBrush="{Binding SurfaceBorderBrush}"
                                                         BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" />
                                            </Grid>

                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                       Foreground="{Binding MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Text="All fields are optional. Changes take effect immediately." />
                                        </StackPanel>

                                    </Grid>

                                    <Border IsVisible="{Binding IsPrivacyPolicyPromptVisible}"
                                            Background="{Binding ButtonBrush}"
                                            BorderBrush="{Binding SurfaceBorderBrush}"
                                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                            CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                            Padding="20">
                                        <StackPanel Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Border Classes="accentleading" Height="18" Background="{Binding AccentBrush}" />
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding PrimaryTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Text="Required: Privacy Policy" />
                                            </StackPanel>
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding PrimaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Text="Scroll through the document to its last line. Accept stays locked until you reach the end." />
                                            <Border Background="{Binding ButtonBrush}"
                                                    BorderBrush="{Binding AccentBrush}"
                                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                                    CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                    Padding="10,8">
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding PrimaryTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding PrivacyPolicyScrollStatusText}" />
                                            </Border>
                                            <Border Background="{Binding WindowBackgroundBrush}"
                                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                                    Padding="16"
                                                    MinHeight="180"
                                                    MaxHeight="260">
                                                <ScrollViewer x:Name="PrivacyPolicyScrollViewerTutorial"
                                                              ScrollChanged="PrivacyPolicyScrollViewer_OnScrollChanged"
                                                              VerticalScrollBarVisibility="Visible"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <TextBlock Foreground="{Binding MutedTextBrush}"
                                                               TextWrapping="Wrap"
                                                               LineHeight="18"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               FontFamily="JetBrains Mono,DejaVu Sans Mono,Ubuntu Mono,Noto Sans Mono,Cascadia Code,Consolas,Menlo,monospace"
                                                               Text="{Binding PrivacyPolicyText}" />
                                                </ScrollViewer>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Button Classes="marketaction"
                                                        IsEnabled="{Binding IsPrivacyPolicyScrolledToBottom}"
                                                        Click="AcceptPrivacyPolicyButton_OnClick"
                                                        Content="Accept Privacy Policy" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border IsVisible="{Binding IsDataTrackingPromptVisible}"
                                            Background="{Binding ButtonBrush}"
                                            BorderBrush="{Binding SurfaceBorderBrush}"
                                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                            CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                            Padding="20">
                                        <StackPanel Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Border Classes="accentleading" Height="18" Background="{Binding AccentBrush}" />
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.TitleFontSize}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding PrimaryTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Text="Help improve Kodo" />
                                            </StackPanel>
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                       Foreground="{Binding MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="20"
                                                       Text="Kodo can send anonymous usage data - like which features get used and crash reports - to help fix bugs and prioritize what to build next. Nothing personal, and no file contents or paths, ever. You can change this anytime in Settings." />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Button Classes="chrome"
                                                        Click="DeclineDataTrackingButton_OnClick"
                                                        Content="Not now" />
                                                <Button Classes="marketaction"
                                                        Click="AcceptDataTrackingButton_OnClick"
                                                        Content="Accept" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>

                            </Panel>

                            </StackPanel>

                        </Border>


                        <StackPanel Grid.Column="1" Spacing="16">

                            <Border IsVisible="{Binding IsNotTutorialSetupStep}"
                                    Background="{Binding CardBrush}"
                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                    Padding="22">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding AccentBrush}"
                                               Text="WHAT TO TRY" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeroFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding TutorialSpotlightTitle}" />
                                    <TextBlock Foreground="{Binding MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding TutorialHighlightOne}" />
                                    <TextBlock Foreground="{Binding MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding TutorialHighlightTwo}" />
                                    <TextBlock Foreground="{Binding MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding TutorialHighlightThree}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <Border Grid.Row="1"
                        Background="{Binding TopBarBrush}"
                        BorderBrush="{Binding SurfaceBorderBrush}"
                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderTopHairline}"
                        Padding="24,14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{Binding MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding IsTutorialSetupStep}"
                                   Text="{Binding TutorialSetupStatusText}" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="10">
                            <Button Classes="chrome"
                                    Click="PreviousTutorialStepButton_OnClick"
                                    IsVisible="{Binding CanGoToPreviousTutorialStep}"
                                    Content="Back" />
                            <Button Classes="chrome"
                                    Click="SkipTutorialButton_OnClick"
                                    IsVisible="{Binding IsNotTutorialSetupStep}"
                                    IsEnabled="{Binding CanSkipTutorial}"
                                    Content="Skip tutorial" />
                            <Button Classes="marketaction"
                                    Click="NextTutorialStepButton_OnClick"
                                    MinWidth="148"
                                    IsEnabled="{Binding CanAdvanceTutorial}"
                                    Content="{Binding TutorialPrimaryButtonText}" />
                        </StackPanel>
                    </Grid>
                </Border>
                </Grid>
            </Grid>

            <Grid IsVisible="{Binding IsExtensionsPageVisible}"
                  IsHitTestVisible="{Binding IsExtensionsPageVisible}"
                  Background="{Binding EditorBackgroundBrush}"
                  RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        Background="{Binding TopBarBrush}"
                        BorderBrush="{Binding SurfaceBorderBrush}"
                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderBottomHairline}"
                        Padding="24,18">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="32" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeroLargeFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="Marketplace"/>
                                </StackPanel>
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                           Foreground="{Binding MutedTextBrush}"
                                           Text="Enhance Kodo with syntax highlighting, plugins, themes, and compilers" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                <Button Classes="chrome"
                                        Click="RefreshExtensionsButton_OnClick"
                                        IsEnabled="{Binding !IsRefreshingExtensions}"
                                        ToolTip.Tip="Reload extensions from disk and marketplace"
                                        AutomationProperties.Name="Reload extensions from disk and marketplace"
                                        Content="{Binding RefreshExtensionsButtonText}" />
                                <Button Classes="chrome"
                                        Click="OpenExtensionsFolderButton_OnClick"
                                        ToolTip.Tip="Open the local Extensions folder"
                                        AutomationProperties.Name="Open the local Extensions folder"
                                        Content="Open Folder" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1"
                              Name="ExtensionsScrollViewer"
                              Padding="24"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,0,0,96">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="tab"
                                    Classes.tabactive="{Binding IsInstalledTabSelected}"
                                    Click="InstalledTabButton_OnClick"
                                    Content="Installed" />
                            <Button Classes="tab"
                                    Classes.tabactive="{Binding IsLanguagesTabSelected}"
                                    Click="LanguagesTabButton_OnClick"
                                    Content="Languages" />
                            <Button Classes="tab"
                                    Classes.tabactive="{Binding IsThemesTabSelected}"
                                    Click="ThemesTabButton_OnClick"
                                    Content="Themes" />
                            <Button Classes="tab"
                                    Classes.tabactive="{Binding IsPluginsTabSelected}"
                                    Click="PluginsTabButton_OnClick"
                                    Content="Plugins" />
                            <Button Classes="tab"
                                    Classes.tabactive="{Binding IsCompilersTabSelected}"
                                    Click="CompilersTabButton_OnClick"
                                    Content="Compilers" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                              ColumnSpacing="10">
                            <TextBox Grid.Column="0"
                                     Text="{Binding ExtensionSearchText, Mode=TwoWay}"
                                     PlaceholderText="Search extensions..."
                                     Background="{Binding ButtonBrush}"
                                     Foreground="{Binding PrimaryTextBrush}"
                                     BorderBrush="{Binding SurfaceBorderBrush}"
                                     CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                     Height="{x:Static kodo:KodoDesignTokens.LargeControlHeight}"
                                     Padding="{x:Static kodo:KodoDesignTokens.HorizontalPadding}"
                                     VerticalContentAlignment="Center" />

                            <Border Grid.Column="1"
                                    MinWidth="96"
                                    MaxWidth="180"
                                    IsVisible="{Binding IsInstalledTabSelected}"
                                    Background="{Binding ButtonBrush}"
                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                    Height="{x:Static kodo:KodoDesignTokens.LargeControlHeight}"
                                    Padding="6,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                                <ComboBox ItemsSource="{Binding InstalledContentFilterOptions}"
                                          SelectedItem="{Binding SelectedInstalledContentFilter, Mode=TwoWay}"
                                          MinWidth="0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Left"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                          Foreground="{Binding PrimaryTextBrush}">
                                    <ComboBox.Styles>
                                        <Style Selector="ComboBoxItem">
                                            <Setter Property="Background" Value="{Binding #RootWindow.ButtonBrush}" />
                                            <Setter Property="Foreground" Value="{Binding #RootWindow.PrimaryTextBrush}" />
                                        </Style>
                                    </ComboBox.Styles>
                                </ComboBox>
                            </Border>
                            <Border Grid.Column="2"
                                    MinWidth="96"
                                    MaxWidth="220"
                                    Background="{Binding ButtonBrush}"
                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                    Height="{x:Static kodo:KodoDesignTokens.LargeControlHeight}"
                                    Padding="6,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                                <ComboBox ItemsSource="{Binding ExtensionSortOptions}"
                                          SelectedItem="{Binding SelectedExtensionSort, Mode=TwoWay}"
                                          MinWidth="0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Left"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                          Foreground="{Binding PrimaryTextBrush}">
                                    <ComboBox.Styles>
                                        <Style Selector="ComboBoxItem">
                                            <Setter Property="Background" Value="{Binding #RootWindow.ButtonBrush}" />
                                            <Setter Property="Foreground" Value="{Binding #RootWindow.PrimaryTextBrush}" />
                                        </Style>
                                    </ComboBox.Styles>
                                </ComboBox>
                            </Border>
                            <Button Grid.Column="3"
                                    Classes="chrome"
                                    Click="UpdateAllMarketplaceExtensionsButton_OnClick"
                                    IsEnabled="{Binding CanUpdateAllExtensions}"
                                    ToolTip.Tip="Update all installed extensions to their latest versions"
                                    AutomationProperties.Name="Update all installed extensions to their latest versions"
                                    Content="{Binding UpdateAllExtensionsButtonText}" />
                        </Grid>

                        <StackPanel IsVisible="{Binding IsInstalledTabSelected}" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Classes="extstatchip">
                                    <StackPanel Spacing="0">
                                        <TextBlock Classes="extstatvalue" Text="{Binding InstalledExtensionsCount}" />
                                        <TextBlock Classes="extstatlabel" Text="Installed" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="extstatchip" Classes.accented="{Binding IsExtensionUpdateBannerVisible}">
                                    <StackPanel Spacing="0">
                                        <TextBlock Classes="extstatvalue" Text="{Binding AvailableExtensionUpdatesCount}" />
                                        <TextBlock Classes="extstatlabel" Text="Updates" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Classes="extensionlistcard" IsVisible="{Binding HasVisibleInstalledExtensionsOrCompilers}">
                            <StackPanel Spacing="0">

                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasVisibleInstalledLanguageExtensions}" Margin="14,12,14,6" VerticalAlignment="Center">
                                <Border Classes="accentleading" Height="14" Background="{Binding AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Languages" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" FontWeight="SemiBold" Foreground="{Binding PrimaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl IsVisible="{Binding HasVisibleInstalledLanguageExtensions}" ItemsSource="{Binding FilteredInstalledLanguageExtensions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="kodoModels:LoadedExtension" x:CompileBindings="True">
                                        <Border Classes="extensionrow">
                                            <ToolTip.Tip>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" />
                                                    <TextBlock Text="{Binding SourcePath}"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                               Opacity="{x:Static kodo:KodoDesignTokens.DividerOpacity}" />
                                                </StackPanel>
                                            </ToolTip.Tip>
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
                                                <Border Grid.Column="0"
                                                        Classes="accentleading"
                                                        VerticalAlignment="Stretch"
                                                        Background="{Binding #RootWindow.AccentBrush}" />
                                                <Border Grid.Column="1" Classes="iconwell"
                                                        Background="{Binding #RootWindow.AccentBrush}"
                                                        IsVisible="{Binding !HasIcon}">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding #RootWindow.AccentForegroundBrush}"
                                                               Text="{Binding NameAbbreviation}" />
                                                </Border>
                                                <Border Grid.Column="1" Classes="iconwell"
                                                        IsVisible="{Binding HasIcon}"
                                                        ClipToBounds="True">
                                                    <Panel>
                                                        <Image Source="{Binding IconImage}"
                                                               Width="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                               Height="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                               Stretch="Uniform"
                                                               IsVisible="{Binding IconImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <svg:Svg Source="{Binding SvgData}"
                                                                 Width="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                                 Height="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                                 IsVisible="{Binding SvgData, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                               Text="{Binding Description}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            Spacing="14"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="6"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">
                                                        <Border Width="6" Height="6" CornerRadius="{x:Static kodo:KodoDesignTokens.HoverRowRadius}"
                                                                Background="{Binding #RootWindow.AccentBrush}"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsUpdateAvailable}"
                                                                ToolTip.Tip="Update available" />
                                                        <TextBlock Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                   FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Version}" />
                                                    </StackPanel>
                                                    <Button Classes="chrome"
                                                    Background="{Binding #RootWindow.ButtonBrush}"
                                                    BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                    Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                    Tag="{Binding}"
                                                    Click="UpdateInstalledExtensionButton_OnClick"
                                                    Content="Update"
                                                    IsVisible="{Binding IsUpdateAvailable}" />
                                                    <Button Classes="uninstall"
                                                    Tag="{Binding}"
                                                    Click="UninstallExtensionButton_OnClick"
                                                    Content="Uninstall" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border IsVisible="{Binding IsInstalledLanguageDividerVisible}" Height="1" Margin="12,8" Background="{Binding SurfaceBorderBrush}" Opacity="{x:Static kodo:KodoDesignTokens.DividerOpacity}"/>

                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasVisibleInstalledPluginExtensions}" Margin="14,10,14,6" VerticalAlignment="Center">
                                <Border Classes="accentleading" Height="14" Background="{Binding AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Plugins" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" FontWeight="SemiBold" Foreground="{Binding PrimaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl IsVisible="{Binding HasVisibleInstalledPluginExtensions}" ItemsSource="{Binding FilteredInstalledPluginExtensions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="kodoModels:LoadedExtension" x:CompileBindings="True">
                                        <Border Classes="extensionrow">
                                            <ToolTip.Tip>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" />
                                                    <TextBlock Text="{Binding SourcePath}"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                               Opacity="{x:Static kodo:KodoDesignTokens.DividerOpacity}" />
                                                </StackPanel>
                                            </ToolTip.Tip>
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
                                                <Border Grid.Column="0"
                                                        Classes="accentleading"
                                                        VerticalAlignment="Stretch"
                                                        Background="{Binding #RootWindow.AccentBrush}" />
                                                <Border Grid.Column="1" Classes="iconwell"
                                                        Background="{Binding #RootWindow.AccentBrush}"
                                                        IsVisible="{Binding !HasIcon}">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding #RootWindow.AccentForegroundBrush}"
                                                               Text="{Binding NameAbbreviation}" />
                                                </Border>
                                                <Border Grid.Column="1" Classes="iconwell"
                                                        IsVisible="{Binding HasIcon}"
                                                        ClipToBounds="True">
                                                    <Panel>
                                                        <Image Source="{Binding IconImage}"
                                                               Width="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                               Height="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                               Stretch="Uniform"
                                                               IsVisible="{Binding IconImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <svg:Svg Source="{Binding SvgData}"
                                                                 Width="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                                 Height="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                                 IsVisible="{Binding SvgData, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                               Text="{Binding Description}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            Spacing="14"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="6"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">
                                                        <Border Width="6" Height="6" CornerRadius="{x:Static kodo:KodoDesignTokens.HoverRowRadius}"
                                                                Background="{Binding #RootWindow.AccentBrush}"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsUpdateAvailable}"
                                                                ToolTip.Tip="Update available" />
                                                        <TextBlock Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                   FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Version}" />
                                                    </StackPanel>
                                                    <Button Classes="chrome"
                                                    Background="{Binding #RootWindow.ButtonBrush}"
                                                    BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                    Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                    Tag="{Binding}"
                                                    Click="UpdateInstalledExtensionButton_OnClick"
                                                    Content="Update"
                                                    IsVisible="{Binding IsUpdateAvailable}" />
                                                    <Button Classes="uninstall"
                                                    Tag="{Binding}"
                                                    Click="UninstallExtensionButton_OnClick"
                                                    Content="Uninstall" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border IsVisible="{Binding IsInstalledPluginDividerVisible}" Height="1" Margin="12,8" Background="{Binding SurfaceBorderBrush}" Opacity="{x:Static kodo:KodoDesignTokens.DividerOpacity}"/>

                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasVisibleInstalledThemeExtensions}" Margin="14,10,14,6" VerticalAlignment="Center">
                                <Border Classes="accentleading" Height="14" Background="{Binding AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Themes" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" FontWeight="SemiBold" Foreground="{Binding PrimaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl IsVisible="{Binding HasVisibleInstalledThemeExtensions}" ItemsSource="{Binding FilteredInstalledThemeExtensions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="kodoModels:LoadedExtension" x:CompileBindings="True">
                                        <Border Classes="extensionrow">
                                            <ToolTip.Tip>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" />
                                                    <TextBlock Text="{Binding SourcePath}"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                               Opacity="{x:Static kodo:KodoDesignTokens.DividerOpacity}" />
                                                </StackPanel>
                                            </ToolTip.Tip>
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
                                                <Border Grid.Column="0"
                                                        Classes="accentleading"
                                                        VerticalAlignment="Stretch"
                                                        Background="{Binding #RootWindow.AccentBrush}" />
                                                <Border Grid.Column="1" Classes="iconwell"
                                                        Background="{Binding #RootWindow.AccentBrush}"
                                                        IsVisible="{Binding !HasIcon}">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding #RootWindow.AccentForegroundBrush}"
                                                               Text="{Binding NameAbbreviation}" />
                                                </Border>
                                                <Border Grid.Column="1" Classes="iconwell"
                                                        IsVisible="{Binding HasIcon}"
                                                        ClipToBounds="True">
                                                    <Panel>
                                                        <Image Source="{Binding IconImage}"
                                                               Width="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                               Height="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                               Stretch="Uniform"
                                                               IsVisible="{Binding IconImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <svg:Svg Source="{Binding SvgData}"
                                                                 Width="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                                 Height="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                                 IsVisible="{Binding SvgData, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                               Text="{Binding Description}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            Spacing="14"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="6"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">
                                                        <Border Width="6" Height="6" CornerRadius="{x:Static kodo:KodoDesignTokens.HoverRowRadius}"
                                                                Background="{Binding #RootWindow.AccentBrush}"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsUpdateAvailable}"
                                                                ToolTip.Tip="Update available" />
                                                        <TextBlock Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                   FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Version}" />
                                                    </StackPanel>
                                                    <Button Classes="chrome"
                                                    Background="{Binding #RootWindow.ButtonBrush}"
                                                    BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                    Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                    Tag="{Binding}"
                                                    Click="UpdateInstalledExtensionButton_OnClick"
                                                    Content="Update"
                                                    IsVisible="{Binding IsUpdateAvailable}" />
                                                    <Button Classes="uninstall"
                                                    Tag="{Binding}"
                                                    Click="UninstallExtensionButton_OnClick"
                                                    Content="Uninstall" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border IsVisible="{Binding IsInstalledThemeDividerVisible}" Height="1" Margin="12,8" Background="{Binding SurfaceBorderBrush}" Opacity="{x:Static kodo:KodoDesignTokens.DividerOpacity}"/>

                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasVisibleInstalledCompilerExtensions}" Margin="14,10,14,6" VerticalAlignment="Center">
                                <Border Classes="accentleading" Height="14" Background="{Binding AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Compilers" FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" FontWeight="SemiBold" Foreground="{Binding PrimaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl IsVisible="{Binding HasVisibleInstalledCompilerExtensions}"
                                          ItemsSource="{Binding FilteredInstalledCompilerExtensions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="kodoModels:MarketplaceExtension" x:CompileBindings="True">
                                        <Border Classes="extensionrow">
                                            <ToolTip.Tip>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" />
                                                    <TextBlock Text="{Binding Author}"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                               Opacity="{x:Static kodo:KodoDesignTokens.DividerOpacity}" />
                                                </StackPanel>
                                            </ToolTip.Tip>
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
                                                <Border Grid.Column="0"
                                                        Classes="accentleading"
                                                        VerticalAlignment="Stretch"
                                                        Background="{Binding #RootWindow.AccentBrush}" />
                                                <Border Grid.Column="1" Classes="iconwell"
                                                        Background="{Binding #RootWindow.AccentBrush}"
                                                        IsVisible="{Binding !HasIcon}">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding #RootWindow.AccentForegroundBrush}"
                                                               Text="{Binding NameAbbreviation}" />
                                                </Border>
                                                <Border Grid.Column="1" Classes="iconwell"
                                                        IsVisible="{Binding HasIcon}"
                                                        ClipToBounds="True">
                                                    <Panel>
                                                        <Image Source="{Binding IconImage}"
                                                               Width="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                               Height="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                               Stretch="Uniform"
                                                               IsVisible="{Binding IconImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <svg:Svg Source="{Binding SvgData}"
                                                                 Width="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                                 Height="{x:Static kodo:KodoDesignTokens.IconWellSize}"
                                                                 IsVisible="{Binding SvgData, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                               Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                               Text="{Binding Description}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            Spacing="14"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="6"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">
                                                        <Border Width="6" Height="6" CornerRadius="{x:Static kodo:KodoDesignTokens.HoverRowRadius}"
                                                                Background="{Binding #RootWindow.AccentBrush}"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsUpdateAvailable}"
                                                                ToolTip.Tip="Update available" />
                                                        <TextBlock Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                   FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Version}" />
                                                    </StackPanel>
                                                    <Button Classes="chrome"
                                                    Background="{Binding #RootWindow.ButtonBrush}"
                                                    BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                    Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                    Tag="{Binding}"
                                                    Click="InstallCompilerExtensionButton_OnClick"
                                                    IsEnabled="{Binding IsInstallEnabled}"
                                                    Content="{Binding InstallButtonText}"
                                                    IsVisible="{Binding IsUpdateAvailable}" />
                                                    <Button Classes="uninstall"
                                                    Tag="{Binding}"
                                                    Click="UninstallCompilerExtensionButton_OnClick"
                                                    IsEnabled="{Binding !IsInstalling}"
                                                    Content="Uninstall"
                                                    IsVisible="{Binding IsInstalled}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                            </Border>
                            <Border Background="{Binding CardBrush}"
                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                    Padding="20"
                                    IsVisible="{Binding IsNoExtensionsVisible}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Foreground="{Binding PrimaryTextBrush}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Text="No extensions installed" />
                                    <TextBlock Foreground="{Binding MutedTextBrush}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Text="Browse the Marketplace to add language support and themes." />
                                </StackPanel>
                            </Border>

                            <Border Background="{Binding CardBrush}"
                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                    Padding="20"
                                    IsVisible="{Binding IsInstalledSearchEmptyVisible}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Foreground="{Binding PrimaryTextBrush}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Text="No matches" />
                                    <TextBlock Foreground="{Binding MutedTextBrush}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Text="No installed extensions match your search." />
                                </StackPanel>
                            </Border>

                            <Border Background="{Binding CardBrush}"
                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                    Padding="20"
                                    IsVisible="{Binding IsInstalledCompilersEmptyStateVisible}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center"
                                            IsVisible="{Binding !IsInstalledSearchEmptyVisible}">
                                    <TextBlock Foreground="{Binding PrimaryTextBrush}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Text="No compilers installed" />
                                    <TextBlock Foreground="{Binding MutedTextBrush}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Text="Install a compiler from the Compilers tab to see it here." />
                                </StackPanel>
                            </Border>

                            <Grid IsVisible="{Binding IsInstalledCompilersFilterSelected}"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10"
                                  HorizontalAlignment="Right"
                                  Width="440">
                                <TextBox Grid.Column="0"
                                         Text="{Binding ManualCompilerPathText, Mode=TwoWay}"
                                         PlaceholderText="Add compiler by filepath, press Enter..."
                                         Background="{Binding ButtonBrush}"
                                         Foreground="{Binding PrimaryTextBrush}"
                                         BorderBrush="{Binding SurfaceBorderBrush}"
                                         CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                         Height="{x:Static kodo:KodoDesignTokens.LargeControlHeight}"
                                         Padding="{x:Static kodo:KodoDesignTokens.HorizontalPadding}"
                                         VerticalContentAlignment="Center"
                                         KeyDown="ManualCompilerPathTextBox_OnKeyDown" />
                                <Button Grid.Column="1"
                                        Classes="chrome"
                                        Click="AddManualCompilerButton_OnClick"
                                        Content="Add" />
                            </Grid>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsMarketplaceSectionTabSelected}">

                            <Border Background="{Binding CardBrush}"
                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                    Padding="20"
                                    Margin="0,0,0,12"
                                    IsVisible="{Binding IsMarketplaceUnavailableVisible}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Foreground="{Binding PrimaryTextBrush}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Text="Marketplace unavailable" />
                                    <TextBlock Foreground="{Binding MutedTextBrush}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="The Marketplace is currently unavailable. Please wait a few minutes." />
                                </StackPanel>
                            </Border>

                            <Border Background="{Binding ButtonBrush}"
                                    BorderBrush="{Binding AccentBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                    Padding="14"
                                    Margin="0,0,0,12"
                                    IsVisible="{Binding IsMarketplacePartialErrorVisible}">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Classes="accentleading" Height="16" Background="{Binding AccentBrush}" />
                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Text="Marketplace error" />
                                    </StackPanel>
                                    <TextBlock Foreground="{Binding MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding MarketplaceConnectivityMessage}" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding FilteredMarketplaceExtensions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="kodoModels:MarketplaceExtension" x:CompileBindings="True">
                                        <Border Classes="extensiontile"
                                                Width="{Binding #ExtensionsScrollViewer.Bounds.Width, Converter={x:Static kodoModels:MarketplaceTileWidthConverter.Instance}}"
                                                Background="{Binding #RootWindow.CardBrush}"
                                                BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                ToolTip.Tip="{Binding Name}">
                                            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">

                                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                    <Border Grid.Column="0" Classes="iconwelllarge"
                                                            Background="{Binding #RootWindow.AccentBrush}"
                                                            IsVisible="{Binding !HasIcon}">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="{x:Static kodo:KodoDesignTokens.TitleFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding #RootWindow.AccentForegroundBrush}"
                                                                   Text="{Binding NameAbbreviation}" />
                                                    </Border>
                                                    <Border Grid.Column="0" Classes="iconwelllarge"
                                                            IsVisible="{Binding HasIcon}"
                                                            ClipToBounds="True">
                                                        <Panel>
                                                            <Image Source="{Binding IconImage}"
                                                                   Width="{x:Static kodo:KodoDesignTokens.IconWellLargeSize}"
                                                                   Height="{x:Static kodo:KodoDesignTokens.IconWellLargeSize}"
                                                                   Stretch="Uniform"
                                                                   IsVisible="{Binding IconImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                            <svg:Svg Source="{Binding SvgData}"
                                                                     Width="{x:Static kodo:KodoDesignTokens.IconWellLargeSize}"
                                                                     Height="{x:Static kodo:KodoDesignTokens.IconWellLargeSize}"
                                                                     IsVisible="{Binding SvgData, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        </Panel>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                        <Viewbox StretchDirection="DownOnly"
                                                                 HorizontalAlignment="Left"
                                                                 MaxHeight="22">
                                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.TitleFontSize}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                       Text="{Binding Name}"
                                                                       TextWrapping="NoWrap" />
                                                        </Viewbox>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                               Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                               Text="{Binding Author}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <Border Width="6" Height="6" CornerRadius="{x:Static kodo:KodoDesignTokens.HoverRowRadius}"
                                                                Background="{Binding #RootWindow.AccentBrush}"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsUpdateAvailable}"
                                                                ToolTip.Tip="Update available" />
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                   Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                   Text="{Binding Version}" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Grid.Row="2"
                                                           FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                           Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                           Text="{Binding Description}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="3" />

                                                <Grid Grid.Row="3">

                                                    <Border Classes="installedtag"
                                                            HorizontalAlignment="Stretch"
                                                            Opacity="{x:Static kodo:KodoDesignTokens.DividerOpacity}"
                                                            Background="{Binding #RootWindow.ButtonBrush}"
                                                            BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                            IsVisible="{Binding ShowInstalledBadge}">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                   Text="Installed" />
                                                    </Border>
                                                    <Button Classes="chrome"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Background="{Binding #RootWindow.ButtonBrush}"
                                                            BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                            Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                            Tag="{Binding}"
                                                            Click="InstallMarketplaceExtensionButton_OnClick"
                                                            IsEnabled="{Binding IsInstallEnabled}"
                                                            Content="{Binding InstallButtonText}"
                                                            IsVisible="{Binding IsUpdateAvailable}" />

                                                    <Button Classes="marketinstall"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Background="{Binding #RootWindow.ButtonBrush}"
                                                            BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                            Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                            Tag="{Binding}"
                                                            Click="InstallMarketplaceExtensionButton_OnClick"
                                                            IsEnabled="{Binding IsInstallEnabled}"
                                                            Content="{Binding InstallButtonText}"
                                                            IsVisible="{Binding !IsInstalled}" />


                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="{Binding CardBrush}"
                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                    Padding="20"
                                    Margin="0,4,0,0"
                                    IsVisible="{Binding IsMarketplaceEmptyVisible}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Foreground="{Binding PrimaryTextBrush}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Text="Nothing here yet" />
                                    <TextBlock Foreground="{Binding MutedTextBrush}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Text="{Binding MarketplaceEmptyStateText}" />
                                </StackPanel>
                            </Border>

                            <Border Background="{Binding CardBrush}"
                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                    Padding="20"
                                    Margin="0,4,0,0"
                                    IsVisible="{Binding IsMarketplaceSearchEmptyVisible}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Foreground="{Binding PrimaryTextBrush}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Text="No matches" />
                                    <TextBlock Foreground="{Binding MutedTextBrush}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Text="No marketplace extensions found. Try a different search." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsCompilersTabSelected}">
                            <ItemsControl ItemsSource="{Binding FilteredCompilerExtensions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="kodoModels:MarketplaceExtension" x:CompileBindings="True">
                                        <Border Classes="extensiontile"
                                                Width="{Binding #ExtensionsScrollViewer.Bounds.Width, Converter={x:Static kodoModels:MarketplaceTileWidthConverter.Instance}}"
                                                Background="{Binding #RootWindow.CardBrush}"
                                                BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                ToolTip.Tip="{Binding Name}">
                                            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                    <Border Grid.Column="0" Classes="iconwelllarge"
                                                            Background="{Binding #RootWindow.AccentBrush}"
                                                            IsVisible="{Binding !HasIcon}">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="{x:Static kodo:KodoDesignTokens.TitleFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding #RootWindow.AccentForegroundBrush}"
                                                                   Text="{Binding NameAbbreviation}" />
                                                    </Border>
                                                    <Border Grid.Column="0" Classes="iconwelllarge"
                                                            IsVisible="{Binding HasIcon}"
                                                            ClipToBounds="True">
                                                        <Panel>
                                                            <Image Source="{Binding IconImage}"
                                                                   Width="{x:Static kodo:KodoDesignTokens.IconWellLargeSize}"
                                                                   Height="{x:Static kodo:KodoDesignTokens.IconWellLargeSize}"
                                                                   Stretch="Uniform"
                                                                   IsVisible="{Binding IconImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                            <svg:Svg Source="{Binding SvgData}"
                                                                     Width="{x:Static kodo:KodoDesignTokens.IconWellLargeSize}"
                                                                     Height="{x:Static kodo:KodoDesignTokens.IconWellLargeSize}"
                                                                     IsVisible="{Binding SvgData, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        </Panel>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                        <Viewbox StretchDirection="DownOnly"
                                                                 HorizontalAlignment="Left"
                                                                 MaxHeight="22">
                                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.TitleFontSize}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                       Text="{Binding Name}"
                                                                       TextWrapping="NoWrap" />
                                                        </Viewbox>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                               Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                               Text="{Binding Author}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <Border Width="6" Height="6" CornerRadius="{x:Static kodo:KodoDesignTokens.HoverRowRadius}"
                                                                Background="{Binding #RootWindow.AccentBrush}"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsUpdateAvailable}"
                                                                ToolTip.Tip="Update available" />
                                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                   Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                   Text="{Binding Version}" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Grid.Row="2"
                                                           FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                           Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                           Text="{Binding Description}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="3" />

                                                <Grid Grid.Row="3">
                                                    <Border Classes="installedtag"
                                                            HorizontalAlignment="Stretch"
                                                            Opacity="{x:Static kodo:KodoDesignTokens.DividerOpacity}"
                                                            Background="{Binding #RootWindow.ButtonBrush}"
                                                            BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                            IsVisible="{Binding ShowInstalledBadge}">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                   Text="Installed" />
                                                    </Border>
                                                    <Button Classes="chrome"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Background="{Binding #RootWindow.ButtonBrush}"
                                                            BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                            Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                            Tag="{Binding}"
                                                            Click="InstallCompilerExtensionButton_OnClick"
                                                            IsEnabled="{Binding IsInstallEnabled}"
                                                            Content="{Binding InstallButtonText}"
                                                            IsVisible="{Binding IsUpdateAvailable}" />
                                                    <Button Classes="marketinstall"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Background="{Binding #RootWindow.ButtonBrush}"
                                                            BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                            Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                            Tag="{Binding}"
                                                            Click="InstallCompilerExtensionButton_OnClick"
                                                            IsEnabled="{Binding IsInstallEnabled}"
                                                            Content="{Binding InstallButtonText}"
                                                            IsVisible="{Binding !IsInstalled}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="{Binding CardBrush}"
                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                    Padding="20"
                                    Margin="0,4,0,0"
                                    IsVisible="{Binding !HasVisibleCompilerExtensions}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Foreground="{Binding PrimaryTextBrush}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Text="Nothing here yet" />
                                    <TextBlock Foreground="{Binding MutedTextBrush}"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Text="No compilers matched. Try clearing the search or the Installed only filter." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="SettingsPageGrid"
                  IsVisible="{Binding IsSettingsPageVisible}"
                  IsHitTestVisible="{Binding IsSettingsPageVisible}"
                  Background="{Binding EditorBackgroundBrush}"
                  ColumnDefinitions="232,*"
                  RowDefinitions="*"
                  Focusable="True"
                  PointerPressed="SettingsPage_OnPointerPressed">
                <Border Grid.Column="0"
                        Background="{Binding TopBarBrush}"
                        BorderBrush="{Binding SurfaceBorderBrush}"
                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderRightHairline}"
                        Padding="18,22">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Spacing="5" Margin="4,0,4,20">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SubheaderFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding PrimaryTextBrush}"
                                           Text="Settings" />
                            </StackPanel>
                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                       Foreground="{Binding MutedTextBrush}"
                                       Text="{Binding CustomizeWorkspaceText}" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="4">
                                <Button Classes="settingsnav" Tag="appearance" Click="SettingsSectionButton_OnClick" Content="Appearance" />
                                <Button Classes="settingsnav" Tag="editor" Click="SettingsSectionButton_OnClick" Content="Editor" />
                                <Button Classes="settingsnav" Tag="lsp" Click="SettingsSectionButton_OnClick" Content="Language Server" />
                                <Button Classes="settingsnav" Tag="general" Click="SettingsSectionButton_OnClick" Content="General" />
                                <Button Classes="settingsnav" Tag="terminal" IsVisible="{Binding IsTerminalSupported}" Click="SettingsSectionButton_OnClick" Content="Terminal" />
                                <Button Classes="settingsnav" Tag="integrations" Click="SettingsSectionButton_OnClick" Content="Integrations" />
                                <Button Classes="settingsnav" Tag="updates" Click="SettingsSectionButton_OnClick" Content="Updates" />
                                <Button Classes="settingsnav" Tag="performance" Click="SettingsSectionButton_OnClick" Content="Performance" />
                            <Button Classes="settingsnav" Tag="accessibility" Click="SettingsSectionButton_OnClick" Content="Accessibility" />
                                <Button Classes="settingsnav" Tag="privacy" Click="SettingsSectionButton_OnClick" Content="Privacy" />
                                <Button Classes="settingsnav" Tag="personalization" Click="SettingsSectionButton_OnClick" Content="{Binding LabelPersonalization}" />
                                <Button Classes="settingsnav" Tag="devoptions" Click="SettingsSectionButton_OnClick" Content="Developer Options" />
                                <Button Classes="settingsnav" Tag="helpabout" Click="SettingsSectionButton_OnClick" Content="Help &amp; About" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Background="{Binding TopBarBrush}"
                            BorderBrush="{Binding SurfaceBorderBrush}"
                            BorderThickness="{x:Static kodo:KodoDesignTokens.BorderBottomHairline}"
                            Padding="28,14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeroFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding PrimaryTextBrush}"
                                           Text="Configure Kodo" />
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                           Foreground="{Binding MutedTextBrush}"
                                           Text="Search and adjust how the editor works." />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="searchpill" Width="320" VerticalAlignment="Center">
                                <TextBox x:Name="SettingsSearchTextBox"
                                         HorizontalAlignment="Stretch"
                                         Text="{Binding SettingsSearchText, Mode=TwoWay}"
                                         PlaceholderText="Search settings..."
                                         LostFocus="SettingsSearchTextBox_OnLostFocus" />
                            </Border>
                        </Grid>
                    </Border>

                <ScrollViewer x:Name="SettingsScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="SettingsScrollViewer_OnScrollChanged">
                    <StackPanel x:Name="SettingsCardsPanel"
                                Margin="36,28,36,36"
                                Spacing="16"
                                MaxWidth="920"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top">

                        <Grid x:Name="SectionHeaderAppearance" Tag="appearance" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,10,4,-2">
                            <TextBlock Grid.Column="0"
                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="Bold"
                                       LetterSpacing="1"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="APPEARANCE" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}" Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}" />
                        </Grid>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="ThemeSettingsCard" Tag="appearance">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="Theme" />
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="10"
                                      HorizontalAlignment="Left">
                                    <Button Grid.Column="0"
                                            Classes="chrome"
                                            Click="ThemeButton_OnClick"
                                            Tag="Dark"
                                            Width="170"
                                            AutomationProperties.Name="Apply Dark theme"
                                            ToolTip.Tip="Apply Dark theme">
                                        <StackPanel Spacing="8">
                                            <Panel>
                                                <Border Height="96"
                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                                        Background="{x:Static kodo:KodoDesignTokens.WindowBackground}"
                                                        BorderBrush="{x:Static kodo:KodoDesignTokens.SurfaceBorder}"
                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" />
                                                <Border Height="96"
                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThick}"
                                                        BorderBrush="{Binding AccentBrush}"
                                                        IsVisible="{Binding IsDarkThemeActive}" />
                                            </Panel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Foreground="{Binding PrimaryTextBrush}" Text="Dark" />
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding AccentBrush}"
                                                           VerticalAlignment="Center" Text="●"
                                                           IsVisible="{Binding IsDarkThemeActive}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1"
                                            Classes="chrome"
                                            Click="ThemeButton_OnClick"
                                            Tag="Light"
                                            Width="170"
                                            AutomationProperties.Name="Apply Light theme"
                                            ToolTip.Tip="Apply Light theme">
                                        <StackPanel Spacing="8">
                                            <Panel>
                                                <Border Height="96"
                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                                        Background="#FFFFFF"
                                                        BorderBrush="{x:Static kodo:KodoDesignTokens.LightSurfaceBorder}"
                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" />
                                                <Border Height="96"
                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThick}"
                                                        BorderBrush="{Binding AccentBrush}"
                                                        IsVisible="{Binding IsLightThemeActive}" />
                                            </Panel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Foreground="{Binding PrimaryTextBrush}" Text="Light" />
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding AccentBrush}"
                                                           VerticalAlignment="Center" Text="●"
                                                           IsVisible="{Binding IsLightThemeActive}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="2"
                                            Classes="chrome"
                                            Click="ThemeButton_OnClick"
                                            Tag="System"
                                            Width="170"
                                            AutomationProperties.Name="{Binding TooltipSystemTheme}"
                                            ToolTip.Tip="{Binding TooltipSystemTheme}">
                                        <StackPanel Spacing="8">
                                            <Panel>
                                                <Border Height="96"
                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                                        Background="{Binding SystemThemePreviewBackground}"
                                                        BorderBrush="{Binding SystemThemePreviewBorder}"
                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" />
                                                <Border Height="96"
                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThick}"
                                                        BorderBrush="{Binding AccentBrush}"
                                                        IsVisible="{Binding IsSystemThemeActive}" />
                                            </Panel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Foreground="{Binding PrimaryTextBrush}" Text="System Default" />
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding AccentBrush}"
                                                           VerticalAlignment="Center" Text="●"
                                                           IsVisible="{Binding IsSystemThemeActive}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Spacing="10"
                                            IsVisible="{Binding HasGroupedThemeExtensions}">
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               Text="Installed Theme Extensions" />

                                    <ItemsControl ItemsSource="{Binding GroupedThemeExtensions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="kodoModels:ThemeExtensionGroup" x:CompileBindings="True">
                                                <StackPanel Spacing="6">

                                                    <Button Classes="chrome groupheader"
                                                            Click="ThemeGroupHeader_OnClick"
                                                            IsVisible="{Binding IsMultiTheme}">
                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                                                            <TextBlock Grid.Column="0"
                                                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding GroupName}" />
                                                             <TextBlock Grid.Column="1"
                                                                        FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                        Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                        VerticalAlignment="Center"
                                                                        Text="{Binding Themes.Count, StringFormat='{}{0} themes'}" />
                                                            <Border Grid.Column="2" Background="Transparent" />
                                                            <TextBlock Grid.Column="3"
                                                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                                                       Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding ChevronGlyph}" />
                                                        </Grid>
                                                    </Button>

                                                    <ItemsControl ItemsSource="{Binding Themes}"
                                                                  IsVisible="{Binding IsExpanded}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="kodoModels:LoadedExtension" x:CompileBindings="True">
                                                                <Button Classes="chrome"
                                                                        Background="{Binding #RootWindow.ButtonBrush}"
                                                                        BorderBrush="{Binding #RootWindow.SurfaceBorderBrush}"
                                                                        Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                        Click="ThemeButton_OnClick"
                                                                        Tag="{Binding ThemeCardThemeId}"
                                                                        Width="170">
                                                                    <ToolTip.Tip>
                                                                        <StackPanel Spacing="2">
                                                                            <TextBlock Text="{Binding ThemeCardDisplayName}"
                                                                                       FontWeight="SemiBold"
                                                                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}" />
                                                                            <TextBlock Text="{Binding SourcePath}"
                                                                                       FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                                       Opacity="{x:Static kodo:KodoDesignTokens.DividerOpacity}" />
                                                                        </StackPanel>
                                                                    </ToolTip.Tip>
                                                                    <StackPanel Spacing="8">
                                                                        <Panel>
                                                                            <Border Height="96"
                                                                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                                                                    Background="{Binding ThemeCardPreviewBackground}"
                                                                                    BorderBrush="{Binding ThemeCardPreviewBorder}"
                                                                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}">
                                                                                <Border Width="42"
                                                                                        Height="10"
                                                                                        Margin="12"
                                                                                        HorizontalAlignment="Left"
                                                                                        VerticalAlignment="Top"
                                                                                        CornerRadius="{x:Static kodo:KodoDesignTokens.PillRadius}"
                                                                                        Background="{Binding ThemeCardAccent}" />
                                                                            </Border>
                                                                            <Border Height="96"
                                                                                    CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                                                                    BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThick}"
                                                                                    BorderBrush="{Binding #RootWindow.AccentBrush}"
                                                                                    IsVisible="{Binding IsActiveTheme}" />
                                                                        </Panel>
                                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                                            <TextBlock Grid.Column="0"
                                                                                       HorizontalAlignment="Center"
                                                                                       Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                                       Text="{Binding ThemeCardDisplayName}"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                             <TextBlock Grid.Column="1"
                                                                                        FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                                                        Foreground="{Binding #RootWindow.AccentBrush}"
                                                                                        VerticalAlignment="Center"
                                                                                        Text="●"
                                                                                        IsVisible="{Binding IsActiveTheme}" />
                                                                         </Grid>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           Text="{Binding ThemeStatusText}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="AccentColourSettingsCard" Tag="appearance">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="{Binding LabelAccentColour}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="chrome"
                                            Click="AccentThemeButton_OnClick"
                                            Width="120"
                                            IsVisible="{Binding HasThemeAccent}"
                                            AutomationProperties.Name="{Binding TooltipAccentTheme}"
                                            ToolTip.Tip="{Binding TooltipAccentTheme}">
                                        <StackPanel Spacing="6">
                                            <Border Height="28" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}" Background="{Binding ThemeAccentPreviewBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Foreground="{Binding PrimaryTextBrush}" Text="Theme" />
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding AccentBrush}"
                                                           VerticalAlignment="Center" Text="●"
                                                           IsVisible="{Binding IsAccentTheme}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="chrome"
                                            Click="AccentKodoButton_OnClick"
                                            Width="120"
                                            AutomationProperties.Name="Use Kodo's default purple accent"
                                            ToolTip.Tip="Use Kodo's default purple accent">
                                        <StackPanel Spacing="6">
                                            <Border Height="28" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}" Background="{x:Static kodo:KodoDesignTokens.DefaultAccentHex}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Foreground="{Binding PrimaryTextBrush}" Text="Kodo" />
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding AccentBrush}"
                                                           VerticalAlignment="Center" Text="●"
                                                           IsVisible="{Binding IsAccentKodo}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="chrome"
                                            Click="AccentWindowsButton_OnClick"
                                            Width="120"
                                            AutomationProperties.Name="{Binding TooltipAccentWindows}"
                                            ToolTip.Tip="{Binding TooltipAccentWindows}">
                                        <StackPanel Spacing="6">
                                            <Border Height="28" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}" Background="{Binding AccentBrush}"
                                                    IsVisible="{Binding IsAccentWindows}" />
                                            <Border Height="28" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}" Background="{Binding WindowsAccentPreviewBrush}"
                                                    IsVisible="{Binding !IsAccentWindows}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Foreground="{Binding PrimaryTextBrush}" Text="{Binding LabelAccentSystem}" />
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding AccentBrush}"
                                                           VerticalAlignment="Center" Text="●"
                                                           IsVisible="{Binding IsAccentWindows}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="chrome"
                                            Click="AccentColorPickerButton_OnClick"
                                            Width="120"
                                            AutomationProperties.Name="{Binding TooltipAccentCustom}"
                                            ToolTip.Tip="{Binding TooltipAccentCustom}">
                                        <StackPanel Spacing="6">
                                            <Border Height="28" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}" Background="{Binding AccentBrush}"
                                                    IsVisible="{Binding IsAccentCustom}" />
                                            <Border Height="28" CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                    IsVisible="{Binding !IsAccentCustom}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                        <GradientStop Color="#FF0000" Offset="0" />
                                                        <GradientStop Color="#FFFF00" Offset="0.33" />
                                                        <GradientStop Color="#00FF00" Offset="0.5" />
                                                        <GradientStop Color="#0000FF" Offset="0.67" />
                                                        <GradientStop Color="#FF00FF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Foreground="{Binding PrimaryTextBrush}" Text="Custom" />
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}" Foreground="{Binding AccentBrush}"
                                                           VerticalAlignment="Center" Text="●"
                                                           IsVisible="{Binding IsAccentCustom}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="SectionHeaderEditor" Tag="editor" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,10,4,-2">
                            <TextBlock Grid.Column="0"
                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="Bold"
                                       LetterSpacing="1"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="EDITOR" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}" Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}" />
                        </Grid>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="EditorSettingsCard" Tag="editor">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="Editor" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsWordWrapEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Enable word wrap" />
                                <CheckBox IsChecked="{Binding IsMinimapVisible, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          ToolTip.Tip="Show a code overview beside the editor for quick navigation"
                                          Content="Show minimap" />
                                <StackPanel Orientation="Horizontal" Spacing="12"
                                            VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               Text="Tab size" />
                                    <ComboBox Width="120"
                                              SelectedIndex="{Binding TabSizeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="2 spaces" />
                                        <ComboBoxItem Content="4 spaces" />
                                        <ComboBoxItem Content="8 spaces" />
                                        <ComboBoxItem Content="Tab" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12"
                                            VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               Text="Font size" />
                                    <Button Classes="chrome"
                                            Padding="{x:Static kodo:KodoDesignTokens.TightPadding}"
                                            FontSize="{x:Static kodo:KodoDesignTokens.SectionFontSize}"
                                            Click="DecreaseFontSizeButton_OnClick"
                                            Content="−"
                                            AutomationProperties.Name="Decrease font size"
                                            ToolTip.Tip="Decrease font size" />
                                    <TextBox VerticalAlignment="Center"
                                             Foreground="{Binding PrimaryTextBrush}"
                                             Background="{Binding ButtonBrush}"
                                             BorderBrush="{Binding SurfaceBorderBrush}"
                                             BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                             CornerRadius="{x:Static kodo:KodoDesignTokens.CompactRadius}"
                                             Width="44"
                                             Padding="4,6"
                                             TextAlignment="Center"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding EditorFontSize, Mode=TwoWay}" />
                                    <Button Classes="chrome"
                                            Padding="{x:Static kodo:KodoDesignTokens.TightPadding}"
                                            FontSize="{x:Static kodo:KodoDesignTokens.SectionFontSize}"
                                            Click="IncreaseFontSizeButton_OnClick"
                                            Content="+"
                                            AutomationProperties.Name="Increase font size"
ToolTip.Tip="Increase font size" />
                                  </StackPanel>
                                  <TextBlock Foreground="{Binding MutedTextBrush}"
                                             TextWrapping="Wrap"
                                             Text="{Binding EditorBehaviorStatusText}" />
                                  <StackPanel Orientation="Horizontal"
                                              Spacing="8">
                                          <TextBlock VerticalAlignment="Center"
                                                     Foreground="{Binding PrimaryTextBrush}"
                                                     Text="Font" />
                                          <ComboBox MinWidth="180"
                                                    ItemsSource="{Binding EditorFontChoices}"
                                                    SelectedItem="{Binding EditorFontFamily, Mode=TwoWay}"
                                                    Background="{Binding ButtonBrush}"
                                                    Foreground="{Binding PrimaryTextBrush}"
                                                    BorderBrush="{Binding SurfaceBorderBrush}"
                                                    CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}" />
                                  </StackPanel>
                                <Button Classes="chrome"
                                        HorizontalAlignment="Left"
                                        Click="ViewShortcutsButton_OnClick"
                                        ToolTip.Tip="View and rebind keyboard shortcuts"
                                        AutomationProperties.Name="View and rebind keyboard shortcuts"
                                        Content="Edit Keyboard Shortcuts" />
                            </StackPanel>
                        </Border>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="EditorInsightSettingsCard" Tag="editor">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="Insight" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsInsightEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          ToolTip.Tip="Master switch for Insight's code suggestions and dead code highlighting"
                                          Content="Enable Insight" />
                                <StackPanel Spacing="10"
                                             Margin="24,0,0,0"
                                             IsVisible="{Binding IsInsightEnabled}">
                                     <CheckBox IsChecked="{Binding IsInsightCodeSuggestionsEnabled, Mode=TwoWay}"
                                                Foreground="{Binding PrimaryTextBrush}"
                                                ToolTip.Tip="Predictive code completion as you type"
                                                Content="Code Suggestions" />
                                     <CheckBox IsChecked="{Binding IsInsightDeadCodeEnabled, Mode=TwoWay}"
                                                Foreground="{Binding PrimaryTextBrush}"
                                                ToolTip.Tip="{Binding DeadCodeTooltip}"
                                                Content="Dead Code (Experimental)" />
                                     <StackPanel Spacing="2">
                                          <CheckBox IsChecked="{Binding IsInsightErrorDetectionEnabled, Mode=TwoWay}"
                                                    Foreground="{Binding PrimaryTextBrush}"
                                                    ToolTip.Tip="Underline unmatched brackets, unterminated strings, missing ';'/':' , and misspelled keywords. Experimental, please always double-check if it is correct"
                                                    Content="Error Detection (Experimental) - LSP still active" />
                                          <TextBlock Margin="24,0,0,0"
                                                     FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                     Foreground="{Binding MutedTextBrush}"
                                                     TextWrapping="Wrap"
                                                     Text="Does not disable language server (LSP) diagnostics - LSP errors will still be shown." />
                                      </StackPanel>
                                     <Border Background="{Binding CardBrush}"
                                              BorderBrush="{Binding AccentBrush}"
                                              BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                              CornerRadius="{x:Static kodo:KodoDesignTokens.CompactRadius}"
                                              Padding="10,8"
                                              IsVisible="{Binding IsInsightEnabled}">
                                         <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                             <TextBlock Text="⚠"
                                                         FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                                         Foreground="{Binding AccentBrush}"
                                                         VerticalAlignment="Center" />
                                             <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                         Foreground="{Binding PrimaryTextBrush}"
                                                         TextWrapping="Wrap"
                                                         VerticalAlignment="Center"
                                                         Text="Error Detection and Dead Code are experimental. Please always double-check if they are correct." />
                                         </StackPanel>
                                     </Border>
                                 </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               Foreground="{Binding MutedTextBrush}"
                                               Text="Blacklist (comma-separated extensions, e.g. .txt,.md):" />
                                    <TextBox Text="{Binding InsightBlacklistExtensions, Mode=TwoWay}"
                                             Foreground="{Binding PrimaryTextBrush}"
                                             Background="{Binding ButtonBrush}"
                                             BorderBrush="{Binding SurfaceBorderBrush}"
                                             BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                             CornerRadius="{x:Static kodo:KodoDesignTokens.CompactRadius}"
                                             Padding="8,6"
                                             FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                             PlaceholderText=".txt,.md" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               Foreground="{Binding MutedTextBrush}"
                                               Text="Error &amp; Dead Code Blacklist (comma-separated extensions):" />
                                    <TextBox Text="{Binding InsightErrorDeadCodeBlacklistExtensions, Mode=TwoWay}"
                                             Foreground="{Binding PrimaryTextBrush}"
                                             Background="{Binding ButtonBrush}"
                                             BorderBrush="{Binding SurfaceBorderBrush}"
                                             BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                             CornerRadius="{x:Static kodo:KodoDesignTokens.CompactRadius}"
                                             Padding="8,6"
                                             FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                             PlaceholderText=".cs,.cpp" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="SectionHeaderLsp" Tag="lsp" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,10,4,-2">
                            <TextBlock Grid.Column="0"
                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="Bold"
                                       LetterSpacing="1"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="LANGUAGE SERVERS" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}" Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}" />
                        </Grid>

                        <Border x:Name="LspSettingsCard"
                                Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                Tag="lsp">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="Language Servers" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding LspEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Enable language server features" />
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Language servers provide code completion, diagnostics, navigation, and other language-aware editor features." />

                                <StackPanel Spacing="10" Margin="24,0,0,0" IsVisible="{Binding LspEnabled}">
                                    <CheckBox IsChecked="{Binding LspDiagnosticsEnabled, Mode=TwoWay}"
                                              Foreground="{Binding PrimaryTextBrush}"
                                              Content="Show diagnostics and error highlighting" />
                                    <CheckBox IsChecked="{Binding LspCompletionEnabled, Mode=TwoWay}"
                                              Foreground="{Binding PrimaryTextBrush}"
                                              Content="Show completion suggestions" />
                                    <CheckBox IsChecked="{Binding LspHoverEnabled, Mode=TwoWay}"
                                              Foreground="{Binding PrimaryTextBrush}"
                                              Content="Show hover documentation" />
                                    <CheckBox IsChecked="{Binding LspSignatureHelpEnabled, Mode=TwoWay}"
                                              Foreground="{Binding PrimaryTextBrush}"
                                              Content="Show signature help" />
                                    <CheckBox IsChecked="{Binding LspInlayHintsEnabled, Mode=TwoWay}"
                                              Foreground="{Binding PrimaryTextBrush}"
                                              Content="Show inlay hints" />
                                    <CheckBox IsChecked="{Binding LspFoldingEnabled, Mode=TwoWay}"
                                              Foreground="{Binding PrimaryTextBrush}"
                                              Content="Enable code folding" />
                                    <CheckBox IsChecked="{Binding LspDocumentHighlightsEnabled, Mode=TwoWay}"
                                              Foreground="{Binding PrimaryTextBrush}"
                                              Content="Highlight references to the symbol under the caret" />
                                    <CheckBox IsChecked="{Binding LspSemanticHighlightingEnabled, Mode=TwoWay}"
                                              Foreground="{Binding PrimaryTextBrush}"
                                              Content="Semantic highlighting" />
                                    <TextBlock Margin="24,0,0,0"
                                               Foreground="{Binding MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding SyntaxColorsDescriptionText}" />

                                    <CheckBox IsChecked="{Binding LspAutoInstall, Mode=TwoWay}"
                                              Foreground="{Binding PrimaryTextBrush}"
                                              Content="Automatically install missing servers" />
                                    <TextBlock Margin="24,0,0,0"
                                               Foreground="{Binding MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="When enabled, Kodo installs missing servers in its data folder. Servers already installed on your system remain available when this is off." />

                                    <TextBlock Margin="24,0,0,0"
                                               Foreground="{Binding MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Installed a runtime or a server since Kodo started? Use this to re-detect, bring back any install prompts you dismissed, and see what is still missing." />
                                    <Button Classes="chrome"
                                            HorizontalAlignment="Left"
                                            Margin="24,0,0,0"
                                            Click="RecheckLanguageServersButton_OnClick"
                                            IsEnabled="{Binding !IsRecheckingLanguageServers}"
                                            ToolTip.Tip="Re-detect language servers and restore install prompts"
                                            AutomationProperties.Name="Re-detect language servers and restore install prompts"
                                            Content="{Binding RecheckLanguageServersLabel}" />
                                    <TextBlock Margin="24,0,0,0"
                                               Foreground="{Binding MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding LspRecheckStatusText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="SectionHeaderGeneral" Tag="general" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,10,4,-2">
                            <TextBlock Grid.Column="0"
                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="Bold"
                                       LetterSpacing="1"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="WORKSPACE" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}" Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}" />
                        </Grid>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="DisplaySettingsCard" Tag="general">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="Workspace" />
                                </StackPanel>

                                <CheckBox IsChecked="{Binding IsAutoSaveEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Enable autosave" />
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding AutoSaveStatusText}" />

                                <CheckBox IsChecked="{Binding IsRestoreOpenTabsOnLaunchEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Restore open tabs on launch" />
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding TabRestoreStatusText}" />

                                <CheckBox IsChecked="{Binding IsConfirmBeforeClosingUnsavedTabsEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Confirm before closing unsaved tabs" />
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding ConfirmBeforeClosingStatusText}" />

                                <CheckBox IsChecked="{Binding IsStatusBarFilePathVisible, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Show full file paths in the status bar" />
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding StatusBarFilePathVisibilityText}" />
                            </StackPanel>
                        </Border>

                        <Grid x:Name="SectionHeaderTerminal" Tag="terminal" IsVisible="{Binding IsTerminalSupported}" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,10,4,-2">
                            <TextBlock Grid.Column="0"
                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="Bold"
                                       LetterSpacing="1"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="TERMINAL" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}" Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}" />
                        </Grid>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                IsVisible="{Binding IsTerminalSupported}"
                                x:Name="TerminalSettingsCard" Tag="terminal">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="Terminal" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12"
                                            VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               Text="Default shell" />
                                    <ComboBox Width="220"
                                              ItemsSource="{Binding AvailableTerminalShells}"
                                              SelectedItem="{Binding SelectedTerminalShell, Mode=TwoWay}"
                                              Background="{Binding ButtonBrush}"
                                              Foreground="{Binding PrimaryTextBrush}"
                                              BorderBrush="{Binding SurfaceBorderBrush}"
                                              CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="kodoModels:TerminalShellOption" x:CompileBindings="True">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding TerminalShellDescriptionText}" />
                                <CheckBox IsVisible="{Binding IsPSReadLineRelevant}"
                                          IsChecked="{Binding IsPSReadLinePredictionEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Enable PSReadLine predictive IntelliSense in PowerShell" />
                                <TextBlock IsVisible="{Binding IsPSReadLineRelevant}"
                                           Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Off by default - it can render as glitchy artifacts in the terminal. Applies to new terminal sessions." />
                                  <StackPanel Orientation="Horizontal" Spacing="12"
                                              VerticalAlignment="Center">
                                          <TextBlock VerticalAlignment="Center"
                                                     Foreground="{Binding PrimaryTextBrush}"
                                                     Text="Scrollback lines" />
                                          <TextBox Width="120"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Background="{Binding ButtonBrush}"
                                                   BorderBrush="{Binding SurfaceBorderBrush}"
                                                   BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                                   CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                   Padding="4,6"
                                                   TextAlignment="Center"
                                                   HorizontalContentAlignment="Center"
                                                   VerticalContentAlignment="Center"
                                                   Text="{Binding TerminalScrollbackLines, Mode=TwoWay}" />
                                      </StackPanel>
                                  <TextBlock Foreground="{Binding MutedTextBrush}"
                                             TextWrapping="Wrap"
                                             Text="How much terminal output history to keep, from 200 to 200000 lines. Higher values use more memory. Applies to new terminal sessions." />
                            </StackPanel>
                        </Border>

                        <Grid x:Name="SectionHeaderIntegrations" Tag="integrations" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,10,4,-2">
                            <TextBlock Grid.Column="0"
                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="Bold"
                                       LetterSpacing="1"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="INTEGRATIONS" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}" Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}" />
                        </Grid>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="DiscordRichPresenceSettingsCard" Tag="integrations">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="Discord Rich Presence" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsDiscordRichPresenceEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Enable Discord Rich Presence" />
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding DiscordRichPresenceStatusText}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="GitSourceControlSettingsCard" Tag="integrations">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="Git Source Control" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsGitSourceControlEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Enable Git Source Control" />
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Adds Git status, staging, diffs, branches, commits, and remote actions to the activity bar. Requires Git on PATH." />
                            </StackPanel>
                        </Border>

                        <Grid x:Name="SectionHeaderUpdates" Tag="updates" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,10,4,-2">
                            <TextBlock Grid.Column="0"
                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="Bold"
                                       LetterSpacing="1"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="UPDATES" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}" Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}" />
                        </Grid>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="UpdatesSettingsCard" Tag="updates">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="Updates" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsAutoUpdateAppEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Automatically check for Kodo updates" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="28,0,0,0"
                                      IsVisible="{Binding IsAutoUpdateAppEnabled}">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsAutoUpdateAppInBackgroundEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Text="Update Kodo in the background" />
                                        <TextBlock Foreground="{Binding MutedTextBrush}"
                                                   FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                   TextWrapping="Wrap"
                                                   Text="Downloads new versions in the background and shows an update prompt when it's ready. You choose when to restart." />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding AutoUpdateAppStatusText}" />
                                <CheckBox IsChecked="{Binding IsAutoUpdateExtensionsEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Automatically update extensions" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="28,0,0,0"
                                      IsVisible="{Binding IsAutoUpdateExtensionsEnabled}">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsAutoUpdateExtensionsInBackgroundEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Text="Update without showing progress" />
                                        <TextBlock Foreground="{Binding MutedTextBrush}"
                                                   FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                   TextWrapping="Wrap"
                                                   Text="Installs pending extension updates silently, without changing the status message below while it works." />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding AutoUpdateExtensionsStatusText}" />
                            </StackPanel>
                        </Border>

                        <Grid x:Name="SectionHeaderPerformance" Tag="performance" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,10,4,-2">
                            <TextBlock Grid.Column="0"
                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="Bold"
                                       LetterSpacing="1"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="PERFORMANCE" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}" Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}" />
                        </Grid>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="PerformanceSettingsCard" Tag="performance">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="Performance" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsPerformanceModeEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Performance mode" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="28,0,0,0"
                                      IsVisible="{Binding IsPerformanceModeEnabled}">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding NewsDisabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Text="Disable News &amp; Announcements" />
                                        <TextBlock Foreground="{Binding MutedTextBrush}"
                                                   FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                   TextWrapping="Wrap"
                                                   Text="Hides the News card from the home screen and stops fetching announcements from GitHub or the local cache." />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="28,0,0,0"
                                      IsVisible="{Binding IsPerformanceModeEnabled}">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding WhatsNewDisabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Text="Disable What's New" />
                                        <TextBlock Foreground="{Binding MutedTextBrush}"
                                                   FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                   TextWrapping="Wrap"
                                                   Text="Hides the What's New card from the home screen and stops fetching release notes from GitHub." />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="28,0,0,0"
                                      IsVisible="{Binding IsPerformanceModeEnabled}">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsDebouncedSearchEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Text="Debounce search results" />
                                        <TextBlock Foreground="{Binding MutedTextBrush}"
                                                   FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                   TextWrapping="Wrap"
                                                   Text="Extensions, Compilers, Languages, Installed, and Settings search only refresh after you stop typing, instead of on every keystroke." />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                           TextWrapping="Wrap"
                                           Text="When Performance mode is on, you can choose which features to disable individually. Disabled features are hidden from the home screen and their refresh buttons are turned off." />
                            </StackPanel>
                        </Border>

                        <Grid x:Name="SectionHeaderAccessibility" Tag="accessibility" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,10,4,-2">
                            <TextBlock Grid.Column="0"
                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="Bold"
                                       LetterSpacing="1"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="ACCESSIBILITY" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}" Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}" />
                        </Grid>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="AccessibilitySettingsCard" Tag="accessibility">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="Accessibility" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsScreenReaderAnnouncementsEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Screen reader announcements" />
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                           TextWrapping="Wrap"
                                           Text="Announces save status, cursor position, and document changes to screen readers. Turn off if announcements are distracting." />
                                <CheckBox IsChecked="{Binding IsReduceMotionEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Reduce motion" />
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                           TextWrapping="Wrap"
                                           Text="Turns off hover and fade transitions across the UI." />
                                <CheckBox IsChecked="{Binding IsLargeTextEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Large text" />
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                           TextWrapping="Wrap"
                                           Text="Enlarges editor text by 30% for easier reading." />
                            </StackPanel>
                        </Border>

                        <Grid x:Name="SectionHeaderPrivacy" Tag="privacy" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,10,4,-2">
                            <TextBlock Grid.Column="0"
                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="Bold"
                                       LetterSpacing="1"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="PRIVACY" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}" Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}" />
                        </Grid>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="PrivacySettingsCard" Tag="privacy">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="Privacy" />
                                </StackPanel>
                                <CheckBox IsChecked="{Binding IsDataTrackingEnabled, Mode=TwoWay}"
                                          Foreground="{Binding PrimaryTextBrush}"
                                          Content="Help improve Kodo by sharing anonymous usage data" />
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                           TextWrapping="Wrap"
                                           Text="Kodo can send anonymous usage events - like which features are used and crash reports - to help prioritize fixes and improvements. No file contents, file paths, or personal information are ever included. You can change this at any time." />
                                <Button Classes="chrome"
                                        Click="OpenPrivacyPolicyButton_OnClick"
                                        HorizontalAlignment="Left"
                                        Content="Open Privacy Policy" />
                            </StackPanel>
                        </Border>

                        <Grid x:Name="SectionHeaderPersonalization" Tag="personalization" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,10,4,-2">
                            <TextBlock Grid.Column="0"
                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="Bold"
                                       LetterSpacing="1"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="{Binding LabelPersonalizationHeader}" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}" Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}" />
                        </Grid>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="PersonalizationSettingsCard" Tag="personalization">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="{Binding LabelPersonalization}" />
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock Width="120"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Text="Name" />
                                        <TextBox Width="220"
                                                 Text="{Binding UserName, Mode=TwoWay}"
                                                 PlaceholderText="e.g. Alex (optional)"
                                                 CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                 Padding="{x:Static kodo:KodoDesignTokens.MediumPadding}"
                                                 Background="{Binding ButtonBrush}"
                                                 Foreground="{Binding PrimaryTextBrush}"
                                                 BorderBrush="{Binding SurfaceBorderBrush}"
                                                 BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock Width="120"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Text="Country" />
                                        <TextBox Width="220"
                                                 Text="{Binding UserCountry, Mode=TwoWay}"
                                                 PlaceholderText="e.g. CA, US, GB (auto-detected)"
                                                 CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                 Padding="{x:Static kodo:KodoDesignTokens.MediumPadding}"
                                                 Background="{Binding ButtonBrush}"
                                                 Foreground="{Binding PrimaryTextBrush}"
                                                 BorderBrush="{Binding SurfaceBorderBrush}"
                                                 BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock Width="120"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Text="Hemisphere" />
                                        <ComboBox Width="220"
                                                  SelectedIndex="{Binding UserHemisphereIndex, Mode=TwoWay}"
                                                  Background="{Binding ButtonBrush}"
                                                  Foreground="{Binding PrimaryTextBrush}"
                                                  BorderBrush="{Binding SurfaceBorderBrush}"
                                                  CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}">
                                            <ComboBoxItem Content="Auto-detect from country" />
                                            <ComboBoxItem Content="Northern hemisphere" />
                                            <ComboBoxItem Content="Southern hemisphere" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock Width="120"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Text="Time zone offset" />
                                        <TextBox Width="220"
                                                 Text="{Binding UserTimezoneOffset, Mode=TwoWay}"
                                                 PlaceholderText="e.g. -5, +1 (auto-detected)"
                                                 CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                 Padding="{x:Static kodo:KodoDesignTokens.MediumPadding}"
                                                 Background="{Binding ButtonBrush}"
                                                 Foreground="{Binding PrimaryTextBrush}"
                                                 BorderBrush="{Binding SurfaceBorderBrush}"
                                                 BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding LabelPersonalizationDescription}" />
                            </StackPanel>
                        </Border>

                        <Grid x:Name="SectionHeaderDeveloperOptions" Tag="devoptions" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,10,4,-2">
                            <TextBlock Grid.Column="0"
                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="Bold"
                                       LetterSpacing="1"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="DEVELOPER TOOLS" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}" Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}" />
                        </Grid>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="DeveloperOptionsSettingsCard" Tag="devoptions">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="Developer Options" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox IsChecked="{Binding IsDeveloperOptionsVisible, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               Text="Show developer options" />
                                </StackPanel>
                                <StackPanel Spacing="8"
                                            IsVisible="{Binding IsDeveloperOptionsVisible}">
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               FontWeight="Bold"
                                               LetterSpacing="1"
                                               Foreground="{Binding MutedTextBrush}"
                                               Margin="0,2,0,0"
                                               Text="DIAGNOSTICS &amp; LOGGING" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <CheckBox IsChecked="{Binding IsVerboseLoggingEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip.Tip="When off, kodo.log and crash.log each start fresh on launch. When on, debug traces are included in kodo.log and both files keep accumulating across launches instead of being reset." />
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Text="Debug Logging (adds debug traces and keeps logs across sessions)" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <CheckBox IsChecked="{Binding IsRuntimeMetricsLoggingEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip.Tip="Every 10 seconds, append a GC/heap/thread sample line (METRIC) to kodo.log. Useful for tracking memory pressure over time." />
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Text="Runtime Metrics Logging (10s GC/heap/thread samples)" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{Binding PrimaryTextBrush}"
                                                   Text="SLOW stage log threshold (ms, 0 = built-in):" />
                                        <TextBox Width="120"
                                                 VerticalAlignment="Center"
                                                 Background="{Binding ButtonBrush}"
                                                 Foreground="{Binding PrimaryTextBrush}"
                                                 BorderBrush="{Binding SurfaceBorderBrush}"
                                                 BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                                 CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                                 Padding="4,6"
                                                 TextAlignment="Center"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding SlowStageThresholdText, Mode=TwoWay}"
                                                 PlaceholderText="0"
                                                 ToolTip.Tip="Replace the built-in thresholds for SLOW log entries. Lower to catch sluggishness, raise to silence noise. Defaults are around 250 ms." />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="chrome"
                                                Click="CopyDiagnosticInfoButton_OnClick"
                                                ToolTip.Tip="Copy version, OS, runtime, and log paths to the clipboard"
                                                AutomationProperties.Name="Copy version, OS, runtime, and log paths to the clipboard"
                                                Content="Copy Diagnostic Info" />
                                        <Button Classes="chrome"
                                                Click="ClearLogsButton_OnClick"
                                                ToolTip.Tip="Delete kodo.log and crash.log from disk"
                                                AutomationProperties.Name="Delete kodo.log and crash.log from disk"
                                                Content="Clear Logs" />
                                    </StackPanel>

                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               FontWeight="Bold"
                                               LetterSpacing="1"
                                               Foreground="{Binding MutedTextBrush}"
                                               Margin="0,8,0,0"
                                               Text="FOLDERS" />
                                    <TextBlock Foreground="{Binding MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Open folders Kodo uses on this machine for logs, settings, and extensions." />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="chrome"
                                                Click="OpenCrashLogFolderButton_OnClick"
                                                ToolTip.Tip="{Binding CrashLogFolderPath}"
                                                AutomationProperties.Name="{Binding CrashLogFolderPath}"
                                                Content="Open Crash Logs Folder" />
                                        <Button Classes="chrome"
                                                Click="OpenSettingsFolderButton_OnClick"
                                                ToolTip.Tip="{Binding SettingsFolderPath}"
                                                AutomationProperties.Name="{Binding SettingsFolderPath}"
                                                Content="Open Settings Folder" />
                                        <Button Classes="chrome"
                                                Click="OpenExtensionsFolderButton_OnClick"
                                                ToolTip.Tip="Open the local Extensions folder used for .kox files"
                                                AutomationProperties.Name="Open the local Extensions folder used for .kox files"
                                                Content="Open Extensions Folder" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="chrome"
                                                Click="OpenPluginCacheFolderButton_OnClick"
                                                ToolTip.Tip="Open the folder where loaded plugins are unpacked"
                                                AutomationProperties.Name="Open the folder where loaded plugins are unpacked"
                                                Content="Open Plugin Cache Folder" />
                                        <Button Classes="chrome"
                                                Click="OpenDataFolderButton_OnClick"
                                                ToolTip.Tip="Open Kodo's root data folder (contains settings, caches, and theme data)"
                                                AutomationProperties.Name="Open Kodo's root data folder (contains settings, caches, and theme data)"
                                                Content="Open Data Folder" />
                                    </StackPanel>

                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               FontWeight="Bold"
                                               LetterSpacing="1"
                                               Foreground="{Binding MutedTextBrush}"
                                               Margin="0,8,0,0"
                                               Text="SETTINGS DATA" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="chrome"
                                                Click="BackupSettingsDataButton_OnClick"
                                                ToolTip.Tip="Regenerate the settings backup file (kodosettings.json.bak) from your current settings"
                                                AutomationProperties.Name="Regenerate the settings backup file (kodosettings.json.bak) from your current settings"
                                                Content="Backup Settings Data" />
                                        <Button Classes="chrome red"
                                                Click="RestoreSettingsBackupButton_OnClick"
                                                ToolTip.Tip="Overwrite your current settings with the backup file and relaunch Kodo"
                                                Content="Restore Settings Backup"
                                                AutomationProperties.Name="Overwrite your current settings with the backup file and relaunch Kodo"
                                                IsVisible="{Binding HasSettingsBackupFile}" />
                                        <Button Classes="chrome"
                                                Click="ResetTutorialPromptsButton_OnClick"
                                                ToolTip.Tip="Make the first-launch tutorial, data tracking prompt, and privacy policy prompt show again"
                                                AutomationProperties.Name="Make the first-launch tutorial, data tracking prompt, and privacy policy prompt show again"
                                                Content="Reset Tutorial &amp; Consent Prompts" />
                                    </StackPanel>

                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               FontWeight="Bold"
                                               LetterSpacing="1"
                                               Foreground="{Binding MutedTextBrush}"
                                               Margin="0,8,0,0"
                                               Text="MAINTENANCE" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="chrome"
                                                Click="ClearCacheButton_OnClick"
                                                ToolTip.Tip="Clear all cache files from disk"
                                                AutomationProperties.Name="Clear all cache files from disk"
                                                Content="Clear Cache" />
                                        <Button Classes="chrome"
                                                Click="ExportKodoDataButton_OnClick"
                                                ToolTip.Tip="{Binding PersonalizationExportTooltip}"
                                                AutomationProperties.Name="{Binding PersonalizationExportTooltip}"
                                                Content="Export Kodo Data" />
                                        <Button Classes="chrome red"
                                                Click="ResetKodoButton_OnClick"
                                                ToolTip.Tip="Reset all Kodo data and relaunch the application"
                                                Content="Reset Kodo"
                                                AutomationProperties.Name="Reset all Kodo data and relaunch the application"
                                                HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               Foreground="{Binding MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasDeveloperOptionsStatus}"
                                               Text="{Binding DeveloperOptionsStatusText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="SectionHeaderHelpAbout" Tag="helpabout" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,10,4,-2">
                            <TextBlock Grid.Column="0"
                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                       FontWeight="Bold"
                                       LetterSpacing="1"
                                       Foreground="{Binding AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="HELP &amp; ABOUT" />
                            <Border Grid.Column="1"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}" Opacity="{x:Static kodo:KodoDesignTokens.AccentEdgeOpacity}" />
                        </Grid>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="HelpSettingsCard" Tag="helpabout">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding PrimaryTextBrush}"
                                            VerticalAlignment="Center"
                                            Text="Help" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="chrome"
                                            Click="OpenTutorialButton_OnClick"
                                            ToolTip.Tip="Launch the built-in Kodo tutorial"
                                            AutomationProperties.Name="Launch the built-in Kodo tutorial"
                                            Content="Open Tutorial" />
                                    <Button Classes="chrome"
                                            Click="OpenDiscordButton_OnClick"
                                            AutomationProperties.Name="Join the Kodo community on Discord"
                                            ToolTip.Tip="Join the Kodo community on Discord">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="Join the Discord Server"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="chrome"
                                            Click="OpenWebsiteButton_OnClick"
                                            ToolTip.Tip="Open the Kodo website in your browser"
                                            AutomationProperties.Name="Open the Kodo website in your browser"
                                            Content="Visit Website" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="AboutSettingsCard" Tag="helpabout">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Classes="accentleading" Height="22" Background="{Binding AccentBrush}" />
                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeaderFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Text="About" />
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="14"
                                                VerticalAlignment="Center">
                                        <Border Classes="accentleading"
                                                Height="48"
                                                Background="{Binding AccentBrush}" />
                                        <Border Width="48"
                                                Height="48"
                                                CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                                ClipToBounds="True">
                                            <Image Source="avares://Kodo/Assets/kodo-logo.png"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SectionFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding PrimaryTextBrush}"
                                                       Text="{Binding AboutTitle}" />
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                       xml:space="preserve"><Run Foreground="{Binding MutedTextBrush}" Text="{Binding TaglinePrefixText}" /><Run Foreground="{Binding AccentBrush}" Text="{Binding TaglineAccentText}" /></TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                     <StackPanel Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Right">
                                          <TextBlock x:Name="AboutVersionText"
                                                    FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                    Foreground="{Binding MutedTextBrush}"
                                                    HorizontalAlignment="Right"
                                                    PointerPressed="AboutVersionText_OnPointerPressed"
                                                    Text="{Binding CurrentAppVersionDisplay}" />
                                      </StackPanel>
                                </Grid>

                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           Text="{Binding CopyrightText}" />

                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Button Classes="chrome"
                                            Click="CheckForUpdatesButton_OnClick"
                                            IsEnabled="{Binding !IsCheckingForUpdatesManually}"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Check GitHub for a newer version of Kodo right now"
                                            AutomationProperties.Name="Check GitHub for a newer version of Kodo right now"
                                            Content="{Binding CheckForUpdatesButtonText}" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                               Foreground="{Binding MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasCheckForUpdatesStatus}"
                                               Text="{Binding CheckForUpdatesStatusText}" />
                                </StackPanel>

                                <Border IsVisible="{Binding IsNewerVersionAvailable}"
                                        Background="{Binding AccentBrush}"
                                        CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                        Padding="12,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                       Foreground="{Binding AccentForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       Text="Update available -" />
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding AccentForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding LatestReleaseTag}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="chrome"
                                                Click="DownloadUpdateButton_OnClick"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Download the latest version of Kodo"
                                                AutomationProperties.Name="Download the latest version of Kodo"
                                                Content="Download" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24"
                                x:Name="WhatsNewSettingsCard" Tag="helpabout">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="16">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="14">
                                        <Border Classes="iconwellmedium"
                                                VerticalAlignment="Center">
                                            <Image Source="avares://Kodo/Assets/kodo-logo.png"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Spacing="2"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SectionFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding PrimaryTextBrush}"
                                                       Text="What's New" />
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                       Foreground="{Binding MutedTextBrush}"
                                                       Text="{Binding LatestReleaseDisplayName}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Classes="chrome"
                                            Click="ToggleWhatsNewExpandedButton_OnClick"
                                            MinWidth="164"
                                            ToolTip.Tip="Show or hide release notes"
                                            AutomationProperties.Name="Show or hide release notes"
                                            HorizontalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    HorizontalAlignment="Center">
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                                       Foreground="{Binding PrimaryTextBrush}"
                                                       Text="{Binding WhatsNewToggleGlyph}" />
                                            <TextBlock Foreground="{Binding PrimaryTextBrush}"
                                                       Text="{Binding WhatsNewToggleText}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding LatestReleaseStatusText}" />

                                <Border IsVisible="{Binding IsWhatsNewExpanded}"
                                        Background="{Binding WindowBackgroundBrush}"
                                        BorderBrush="{Binding SurfaceBorderBrush}"
                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                        CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                        Padding="16">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="16">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <Border Classes="accentleading" Height="26" Background="{Binding AccentBrush}" />
                                                    <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.HeroFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding PrimaryTextBrush}"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding LatestReleaseDisplayName}" />
                                                </StackPanel>
                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                           Foreground="{Binding MutedTextBrush}"
                                                           Text="{Binding LatestReleaseTag}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Top">
                                                <Button Classes="chrome"
                                                        Click="RefreshLatestReleaseButton_OnClick"
                                                        IsEnabled="{Binding IsWhatsNewRefreshEnabled}"
                                                        ToolTip.Tip="Check for newer release information"
                                                        AutomationProperties.Name="Check for newer release information"
                                                        Content="{Binding RefreshLatestReleaseButtonText}" />
                                                <Button Classes="chrome"
                                                        Click="OpenLatestReleaseButton_OnClick"
                                                        IsEnabled="{Binding IsWhatsNewRefreshEnabled}"
                                                        ToolTip.Tip="Open this release on GitHub in your browser"
                                                        AutomationProperties.Name="Open this release on GitHub in your browser"
                                                        Content="View on GitHub" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SectionFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding PrimaryTextBrush}"
                                                    Text="Release Notes"
                                                    IsVisible="{Binding !IsWhatsNewDisabled}" />

                                        <StackPanel IsVisible="{Binding IsWhatsNewDisabled}"
                                                    Spacing="8"
                                                    Margin="0,4">
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{Binding AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       LetterSpacing="1"
                                                       Text="DISABLED" />
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SmallFontSize}"
                                                       Foreground="{Binding MutedTextBrush}"
                                                       Opacity="{x:Static kodo:KodoDesignTokens.MutedForegroundOpacity}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Text="What's New is turned off by Performance mode." />
                                        </StackPanel>

                                        <ScrollViewer MaxHeight="300"
                                                      VerticalScrollBarVisibility="Auto"
                                                      IsVisible="{Binding !IsWhatsNewDisabled}">
                                            <ItemsControl ItemsSource="{Binding LatestReleaseFormatted}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="kodoModels:FormattedParagraph" x:CompileBindings="True">
                                                        <Grid Margin="{Binding TopMargin}"
                                                              ColumnDefinitions="Auto,*">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Marker}"
                                                                       Width="{Binding MarkerColumnWidth}"
                                                                       FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                       LineHeight="20"
                                                                       Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                       VerticalAlignment="Top" />
                                                            <ItemsControl Grid.Column="1"
                                                                          ItemsSource="{Binding Runs}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="kodoModels:FormattedRun" x:CompileBindings="True">
                                                                        <TextBlock Text="{Binding Text}"
                                                                                   TextWrapping="Wrap"
                                                                                   FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                                   LineHeight="20"
                                                                                   Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                                   FontWeight="{Binding IsBold, Converter={x:Static kodoModels:BoolToFontWeightConverter.Instance}}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <StackPanel Spacing="10"
                                                    IsVisible="{Binding HasLatestReleaseLinks}">
                                            <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SectionFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding PrimaryTextBrush}"
                                                       Text="Links" />
                                            <ItemsControl ItemsSource="{Binding LatestReleaseLinks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="kodoModels:ReleaseLinkItem" x:CompileBindings="True">
                                                        <Button Classes="chrome"
                                                                Tag="{Binding Url}"
                                                                Click="OpenReleaseLinkButton_OnClick"
                                                                HorizontalAlignment="Left"
                                                                HorizontalContentAlignment="Left"
                                                                Margin="0,0,0,6">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Foreground="{Binding #RootWindow.PrimaryTextBrush}"
                                                                           Text="Full Changelog"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                                           Foreground="{Binding #RootWindow.MutedTextBrush}"
                                                                           Text="{Binding Url}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsSearchEmptyPlaceholder"
                                IsVisible="{Binding IsSettingsSearchEmptyVisible}"
                                Background="{Binding CardBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                                Padding="24">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="{Binding PrimaryTextBrush}"
                                           Text="No settings match your search." />
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="{Binding MutedTextBrush}"
                                           FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                           Text="Try a different word, or clear the search box above." />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Grid>
            <Grid IsVisible="{Binding IsUpdateSplashVisible}"
                  IsHitTestVisible="{Binding IsUpdateSplashVisible}"
                  Background="#B3000000">
                <Border Background="{Binding CardBrush}"
                        BorderBrush="{Binding SurfaceBorderBrush}"
                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                        CornerRadius="{x:Static kodo:KodoDesignTokens.HeroRadius}"
                        Padding="32"
                        MaxWidth="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Classes="iconwellmedium"
                                    VerticalAlignment="Center">
                                <Image Source="avares://Kodo/Assets/kodo-logo.png"
                                       Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.SubheaderFontSize}"
                                           FontWeight="Bold"
                                           Foreground="{Binding PrimaryTextBrush}"
                                           Text="{Binding OpeningSplashTitleText}" />
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                           Foreground="{Binding MutedTextBrush}"
                                           Text="{Binding OpeningSplashSubtitleText}" />
                            </StackPanel>
                        </StackPanel>

                        <Border IsVisible="{Binding IsReleaseNotesSectionVisible}"
                                Background="{Binding WindowBackgroundBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                Padding="16"
                                MaxHeight="220">
                            <ScrollViewer>
                                <TextBlock Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="20"
                                           FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                           Text="{Binding LatestReleaseNotes}" />
                            </ScrollViewer>
                        </Border>

                        <Border IsVisible="{Binding IsPrivacyPolicyPromptVisible}"
                                Background="{Binding ButtonBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding PrimaryTextBrush}"
                                           Text="Privacy Policy" />
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                           Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Please scroll to the end to enable Accept." />
                                <Border Background="{Binding WindowBackgroundBrush}"
                                        BorderBrush="{Binding SurfaceBorderBrush}"
                                        BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                        CornerRadius="{x:Static kodo:KodoDesignTokens.ControlRadius}"
                                        Padding="14"
                                        MaxHeight="180">
                                    <ScrollViewer x:Name="PrivacyPolicyScrollViewerSplash"
                                                  ScrollChanged="PrivacyPolicyScrollViewer_OnScrollChanged">
                                        <TextBlock Foreground="{Binding MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"
                                                   FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                                   FontFamily="JetBrains Mono,DejaVu Sans Mono,Ubuntu Mono,Noto Sans Mono,Cascadia Code,Consolas,Menlo,monospace"
                                                   Text="{Binding PrivacyPolicyText}" />
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="marketaction"
                                            IsEnabled="{Binding IsPrivacyPolicyScrolledToBottom}"
                                            Click="AcceptPrivacyPolicyButton_OnClick"
                                            Content="Accept" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding IsDataTrackingPromptVisible}"
                                Background="{Binding ButtonBrush}"
                                BorderBrush="{Binding SurfaceBorderBrush}"
                                BorderThickness="{x:Static kodo:KodoDesignTokens.BorderThin}"
                                CornerRadius="{x:Static kodo:KodoDesignTokens.CardRadius}"
                                Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyLargeFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding PrimaryTextBrush}"
                                           Text="Help improve Kodo" />
                                <TextBlock FontSize="{x:Static kodo:KodoDesignTokens.BodyFontSize}"
                                           Foreground="{Binding MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           Text="Kodo can send anonymous usage data - like which features get used and crash reports - to help fix bugs and prioritize what to build next. Nothing personal, and no file contents or paths, ever. You can change this anytime in Settings." />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="chrome"
                                            Click="DeclineDataTrackingButton_OnClick"
                                            Content="Not now" />
                                    <Button Classes="marketaction"
                                            Click="AcceptDataTrackingButton_OnClick"
                                            Content="Accept" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button IsVisible="{Binding AreAllConsentPromptsResolved}"
                                Classes="marketaction"
                                Click="DismissUpdateSplashButton_OnClick"
                                HorizontalAlignment="Right"
                                Content="Got it" />

                    </StackPanel>
                </Border>
            </Grid>
            </Panel>
        </Grid>
    </Grid>
</Window>
