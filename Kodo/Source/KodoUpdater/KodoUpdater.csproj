<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinExe, not Exe: this process is launched silently by Kodo and must
         never flash a console window. It shows an installer-progress dialog
         when Kodo hands off an update, and writes the sentinel file that Kodo
         reads on next launch otherwise. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>KodoUpdater</AssemblyName>
    <RootNamespace>KodoUpdater</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Single-file, self-contained publish keeps this a standalone background
         process with no dependency on the main Kodo install folder layout. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
  </ItemGroup>

</Project>
