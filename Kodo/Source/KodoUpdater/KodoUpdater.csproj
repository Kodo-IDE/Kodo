<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>KodoUpdater</AssemblyName>
    <RootNamespace>KodoUpdater</RootNamespace>

    <!-- Windows-target-only icon: $(OS) is the build host, not the target RID. -->
    <ApplicationIcon Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">..\..\Assets\kodo_logo.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">..\..\Assets\kodo_logo.ico</ApplicationIcon>

    <!-- Phase 0 Linux: no hardcoded RID. Pass at publish time:
         dotnet publish -r win-x64 / -r linux-x64 / -r linux-arm64.
         A hardcoded win-x64 here silently cross-targets Windows on Linux hosts. -->
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>

    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>

    <Optimize>true</Optimize>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- One-shot helper: no Avalonia, minimal deps -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared hotfix-apply core (BCL-only, trim-safe; also compiled into Kodo). -->
    <Compile Include="..\HotfixApplyShared.cs" Link="HotfixApplyShared.cs" />
  </ItemGroup>

</Project>
